PORT=4310
HOST=127.0.0.1
AUTOPILOTS_MODE=demo
DATABASE_URL=
DATABASE_POOL_MAX=10
SESSION_SECRET=
AUTH_PROVIDER=demo
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_REDIRECT_URL=http://127.0.0.1:4310/auth/callback
VAULT_PROVIDER=none
MONITORING_SCHEDULER_ENABLED=false
MONITORING_INTERVAL_MS=300000
MONITORING_LEASE_SECONDS=120
MONITORING_STALE_AFTER_SECONDS=900
MONITORING_AUTHORITY_PROFILE_ID=
MONITORING_RUN_IMMEDIATELY=false
EXTERNAL_WRITES_ENABLED=false

# Provider reads blijven uit totdat een sandboxverbinding en mapping zijn gevalideerd.
AUTOREVIEWS_API_URL=http://127.0.0.1:43117
AUTOREVIEWS_OS_SYNC_SECRET=
AUTOPLANNER_API_URL=http://127.0.0.1:3000/api
ROOFPLANNER_API_URL=http://127.0.0.1:3001

# De monitoring-authority geeft alleen server-side scope; audit actor blijft autopilots-health-monitor.
# De service-role key is uitsluitend voor server-side RPC's en mag nooit naar clientcode.
# Productie vereist managed identity, PostgreSQL/RLS, een echte vault en HTTPS.
# Zet nooit providersecrets of Supabase service-role keys in clientcode.

# Publiek, build-time
PUBLIC_SITE_URL=https://auto-pilots.io
PUBLIC_GHL_CALENDAR_URL=
PUBLIC_STRIPE_PUBLISHABLE_KEY=
PUBLIC_ANALYTICS_PROVIDER=none
PUBLIC_ANALYTICS_SITE_ID=

# Geheim, Netlify Functions runtime
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
GHL_FUNNEL_CONTEXT_FIELD_KEY=
GHL_AUTOBEDRIJVEN_FUNNEL_WEBHOOK_URL=
GHL_BOOKING_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=

# Optioneel / gecontroleerd testen
GHL_TEST_MODE=true
GHL_TEST_CONTACT_PREFIX=AUTOPILOTS-QA
ALERT_WEBHOOK_URL=

# Vertaalworkflow — alleen lokaal of als beveiligde Netlify build-variabelen
I18N_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5.6-terra

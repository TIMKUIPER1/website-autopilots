---
import CampaignLeadForm from "../../../../components/campaign/CampaignLeadForm.astro";
import { autoDealerFunnel as funnel } from "../../../../data/marketingFunnels";
import CampaignLayout from "../../../../layouts/CampaignLayout.astro";
import type { SupportedLocale } from "../../../../i18n/languages";
import { campaignCopy } from "../../../../i18n/campaign";
import { localizedPath } from "../../../../i18n/routes";
interface Props { locale?: SupportedLocale }
const { locale="nl" }=Astro.props;
const c=campaignCopy[locale];
const canonical=localizedPath("landing.autobedrijven-ai-medewerker",locale);
const experiencePath=localizedPath("landing.autobedrijven-ai-medewerker-ervaring",locale);
const routeLabels=locale==="nl" ? ["Scan","Test","Impact"] : c.nav;
---

<CampaignLayout title={`${c.card} | Autopilots`} description={c.intro} canonical={canonical} campaign={funnel.trackingContext} locale={locale} contentId="landing.autobedrijven-ai-medewerker">
  <div id="ap-campaign" class="ap-entry-page" data-funnel-page="landing">
    <header class="ap-campaign-topbar ap-campaign-container"><span class="ap-campaign-brand">AUTOPILOTS</span><span class="ap-entry-badge"><i></i> {c.badge}</span></header>
    <div class="ap-entry-main ap-campaign-container">
      <section class="ap-entry-copy" aria-labelledby="entry-title">
        <p class="ap-entry-eyebrow">{c.eyebrow}</p>
        <h1 id="entry-title">{c.title} <em>{c.accent}</em></h1>
        <p>{c.intro}</p>
        <div class="ap-entry-points">{c.points.map(point=><span>{point}</span>)}</div>
        <div class="ap-entry-route" aria-label="Funnelroute">
          <span class="is-active">01 <b>{routeLabels[0]}</b></span><i></i>
          <span>02 <b>{routeLabels[1]}</b></span><i></i>
          <span>03 <b>{routeLabels[2]}</b></span>
        </div>
      </section>
      <section class="ap-entry-card" aria-label={c.access}>
        <CampaignLeadForm config={funnel} experiencePath={experiencePath} locale={locale} />
      </section>
    </div>
    <footer class="ap-entry-footer ap-campaign-container"><span>Autopilots. {c.footer}</span><a href={localizedPath("page.privacy",locale)} target="_blank" rel="noopener noreferrer">Privacy</a></footer>
  </div>
</CampaignLayout>

<style>
  .ap-entry-page{min-height:100vh}.ap-entry-badge{display:flex;align-items:center;gap:9px;color:#656565;font-size:10px;font-weight:800}.ap-entry-badge i{width:7px;height:7px;border-radius:50%;background:#65ad73;box-shadow:0 0 0 5px rgba(101,173,115,.11)}.ap-entry-main{display:grid;grid-template-columns:minmax(0,.88fr) minmax(500px,1.12fr);align-items:center;gap:64px;min-height:calc(100vh - 138px);padding-block:54px}.ap-entry-copy{max-width:520px}.ap-entry-eyebrow{margin:0 0 20px!important;color:#9f3826;font:700 10px/1.2 "Syne",sans-serif;letter-spacing:1.6px}.ap-entry-copy h1{margin:0;font-size:clamp(38px,4.4vw,54px)!important;line-height:1.07!important;letter-spacing:-.05em!important}.ap-entry-copy h1 em{display:block;color:#9f3826;font-style:italic}.ap-entry-copy>p:not(.ap-entry-eyebrow){max-width:500px;margin:24px 0 0!important;color:#656565;font-size:15px;line-height:1.65}.ap-entry-points{display:flex;flex-wrap:wrap;gap:9px;margin-top:25px}.ap-entry-points span{border:1px solid rgba(17,17,17,.1);border-radius:999px;background:#fff;padding:9px 11px;color:#555;font-size:9px;font-weight:850}.ap-entry-route{display:flex;align-items:center;gap:10px;margin-top:34px;color:#a1a19b;font:700 8px/1 "Syne",sans-serif;letter-spacing:.7px}.ap-entry-route span{display:flex;align-items:center;gap:7px}.ap-entry-route span.is-active{color:#9f3826}.ap-entry-route b{color:#111;font:800 10px/1 "Public Sans",sans-serif}.ap-entry-route i{width:28px;height:1px;background:rgba(17,17,17,.13)}.ap-entry-card{border:1px solid rgba(17,17,17,.1);border-radius:30px;background:#fff;padding:28px;box-shadow:0 26px 75px rgba(17,17,17,.09)}.ap-entry-footer{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:64px;border-top:1px solid rgba(17,17,17,.08);color:#808080;font-size:9px}.ap-entry-footer a{text-decoration:underline!important;text-underline-offset:3px}@media(max-width:900px){.ap-entry-main{grid-template-columns:1fr;gap:40px;min-height:0;padding-block:58px}.ap-entry-copy,.ap-entry-card{max-width:680px}.ap-entry-route{margin-top:26px}}@media(max-width:560px){.ap-entry-badge{font-size:0}.ap-entry-main{padding-block:42px}.ap-entry-copy h1{font-size:39px!important}.ap-entry-copy>p:not(.ap-entry-eyebrow){font-size:14px}.ap-entry-card{border-radius:25px;padding:20px}.ap-entry-route{display:none}}
</style>

<style>
  #ap-campaign.ap-entry-page{position:relative;isolation:isolate;overflow:hidden;background:radial-gradient(circle at 82% 18%,rgba(57,105,151,.27),transparent 28%),radial-gradient(circle at 92% 92%,rgba(159,56,38,.28),transparent 32%),linear-gradient(135deg,#081624 0%,#0d243a 52%,#0b1929 100%)!important;color:#fff}
  .ap-entry-page:before{position:absolute;z-index:-1;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:74px 74px;content:"";mask-image:linear-gradient(to bottom,black,transparent 82%)}
  .ap-entry-page:after{position:absolute;z-index:-1;right:-180px;bottom:-260px;width:620px;height:620px;border:1px solid rgba(255,255,255,.08);border-radius:50%;content:"";box-shadow:0 0 0 90px rgba(255,255,255,.015),0 0 0 180px rgba(255,255,255,.01)}
  .ap-entry-page .ap-campaign-topbar{border-color:rgba(255,255,255,.1)}
  .ap-entry-page .ap-campaign-brand{color:#fff;letter-spacing:3.5px}
  .ap-entry-page .ap-entry-badge{color:rgba(255,255,255,.68)}
  .ap-entry-badge i{background:#7bd48d;box-shadow:0 0 0 5px rgba(123,212,141,.1),0 0 18px rgba(123,212,141,.5)}
  .ap-entry-copy{position:relative}
  .ap-entry-eyebrow{display:inline-flex!important;width:max-content;border:1px solid rgba(231,162,149,.18);border-radius:999px;background:rgba(159,56,38,.14);padding:9px 13px;color:#eca99c!important;backdrop-filter:blur(12px)}
  .ap-entry-copy h1{color:#fff;text-wrap:balance}
  .ap-entry-copy h1 em{color:#cf634e;text-shadow:0 12px 42px rgba(159,56,38,.22)}
  .ap-entry-page .ap-entry-copy>p:not(.ap-entry-eyebrow){color:rgba(255,255,255,.67)}
  .ap-entry-page .ap-entry-points span{border-color:rgba(255,255,255,.12);background:rgba(255,255,255,.055);color:rgba(255,255,255,.76);box-shadow:inset 0 1px rgba(255,255,255,.05);backdrop-filter:blur(10px)}
  .ap-entry-route{color:rgba(255,255,255,.35)}
  .ap-entry-route span.is-active{color:#e7a295}
  .ap-entry-route b{color:rgba(255,255,255,.88)}
  .ap-entry-route i{background:rgba(255,255,255,.14)}
  .ap-entry-page .ap-entry-card{position:relative;overflow:hidden;border-color:rgba(255,255,255,.13);background:linear-gradient(145deg,rgba(24,48,72,.94),rgba(10,25,40,.97));box-shadow:0 36px 100px rgba(0,0,0,.34),inset 0 1px rgba(255,255,255,.07);backdrop-filter:blur(22px)}
  .ap-entry-card:before{position:absolute;top:-140px;right:-110px;width:310px;height:310px;border:1px solid rgba(112,167,216,.17);border-radius:50%;background:radial-gradient(circle,rgba(64,124,179,.14),transparent 66%);content:"";pointer-events:none}
  .ap-entry-card:after{position:absolute;right:-95px;bottom:-125px;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,rgba(159,56,38,.24),transparent 68%);content:"";pointer-events:none}
  .ap-entry-card>*{position:relative;z-index:1}
  .ap-entry-footer{border-color:rgba(255,255,255,.09);color:rgba(255,255,255,.42)}
  @media(max-width:900px){.ap-entry-main{padding-top:48px}.ap-entry-copy{max-width:660px}.ap-entry-card{width:100%}}
  @media(max-width:560px){.ap-entry-page:before{background-size:48px 48px}.ap-entry-copy h1{font-size:38px!important}.ap-entry-card{border-radius:27px;background:linear-gradient(155deg,rgba(23,48,72,.98),rgba(8,22,36,.99));box-shadow:0 24px 70px rgba(0,0,0,.3)}}
  @media(max-width:560px){
    #ap-campaign.ap-entry-page{overflow:clip}
    .ap-entry-page .ap-campaign-container{width:min(100% - 28px,1120px)}
    .ap-entry-page .ap-campaign-topbar{min-height:58px}
    .ap-entry-page .ap-campaign-brand{font-size:13px;letter-spacing:2.7px}
    .ap-entry-page .ap-entry-main{gap:28px;padding-block:30px 46px}
    .ap-entry-page .ap-entry-copy{max-width:100%}
    .ap-entry-page .ap-entry-eyebrow{margin-bottom:16px!important;padding:9px 12px;font-size:10px;letter-spacing:1.25px}
    .ap-entry-page .ap-entry-copy h1{max-width:390px;font-size:clamp(31px,9.2vw,37px)!important;line-height:1.09!important;letter-spacing:-.043em!important}
    .ap-entry-page .ap-entry-copy>p:not(.ap-entry-eyebrow){max-width:420px;margin-top:18px!important;font-size:16px;line-height:1.6}
    .ap-entry-page .ap-entry-points{gap:6px;margin-top:18px}
    .ap-entry-page .ap-entry-points span{padding:8px 10px;font-size:11px}
    .ap-entry-page .ap-entry-card{padding:17px;border-radius:23px}
    .ap-entry-page .ap-entry-footer{min-height:58px;font-size:11px}
  }
  @media(max-width:350px){
    .ap-entry-page .ap-entry-copy h1{font-size:30px!important}
    .ap-entry-page .ap-entry-points span:last-child{display:none}
    .ap-entry-page .ap-entry-card{padding:14px}
  }
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { SupportedLocale } from "../../i18n/languages";
import { localizedPath } from "../../i18n/routes";
import { getTermCards, termsPageCopy } from "../../i18n/legalPage";
interface Props { locale?: SupportedLocale }
const { locale = "nl" } = Astro.props;
const copy = termsPageCopy[locale];
const cards = getTermCards(locale);
---

<BaseLayout title={copy.title} description={copy.description} canonical={localizedPath("page.terms",locale)} locale={locale} contentId="page.terms" noindex={true}>
  <article class="ap-ecosystem ap-legal-page">
    <nav class="ap-breadcrumb" aria-label="Breadcrumb"><div class="ap-container"><a href={localizedPath("page.home",locale)}>{copy.home}</a><span aria-hidden="true">/</span><span aria-current="page">{copy.name}</span></div></nav>
    <section class="ap-eco-hero"><div class="ap-container ap-eco-copy"><div class="ap-kicker">{copy.kicker}</div><h1>{copy.hero} <span class="ap-title-accent">{copy.accent}</span></h1><p class="ap-lead">{copy.lead}</p></div></section>
    <section class="ap-section ap-soft-section"><div class="ap-container"><div class="ap-card-grid ap-card-grid-3">
      {cards.map(([title,text],index)=><article class="ap-info-card"><span>{String(index+1).padStart(2,"0")}</span><h2>{title}</h2><p>{text}</p></article>)}
    </div><div class="ap-actions"><a class="ap-button ap-button-primary" href={localizedPath("page.order",locale)}>{copy.order}</a><a class="ap-button ap-button-secondary" href={localizedPath("page.privacy",locale)}>{copy.privacy}</a><a class="ap-button ap-button-secondary" href={localizedPath("page.appointment",locale)}>{copy.check}</a></div></div></section>
  </article>
</BaseLayout>

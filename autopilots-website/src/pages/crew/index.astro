---
import BaseLayout from "../../layouts/BaseLayout.astro";
const crew = [
  ["Tim Kuiper","Sales & Partnerships","/team/tim-kuiper.png"],
  ["Larissa Rosanna Pen","Head of Operations","/team/larissa-rosanna-pen.webp"],
  ["Hasan Shabbir","Head of Development","/team/hasan-shabbir.png"],
  ["Albert Verlinden","AI Consultant","/team/albert-verlinden.png"],
  ["Pratt Olan","AI Specialist","/team/pratt-olan.webp"],
  ["Luca van der Meer","Online Marketeer","/team/luca-van-der-meer.webp"],
  ["Mit Dong","AI Specialist","/team/mit-dong.webp"],
  ["Rohail Zuberi","AI Specialist","/team/rohail-zuberi.webp"]
];
const inspirations=["Tony Robbins","Jim Rohn","Stephen R. Covey","Dale Carnegie","Napoleon Hill","Brian Tracy","Zig Ziglar","Les Brown","Robin Sharma","Dr. Joe Dispenza","Deepak Chopra","Eckhart Tolle","Wayne Dyer","Brendon Burchard","Jay Shetty","Mel Robbins","Simon Sinek","Grant Cardone","Gary Vaynerchuk","Tim Ferriss","James Clear","Mark Manson","Robert Greene","Jordan Peterson","David Goggins","Oprah Winfrey","Steven Bartlett","Brené Brown","Lewis Howes","Ed Mylett","Tom Bilyeu","Alex Hormozi","Naval Ravikant","Sadhguru"];
---
<BaseLayout title="Crew | Autopilots" description="Maak kennis met de Autopilots crew achter AI medewerkers, CRM-koppelingen, workflows en optimalisatie." canonical="/crew/">
  <main class="ap-crew-page"><section class="ap-section"><div class="ap-container">
    <div class="ap-kicker">Crew</div><h1 class="ap-page-title">Autopilots maakt AI begrijpelijk, menselijk en <span class="ap-accent">bruikbaar in de praktijk.</span></h1>
    <p class="ap-lead">AI gaat de manier waarop bedrijven werken blijvend veranderen. Autopilots is er om die verandering behapbaar te maken: voor ondernemers die vooruit willen, voor teams die ruimte nodig hebben en voor bedrijven die klantcommunicatie persoonlijker, slimmer en schaalbaarder willen organiseren.</p>

    <section class="ap-crew-intro" aria-label="Waarom Autopilots">
      <div class="ap-crew-console">
        <header class="ap-crew-console-head"><div><i></i><span>Autopilots werkwijze</span></div><strong>Mens + AI</strong></header>
        <div class="ap-crew-console-body">
          <article class="ap-crew-story"><div class="ap-kicker">Waarom Autopilots</div><h2>AI wordt pas waardevol als je team ermee kan werken.</h2><p>Autopilots vertaalt AI naar concrete processen: klantvragen, opvolging, planning, CRM en service. Praktisch, menselijk en passend bij het bedrijf.</p></article>
          <ol class="ap-crew-values">{[["01","AI behapbaar maken","Heldere taal, duidelijke keuzes en een route die het team begrijpt."],["02","Vrijheid voor bedrijven","Minder herhaalwerk, snellere opvolging en meer ruimte voor menselijk contact."],["03","Een toekomstbestendige operatie","Elk contactmoment bouwt aan betere data, processen en klantrelaties."]].map(item=><li><span>{item[0]}</span><div><h3>{item[1]}</h3><p>{item[2]}</p></div></li>)}</ol>
        </div>
        <footer class="ap-crew-console-foot"><span>Begrijpen</span><i></i><span>Bouwen</span><i></i><strong>Meegroeien</strong></footer>
      </div>
    </section>

    <section class="ap-crew-connection"><div class="ap-crew-connection-copy"><div class="ap-kicker">Oprechte verbinding</div><h2>We bouwen het liefst met bedrijven die vooruit willen.</h2><p>Autopilots hecht waarde aan oprechte connectie. Daarom werken we het liefst samen met ondernemers en teams met groeiambitie: bedrijven die vooruitstrevend zijn, een duidelijke visie hebben en durven bouwen aan een slimmere manier van werken.</p><p>In ons team draait ontwikkeling niet alleen om zakelijk succes, maar ook om persoonlijk succes. Naast een goede wifi verbinding blijft oprechte verbinding uitzonderlijk belangrijk. Dat voel je in hoe we communiceren, implementeren en langetermijnpartnerschappen bouwen.</p></div><div class="ap-crew-connection-cards">{[["01","Groeiambitie","We passen het best bij bedrijven die willen opschalen, verbeteren en niet blijven hangen in oude processen."],["02","Persoonlijke ontwikkeling","We geloven dat betere bedrijven ontstaan wanneer mensen blijven leren, reflecteren en verantwoordelijkheid nemen."],["03","Lange termijn","Geen snelle AI truc, maar een samenwerking waarin techniek, mensen en operatie samen volwassen worden."]].map(item=><article><span>{item[0]}</span><strong>{item[1]}</strong><p>{item[2]}</p></article>)}</div><div class="ap-inspiration-marquee"><div class="ap-kicker">Ons team persoonlijke inspiratiebronnen</div><div class="ap-inspiration-track">{[...inspirations,...inspirations].map((name,index)=><span aria-hidden={index>=inspirations.length?"true":undefined}>{name}</span>)}</div></div></section>

    <section class="ap-section ap-team-inline"><div class="ap-section-head"><div class="ap-kicker">Meet the crew</div><h2 class="ap-section-title">Built by the <span class="ap-accent">Autopilots team.</span></h2><p class="ap-lead">Een compact team voor strategie, bouw, operations en optimalisatie. Autopilots blijft betrokken na livegang, zodat de AI beter wordt op basis van echte gesprekken.</p></div><div class="ap-team-shell"><div class="ap-team-slider" data-crew-slider>{crew.map(member=><article><img src={member[2]} alt={member[0]} loading="lazy" /><strong>{member[0]}</strong><span>{member[1]}</span></article>)}</div><div class="ap-team-controls"><span>Autopilots crew</span><div><button type="button" data-crew-prev aria-label="Vorige">←</button><button type="button" data-crew-next aria-label="Volgende">→</button></div></div></div></section>
    <div class="ap-crew-band"><div class="ap-kicker">Waar we voor staan</div><h2>Vrijheid, groei en oprechte samenwerking.</h2><p>Autopilots bouwt AI die menselijk voelt en praktisch werkt. Vanuit vertrouwen, heldere communicatie en een samenwerking die blijft meegroeien.</p></div>
  </div></section></main>
</BaseLayout>

<script is:inline>(()=>{const slider=document.querySelector('[data-crew-slider]');if(!slider)return;const move=direction=>slider.scrollBy({left:direction*(slider.clientWidth*.72),behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});document.querySelector('[data-crew-prev]')?.addEventListener('click',()=>move(-1));document.querySelector('[data-crew-next]')?.addEventListener('click',()=>move(1))})();</script>

<style>
  .ap-crew-page .ap-lead{max-width:900px}.ap-crew-intro{margin-top:56px}.ap-crew-console{overflow:hidden;border:1px solid rgba(255,255,255,.08);border-radius:34px;background:radial-gradient(circle at 92% 8%,rgba(159,56,38,.22),transparent 27%),linear-gradient(145deg,#111 0%,#111 72%,#18110f 100%);color:#fff;box-shadow:0 24px 70px rgba(17,17,17,.14)}.ap-crew-console-head{display:flex;min-height:62px;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.09);padding:0 34px;color:rgba(255,255,255,.66);font-family:"Syne",sans-serif;font-size:11px;font-weight:700;letter-spacing:1.3px;text-transform:uppercase}.ap-crew-console-head div{display:flex;align-items:center;gap:11px}.ap-crew-console-head i{width:7px;height:7px;border-radius:50%;background:#9f3826;box-shadow:0 0 0 6px rgba(159,56,38,.13)}.ap-crew-console-head strong{color:#fff;font:inherit}.ap-crew-console-body{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(340px,.92fr)}.ap-crew-story{display:flex;min-height:440px;flex-direction:column;justify-content:center;border-right:1px solid rgba(255,255,255,.09);padding:46px 48px}.ap-crew-story .ap-kicker{margin-bottom:20px;color:#e4a092}.ap-crew-story h2,.ap-crew-connection h2{font-size:clamp(30px,3.7vw,48px);line-height:1.08}.ap-crew-story p{max-width:590px;margin-top:22px;color:rgba(255,255,255,.68);font-size:16px;line-height:1.7}.ap-crew-values{display:flex;margin:0;padding:25px 34px;flex-direction:column;justify-content:center;list-style:none}.ap-crew-values li{display:grid;grid-template-columns:42px minmax(0,1fr);gap:18px;align-items:start;padding:26px 0;border-bottom:1px solid rgba(255,255,255,.09)}.ap-crew-values li:last-child{border-bottom:0}.ap-crew-values>li>span,.ap-crew-connection-cards span{display:grid;width:42px;height:42px;place-items:center;border-radius:14px;background:rgba(255,255,255,.08);color:#e4a092;font-family:"Syne",sans-serif;font-size:11px;font-weight:700}.ap-crew-values h3{margin:1px 0 0;color:#fff;font-size:20px;line-height:1.25}.ap-crew-values p,.ap-crew-connection-cards p{margin:8px 0 0;color:rgba(255,255,255,.58);font-size:14px;line-height:1.55}.ap-crew-console-foot{display:grid;grid-template-columns:auto minmax(30px,1fr) auto minmax(30px,1fr) auto;gap:18px;align-items:center;border-top:1px solid rgba(255,255,255,.09);padding:19px 34px;color:rgba(255,255,255,.62);font-family:"Syne",sans-serif;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase}.ap-crew-console-foot i{height:1px;background:linear-gradient(90deg,rgba(228,160,146,.18),rgba(228,160,146,.72),rgba(228,160,146,.18))}.ap-crew-console-foot strong{color:#e4a092}.ap-crew-connection{overflow:hidden;margin-top:28px;border:1px solid var(--ap-line);border-radius:34px;background:radial-gradient(circle at 92% 18%,rgba(159,56,38,.09),transparent 26%),#fff;padding:34px;box-shadow:0 16px 50px rgba(17,17,17,.055)}.ap-crew-connection-copy{max-width:880px}.ap-crew-connection-copy p{margin:18px 0 0;color:var(--ap-muted);font-size:17px;line-height:1.7}.ap-crew-connection-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:26px}.ap-crew-connection-cards article{border:1px solid var(--ap-line);border-radius:24px;background:var(--ap-soft-2);padding:20px}.ap-crew-connection-cards strong{display:block;margin-top:16px;font-size:19px}.ap-crew-connection-cards p{color:var(--ap-muted)}.ap-inspiration-marquee{margin-top:28px;overflow:hidden;border-radius:26px;background:#111;padding:20px 0;color:#fff}.ap-inspiration-marquee .ap-kicker{margin:0 24px 14px;color:#e4a092}.ap-inspiration-track{display:flex;width:max-content;gap:10px;animation:crewMarquee 96s linear infinite}.ap-inspiration-track span{border:1px solid rgba(255,255,255,.13);border-radius:999px;background:rgba(255,255,255,.075);padding:10px 14px;font-size:13px;font-weight:700}@keyframes crewMarquee{to{transform:translateX(-50%)}}.ap-team-inline{padding-bottom:28px}.ap-team-shell{overflow:hidden;margin-top:32px;border:1px solid var(--ap-line);border-radius:34px;background:#fff;box-shadow:0 16px 50px rgba(17,17,17,.06)}.ap-team-slider{display:flex;gap:0;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:8px}.ap-team-slider::-webkit-scrollbar{display:none}.ap-team-slider article{flex:0 0 33.333%;scroll-snap-align:start;padding:10px}.ap-team-slider img{display:block;width:100%;aspect-ratio:1/1;border-radius:999px;object-fit:cover;background:#111}.ap-team-slider strong{display:block;margin-top:16px;font-size:21px}.ap-team-slider span{display:block;margin-top:6px;color:var(--ap-muted);font-size:13px;font-weight:700}.ap-team-controls{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--ap-line);padding:16px 20px}.ap-team-controls>span{color:var(--ap-muted);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:1px}.ap-team-controls button{width:42px;height:42px;margin-left:6px;border:1px solid var(--ap-line);border-radius:50%;background:#fff;cursor:pointer}.ap-crew-band{border-radius:30px;background:linear-gradient(135deg,#111,#151312 68%,#24130f);color:#fff;padding:32px}.ap-crew-band .ap-kicker{color:#e4a092}.ap-crew-band h2{font-size:clamp(26px,3.1vw,40px)}.ap-crew-band p{max-width:660px;margin-top:14px;color:rgba(255,255,255,.68);line-height:1.58}@media(max-width:900px){.ap-crew-console-body{grid-template-columns:1fr}.ap-crew-story{min-height:0;border-right:0;border-bottom:1px solid rgba(255,255,255,.09)}.ap-crew-connection-cards{grid-template-columns:1fr}.ap-team-slider article{flex-basis:50%}}@media(max-width:560px){.ap-crew-intro{margin-top:42px}.ap-crew-console{border-radius:26px}.ap-crew-console-head{min-height:56px;padding:0 22px}.ap-crew-console-head strong{display:none}.ap-crew-story{padding:34px 22px}.ap-crew-values{padding:9px 22px}.ap-crew-values li{gap:14px;padding:22px 0}.ap-crew-console-foot{grid-template-columns:1fr;gap:11px;padding:20px 22px}.ap-crew-console-foot i{display:none}.ap-crew-console-foot span,.ap-crew-console-foot strong{position:relative;padding-left:20px}.ap-crew-console-foot span:before,.ap-crew-console-foot strong:before{position:absolute;left:0;content:"\2192";color:#e4a092}.ap-crew-connection{border-radius:24px;padding:22px}.ap-team-slider article{flex-basis:100%}.ap-team-shell{border-radius:26px}.ap-crew-band{padding:24px}}
  .ap-team-slider article{display:flex;flex-direction:column;align-items:center;text-align:center;padding:24px 10px}.ap-team-slider img{width:40%;max-width:150px;min-width:112px;margin:0 auto}.ap-team-slider strong{margin-top:18px}
  @media(max-width:560px){.ap-team-slider img{width:40%;max-width:140px;min-width:108px}}
</style>

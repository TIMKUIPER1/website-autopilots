---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GhlEmbed from "../../components/embeds/GhlEmbed.astro";
import { products } from "../../data/products";
import { niches } from "../../data/niches";
import AppointmentFallbackForm from "../../components/forms/AppointmentFallbackForm.astro";
import { publicRuntime } from "../../config/publicRuntime";
import type { SupportedLocale } from "../../i18n/languages";
import { localizedPath } from "../../i18n/routes";
import { localizedNicheData } from "../../i18n/catalog";
import { localizedProductData } from "../../i18n/productPage";
import { appointmentCopy } from "../../i18n/conversionPage";
interface Props { locale?: SupportedLocale }
const { locale = "nl" } = Astro.props;
const copy = appointmentCopy[locale];
const contextData = JSON.stringify({ products: products.map((product) => {const item=localizedProductData(locale,product); return {slug:item.slug,name:item.name}}), niches: niches.map((niche) => {const item=localizedNicheData(locale,niche);return {slug:item.slug,name:item.name}}), forWord:copy.for }).replaceAll("<", "\\u003c");
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonical={localizedPath("page.appointment",locale)}
  locale={locale}
  contentId="page.appointment"
>
  <section class="ap-section">
    <div class="ap-container ap-booking-grid">
      <aside class="ap-booking-copy">
        <div class="ap-kicker">{copy.kicker}</div>
        <h1 class="ap-page-title">{copy.hero}</h1>
        <p class="ap-lead">{copy.lead}</p>
        <div class="ap-booking-context" data-booking-context hidden><span>{copy.context}</span><strong data-booking-context-title></strong><a href={localizedPath("page.products",locale)}>{copy.change}</a></div>
        <div class="ap-booking-list">
          {copy.steps.map((step,index)=><div><span>{String(index+1).padStart(2,"0")}</span>{step}</div>)}
        </div>
      </aside>
      <div class="ap-booking-frame">
        <GhlEmbed
          src={publicRuntime.ghlCalendarUrl}
          title={copy.calendar}
          id="autopilots-afspraak-calendar"
          loading="eager"
          locale={locale}
        />
      </div>
      <details class="ap-booking-fallback"><summary>{copy.fallback}</summary><AppointmentFallbackForm locale={locale} /></details>
    </div>
  </section>
  <script id="ap-booking-data" type="application/json" set:html={contextData}></script>
</BaseLayout>

<script is:inline>
  (() => {
    window.dispatchEvent(new CustomEvent("autopilots:analytics", { detail: { event:"appointment_page_opened", page_path:location.pathname } }));
    const node = document.getElementById("ap-booking-data");
    const card = document.querySelector("[data-booking-context]");
    if (!node || !card) return;
    const data = JSON.parse(node.textContent || "{}");
    const params = new URLSearchParams(location.search);
    const product = data.products.find((item) => item.slug === params.get("product"));
    const niche = data.niches.find((item) => item.slug === params.get("branche"));
    if (!product && !niche) return;
    const parts = [product?.name, niche ? `${data.forWord} ${niche.name}` : ""].filter(Boolean);
    card.querySelector("[data-booking-context-title]").textContent = parts.join(" ");
    card.hidden = false;
  })();
</script>

<style>
  .ap-booking-grid {
    display: grid;
    grid-template-columns: 0.78fr 1.22fr;
    gap: 18px;
    align-items: start;
  }

  .ap-booking-copy .ap-page-title { font-size: clamp(34px, calc(5vw - 12px), 54px); }
  .ap-booking-copy{padding:clamp(18px,2.5vw,34px) 0}

  .ap-booking-context { display: grid; gap: 7px; margin-top: 22px; border: 1px solid rgba(159,56,38,.2); border-radius: 19px; background: #fff7f4; padding: 15px; }
  .ap-booking-context[hidden] { display: none; }
  .ap-booking-context span { color: var(--ap-brown); font-family: "Syne", sans-serif; font-size: 9px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; }
  .ap-booking-context strong { font-size: 15px; }
  .ap-booking-context a { color: var(--ap-brown); font-size: 12px; font-weight: 850; }

  .ap-booking-list {
    display: grid;
    gap: 0;
    margin-top: 22px;
  }

  .ap-booking-list div {
    display:grid;
    grid-template-columns:42px 1fr;
    align-items:center;
    border-bottom: 1px solid var(--ap-line);
    padding: 14px 0;
    font-size: 14px;
    font-weight: 800;
  }
  .ap-booking-list div:first-child{border-top:1px solid var(--ap-line)}
  .ap-booking-list span{color:var(--ap-brown);font-family:"Syne",sans-serif;font-size:10px;letter-spacing:1px}

  .ap-booking-frame {
    overflow: hidden;
    border: 1px solid var(--ap-line);
    border-radius: 30px;
    background: var(--ap-card);
    box-shadow: 0 16px 50px rgba(17, 17, 17, 0.065);
  }

  .ap-booking-frame :global(iframe) {
    min-height: 680px;
  }
  .ap-booking-fallback{grid-column:1/-1;border:1px solid var(--ap-line);border-radius:24px;background:var(--ap-soft-2);padding:18px}.ap-booking-fallback>summary{cursor:pointer;font-size:14px;font-weight:850;list-style-position:inside}

  .ap-booking-note {
    border-top: 1px solid var(--ap-line);
    padding: 14px 16px;
    color: var(--ap-muted);
    font-size: 12px;
    line-height: 1.45;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .ap-booking-grid {
      grid-template-columns: 1fr;
    }

    .ap-booking-frame :global(iframe) {
      min-height: 620px;
    }
  }
</style>

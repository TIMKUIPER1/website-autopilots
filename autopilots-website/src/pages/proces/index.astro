---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { SupportedLocale } from "../../i18n/languages";
import { localizedPath } from "../../i18n/routes";
import { processPageCopy } from "../../i18n/processPage";
interface Props { locale?: SupportedLocale }
const { locale = "nl" } = Astro.props;
const copy = processPageCopy[locale];
const originalSteps = [
  {title:"Onboarding",text:"We halen doelen, doelgroep, processen, huidige tools, tone of voice en belangrijkste contactmomenten naar boven.",tags:["Doelen","Tools","Klantreis"],output:"Klantreis, kanalen, doelgroep en succescriteria staan scherp.",action:"Projectboard, intakevelden en eerste proceskaart worden ingericht."},
  {title:"Architectuur",text:"We tekenen hoe chat, voice, planning, opvolging, CRM en menselijke fallback door het bedrijf moeten lopen.",tags:["Flow","Fallback","Datavelden"],output:"Een duidelijke blauwdruk van gesprek naar actie.",action:"Datavelden, triggers, routes en overdrachtsmomenten worden vastgelegd."},
  {title:"AI-brein",text:"We bouwen het geheugen: scripts, vragen, uitzonderingen, branchekennis, tone of voice en persoonlijke context.",tags:["Scripts","Kennisbank","Uitzonderingen"],output:"Een AI-brein dat weet wat wel, niet en wanneer menselijk moet.",action:"Kennisbank, gesprekslogica en fallbackregels worden klaargezet."},
  {title:"Koppelingen",text:"We verbinden CRM, agenda, mail, WhatsApp, ticketing, formulieren, webhooks en API-acties.",tags:["CRM","Agenda","API"],output:"Alle belangrijke systemen praten met elkaar.",action:"Agenda, CRM, notificaties, tickets en opvolging worden gekoppeld."},
  {title:"Bouwen",text:"We bouwen scenario’s voor chat, voice, opvolging, planning en CRM-acties en testen de eerste flows.",tags:["Voice","Chat","Opvolging"],output:"Een werkende eerste versie van de AI-medewerker.",action:"Gespreksflows, acties, embeds en automatiseringen worden gebouwd."},
  {title:"Demo",text:"We lopen gesprekken door, controleren uitzonderingen, scherpen teksten aan en verfijnen de klantreis.",tags:["Testgesprekken","Uitzonderingen","Feedback"],output:"Een demo die voelt als jullie bedrijf, niet als een generieke bot.",action:"Feedback wordt verwerkt in scripts, gespreksregels en systeemacties."},
  {title:"Livegang",text:"We zetten embed, telefonie, formulieren, tracking en afspraakflow gecontroleerd live.",tags:["Embed","Telefonie","Tracking"],output:"De AI-medewerker staat live op de juiste kanalen.",action:"Live routes, notificaties en meetpunten worden actief gezet."},
  {title:"Optimalisatie",text:"We monitoren echte gesprekken, analyseren waar mensen afhaken en verbeteren gesprekslogica en support.",tags:["Monitoring","Data","Support"],output:"De AI wordt slimmer op basis van echte klantcontacten.",action:"Gespreksdata wordt gebruikt voor betere antwoorden, routes en opvolging."}
];
const steps = locale === "nl" ? originalSteps : copy.steps;
const processData=JSON.stringify({steps,step:copy.step}).replaceAll("<","\\u003c");
---
<BaseLayout title={copy.title} description={copy.description} canonical={localizedPath("page.process",locale)} locale={locale} contentId="page.process">
  <article class="ap-process-page" data-process-root>
    <section class="ap-section ap-process-hero"><div class="ap-container ap-process-hero-grid"><div><div class="ap-kicker">{copy.kicker}</div><h1>{copy.hero}</h1><p class="ap-lead">{copy.lead}</p><div class="ap-actions"><a class="ap-button ap-button-primary" href={localizedPath("page.appointment",locale)}>{copy.appointment}</a><a class="ap-text-link" href="#processtappen">{copy.view} →</a></div></div><aside class="ap-system-panel"><div class="ap-system-map">{copy.map.map(item=><div class="ap-map-row"><span>{item[0]}</span><div><strong>{item[1]}</strong><em>{item[2]}</em></div></div>)}</div></aside></div></section>

    <section class="ap-section" id="processtappen"><div class="ap-container"><div class="ap-section-head"><div class="ap-kicker">{copy.idea}</div><h2 class="ap-section-title">{copy.sectionTitle}</h2><p class="ap-text">{copy.sectionText}</p></div><div class="ap-process-experience"><div class="ap-process-rail" role="tablist" aria-label={copy.stepsLabel}>{steps.map((step,index)=><button class:list={["ap-process-dot",{"is-active":index===0}]} type="button" role="tab" aria-selected={index===0?"true":"false"} tabindex={index===0?0:-1} data-step={index}><span>{String(index+1).padStart(2,"0")}</span><strong>{step.title}</strong></button>)}</div><article class="ap-process-stage" role="tabpanel" aria-live="polite"><div class="ap-process-glow"><span></span><span></span><span></span></div><div class="ap-process-stage-copy"><div class="ap-kicker" data-process-kicker>{copy.step} 01</div><h3 data-process-title>{steps[0].title}</h3><p data-process-text>{steps[0].text}</p><div class="ap-process-tags" data-process-tags>{steps[0].tags.map(tag=><span>{tag}</span>)}</div></div><div class="ap-process-output"><span>{copy.output}</span><strong data-process-output>{steps[0].output}</strong></div><div class="ap-process-action"><span>{copy.action}</span><strong data-process-action>{steps[0].action}</strong></div><div class="ap-process-progress"><span data-process-progress></span></div></article></div></div></section>

    <section class="ap-section ap-process-integrations"><div class="ap-container"><details><summary>{copy.integrations} <span aria-hidden="true">+</span></summary><p>{copy.integrationText}</p><div>{["GoHighLevel","HubSpot","Salesforce","Google Calendar","Outlook","WhatsApp","Zapier","Make","Exact","Teamleader","Pipedrive","Webhooks","API"].map(item=><span>{item}</span>)}</div></details></div></section>

    <section class="ap-section"><div class="ap-container"><div class="ap-dark-band"><div class="ap-kicker">{copy.after}</div><h2 class="ap-section-title">{copy.afterTitle}</h2><p class="ap-text">{copy.afterText}</p></div></div></section>
    <section class="ap-section"><div class="ap-container"><div class="ap-final-cta"><div><div class="ap-kicker">{copy.next}</div><h2 class="ap-section-title">{copy.nextTitle}</h2><p class="ap-text">{copy.nextText}</p></div><div class="ap-actions"><a class="ap-button ap-button-primary" href={localizedPath("page.appointment",locale)}>{copy.appointment}</a><a class="ap-text-link" href={localizedPath("page.order",locale)}>{copy.order} →</a></div></div></div></section>
  </article>
  <script id="ap-process-data" type="application/json" set:html={processData}></script>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-process-root]");
    const dataNode = document.getElementById("ap-process-data");
    if (!root || !dataNode) return;
    const data = JSON.parse(dataNode.textContent || "{}");
    const buttons = [...root.querySelectorAll("[data-step]")];
    const set = (selector, value) => { const node = root.querySelector(selector); if (node) node.textContent = value; };
    const show = (index) => {
      const item = data.steps[index];
      buttons.forEach((button, buttonIndex) => {
        const active = buttonIndex === index;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-selected", String(active));
        button.tabIndex = active ? 0 : -1;
      });
      set("[data-process-kicker]", `${data.step} ${String(index + 1).padStart(2, "0")}`);
      set("[data-process-title]", item.title);
      set("[data-process-text]", item.text);
      set("[data-process-output]", item.output);
      set("[data-process-action]", item.action);
      root.querySelector("[data-process-tags]").innerHTML = item.tags.map((tag) => `<span>${tag}</span>`).join("");
      root.querySelector("[data-process-progress]").style.width = `${((index + 1) / data.steps.length) * 100}%`;
    };
    buttons.forEach((button, index) => {
      button.addEventListener("click", () => show(index));
      button.addEventListener("keydown", (event) => {
        if (!["ArrowRight", "ArrowDown", "ArrowLeft", "ArrowUp", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        const last = buttons.length - 1;
        const next = event.key === "Home" ? 0 : event.key === "End" ? last : ["ArrowRight", "ArrowDown"].includes(event.key) ? (index + 1) % (last + 1) : (index - 1 + last + 1) % (last + 1);
        show(next);
        buttons[next].focus();
      });
    });
    show(0);
  })();
</script>

<style>
  .ap-process-hero-grid{display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:20px;align-items:stretch}.ap-process-hero h1{max-width:820px}.ap-system-panel{border-radius:34px;background:#111;color:#fff;padding:28px}.ap-system-map{display:grid;gap:12px}.ap-map-row{display:grid;grid-template-columns:52px 1fr;gap:12px;align-items:center;border:1px solid rgba(255,255,255,.13);border-radius:22px;background:rgba(255,255,255,.08);padding:14px}.ap-map-row>span{display:grid;width:52px;height:52px;place-items:center;border-radius:17px;background:#fff;color:var(--ap-brown);font-family:"Syne",sans-serif;font-size:11px;font-weight:700}.ap-map-row strong,.ap-map-row em{display:block}.ap-map-row strong{font-size:16px}.ap-map-row em{margin-top:4px;color:rgba(255,255,255,.68);font-style:normal;font-size:13px;line-height:1.35}.ap-process-experience{display:grid;grid-template-columns:minmax(260px,.74fr) minmax(0,1.26fr);gap:26px}.ap-process-rail{position:relative;display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.ap-process-rail:before{content:"";position:absolute;inset:44px;z-index:0;border:1px dashed rgba(159,56,38,.22);border-radius:36px}.ap-process-dot{position:relative;z-index:1;display:grid;min-height:138px;place-items:center;gap:12px;border:1px solid var(--ap-line);border-radius:999px;background:rgba(255,255,255,.84);padding:20px 16px;font:inherit;cursor:pointer;transition:.22s}.ap-process-dot:hover,.ap-process-dot.is-active{transform:translateY(-5px);border-color:rgba(159,56,38,.36);background:#fffaf8}.ap-process-dot span{display:grid;width:54px;height:54px;place-items:center;border-radius:50%;background:#111;color:#fff;font-family:"Syne",sans-serif;font-size:13px;font-weight:800}.ap-process-dot.is-active span{background:var(--ap-brown);box-shadow:0 0 0 10px rgba(159,56,38,.1)}.ap-process-dot strong{font-size:15px}.ap-process-stage{position:relative;overflow:hidden;display:grid;min-height:470px;grid-template-columns:minmax(0,1fr) minmax(240px,.7fr);gap:18px;align-content:end;border-radius:36px;background:#111;color:#fff;padding:34px;box-shadow:0 24px 70px rgba(17,17,17,.14)}.ap-process-stage:before{content:"";position:absolute;inset:24px;border:1px solid rgba(255,255,255,.08);border-radius:28px}.ap-process-glow span{position:absolute;border-radius:50%;background:rgba(159,56,38,.22);filter:blur(18px)}.ap-process-glow span:nth-child(1){right:12%;top:18%;width:150px;height:150px}.ap-process-glow span:nth-child(2){left:16%;bottom:18%;width:110px;height:110px}.ap-process-glow span:nth-child(3){right:30%;bottom:30%;width:72px;height:72px;background:rgba(255,255,255,.09)}.ap-process-stage-copy,.ap-process-output,.ap-process-action,.ap-process-progress{position:relative;z-index:1}.ap-process-stage .ap-kicker{color:#e4a092}.ap-process-stage h3{font-size:clamp(42px,5vw,64px)}.ap-process-stage p{margin-top:20px;color:rgba(255,255,255,.74);font-size:18px;line-height:1.62}.ap-process-tags{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}.ap-process-tags span{border:1px solid rgba(255,255,255,.12);border-radius:999px;background:rgba(255,255,255,.08);padding:9px 13px;font-size:12px;font-weight:800}.ap-process-output,.ap-process-action{align-self:end;border:1px solid rgba(255,255,255,.12);border-radius:24px;background:rgba(255,255,255,.08);padding:22px}.ap-process-output span,.ap-process-action span,.ap-arch-output span{display:block;color:#e4a092;font-family:"Syne",sans-serif;font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase}.ap-process-output strong,.ap-process-action strong{display:block;margin-top:10px;color:rgba(255,255,255,.84);font-size:15px;line-height:1.5}.ap-process-action{grid-column:2}.ap-process-progress{grid-column:1/-1;height:8px;overflow:hidden;border-radius:999px;background:rgba(255,255,255,.12)}.ap-process-progress span{display:block;width:12.5%;height:100%;border-radius:inherit;background:var(--ap-brown);transition:width .35s ease}.ap-architecture-live{border:1px solid var(--ap-line);border-radius:34px;background:#fff;padding:18px;box-shadow:0 16px 50px rgba(17,17,17,.055)}.ap-architecture-tabs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}.ap-architecture-tabs button{border:1px solid var(--ap-line);border-radius:999px;background:#fff;padding:11px 14px;color:var(--ap-muted);font:inherit;font-size:13px;font-weight:800;cursor:pointer}.ap-architecture-tabs button:hover,.ap-architecture-tabs button.is-active{border-color:var(--ap-brown);background:var(--ap-brown);color:#fff}.ap-architecture-map{position:relative;overflow:hidden;display:grid;grid-template-columns:minmax(260px,.85fr) minmax(360px,1.15fr);gap:16px;border-radius:28px;background:linear-gradient(135deg,#111,#1c1715);color:#fff;padding:24px}.ap-arch-orbit span{position:absolute;width:180px;height:180px;border:1px solid rgba(159,56,38,.24);border-radius:50%}.ap-arch-orbit span:nth-child(1){left:-60px;top:30px}.ap-arch-orbit span:nth-child(2){right:16%;top:44px}.ap-arch-orbit span:nth-child(3){right:-70px;bottom:-54px}.ap-arch-main,.ap-arch-route,.ap-arch-output{position:relative;z-index:1}.ap-arch-main{border:1px solid rgba(255,255,255,.14);border-radius:24px;background:rgba(255,255,255,.08);padding:22px}.ap-arch-main>span,.ap-arch-route span{display:grid;width:52px;height:52px;place-items:center;border-radius:17px;background:#fff;color:var(--ap-brown);font-family:"Syne",sans-serif;font-size:12px;font-weight:700}.ap-arch-main h3{margin-top:26px;font-size:34px}.ap-arch-main p{margin-top:12px;color:rgba(255,255,255,.72);font-size:15px;line-height:1.55}.ap-arch-route{display:grid;gap:10px}.ap-arch-route>div{display:grid;grid-template-columns:52px 1fr;gap:12px;align-items:center;border:1px solid rgba(255,255,255,.1);border-radius:20px;background:rgba(255,255,255,.06);padding:12px;opacity:.48;transition:.22s}.ap-arch-route>div.is-active{opacity:1;transform:translateX(4px);border-color:rgba(159,56,38,.42);background:rgba(159,56,38,.16)}.ap-arch-output{grid-column:1/-1;border:1px solid rgba(159,56,38,.28);border-radius:22px;background:rgba(159,56,38,.18);padding:18px}.ap-arch-output strong{display:block;margin-top:8px;font-size:18px}.ap-integration-strip{overflow:hidden;margin-top:22px;mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}.ap-integration-track{display:flex;width:max-content;gap:10px;animation:apSlide 34s linear infinite}.ap-integration-track span{border:1px solid var(--ap-line);border-radius:999px;background:#fff;padding:10px 14px;font-size:12px;font-weight:800}@keyframes apSlide{to{transform:translateX(-50%)}}@media(max-width:980px){.ap-process-hero-grid,.ap-process-experience,.ap-process-stage,.ap-architecture-map{grid-template-columns:1fr}.ap-process-rail{grid-template-columns:repeat(4,1fr)}.ap-process-action{grid-column:auto}}@media(max-width:640px){.ap-system-panel{border-radius:26px;padding:20px}.ap-process-rail{grid-template-columns:repeat(2,1fr)}.ap-process-dot{min-height:108px;padding:16px 12px}.ap-process-dot span{width:48px;height:48px}.ap-process-dot strong{font-size:13px}.ap-process-stage{min-height:auto;border-radius:28px;padding:26px}.ap-process-stage:before{inset:16px}.ap-process-stage h3{font-size:clamp(38px,13vw,54px)}.ap-process-stage p{font-size:16px}}
  .ap-process-stage{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-areas:"copy copy" "output action" "progress progress";align-content:center;padding:48px 52px 38px}
  .ap-process-stage-copy{grid-area:copy;width:100%;max-width:780px;margin:0 auto}
  .ap-process-stage h3{max-width:100%;overflow-wrap:anywhere;font-size:clamp(40px,4.5vw,60px);line-height:1.04}
  .ap-process-stage p{max-width:760px}
  .ap-process-output{grid-area:output;min-width:0}
  .ap-process-action{grid-area:action;min-width:0}
  .ap-process-progress{grid-area:progress}
  @media(max-width:980px){.ap-process-stage{grid-template-columns:1fr;grid-template-areas:"copy" "output" "action" "progress";padding:40px}.ap-process-stage-copy{max-width:none}}
  @media(max-width:640px){.ap-process-stage{padding:30px 26px 26px}.ap-process-stage h3{font-size:clamp(36px,12vw,50px)}}
  .ap-architecture-live{max-width:1180px;margin-inline:auto;border-radius:28px;padding:14px}.ap-architecture-tabs{gap:6px;margin-bottom:10px}.ap-architecture-tabs button{display:inline-flex;align-items:center;gap:8px;padding:9px 12px;font-size:12px}.ap-architecture-tabs button>span{color:var(--ap-brown);font-family:"Syne",sans-serif;font-size:9px;font-weight:800}.ap-architecture-tabs button.is-active>span{color:#fff}.ap-architecture-map{display:block;border-radius:24px;padding:28px 30px;background:radial-gradient(circle at 86% 18%,rgba(159,56,38,.18),transparent 24%),linear-gradient(135deg,#111,#1b1715)}.ap-arch-main{display:grid;max-width:820px;grid-template-columns:48px minmax(0,1fr);gap:18px;align-items:start;border:0;border-bottom:1px solid rgba(255,255,255,.1);border-radius:0;background:transparent;padding:0 0 25px}.ap-arch-main>span{display:grid;width:48px;height:48px;place-items:center;border-radius:15px;background:#fff;color:var(--ap-brown);font-family:"Syne",sans-serif;font-size:11px;font-weight:800}.ap-arch-main .ap-kicker{color:#e4a092}.ap-arch-main h3{margin-top:7px;font-size:28px;line-height:1.05}.ap-arch-main p{max-width:720px;margin-top:8px;font-size:14px;line-height:1.52}.ap-journey-flow{position:relative;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;margin-top:30px}.ap-journey-line{position:absolute;top:23px;right:24px;left:24px;height:2px;overflow:hidden;background:rgba(255,255,255,.15)}.ap-journey-line span{display:block;width:0;height:100%;background:linear-gradient(90deg,#e4a092,var(--ap-brown));transition:width .35s ease}.ap-journey-stop{position:relative;z-index:1;min-width:0}.ap-journey-stop>span{display:grid;width:46px;height:46px;place-items:center;border:5px solid #171412;border-radius:50%;background:#45413f;color:rgba(255,255,255,.7);font-family:"Syne",sans-serif;font-size:9px;font-weight:800;transition:.25s}.ap-journey-stop.is-active>span{background:var(--ap-brown);color:#fff;box-shadow:0 0 0 5px rgba(159,56,38,.15)}.ap-journey-stop strong,.ap-journey-stop small{display:block}.ap-journey-stop strong{max-width:190px;margin-top:16px;font-size:14px;line-height:1.28}.ap-journey-stop small{max-width:210px;margin-top:7px;color:rgba(255,255,255,.5);font-size:11px;line-height:1.45}.ap-journey-result{display:flex;align-items:baseline;gap:14px;margin-top:28px;border-top:1px solid rgba(255,255,255,.1);padding-top:18px}.ap-journey-result>span{flex:0 0 auto;color:#e4a092;font-family:"Syne",sans-serif;font-size:9px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase}.ap-journey-result strong{color:rgba(255,255,255,.82);font-size:13px;line-height:1.5}.ap-integration-strip{max-width:1180px;margin:18px auto 0}
  @media(max-width:700px){.ap-architecture-live{border-radius:24px;padding:10px}.ap-architecture-tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.ap-architecture-tabs button{justify-content:center}.ap-architecture-map{padding:22px}.ap-arch-main{grid-template-columns:42px minmax(0,1fr);gap:14px}.ap-arch-main>span{width:42px;height:42px}.ap-arch-main h3{font-size:25px}.ap-journey-flow{grid-template-columns:1fr;gap:21px;margin-top:24px}.ap-journey-line{top:22px;right:auto;bottom:22px;left:21px;width:2px;height:auto}.ap-journey-line span{display:none}.ap-journey-stop{display:grid;grid-template-columns:44px minmax(0,1fr);column-gap:14px;align-items:start}.ap-journey-stop>span{grid-row:1/3;width:44px;height:44px}.ap-journey-stop strong{margin-top:2px}.ap-journey-stop small{grid-column:2;margin-top:4px}.ap-journey-result{display:block}.ap-journey-result strong{display:block;margin-top:8px}}
</style>

<style>
  .ap-process-integrations{padding-top:0}.ap-process-integrations details{border-block:1px solid var(--ap-line)}.ap-process-integrations summary{display:flex;align-items:center;justify-content:space-between;padding:20px 2px;cursor:pointer;font-weight:850;list-style:none}.ap-process-integrations summary::-webkit-details-marker{display:none}.ap-process-integrations details>p{max-width:680px;margin:0 0 18px;color:var(--ap-muted);font-size:13px}.ap-process-integrations details>div{display:flex;flex-wrap:wrap;gap:0 22px;padding:0 0 22px}.ap-process-integrations details>div span{border-left:1px solid rgba(159,56,38,.3);padding:5px 0 5px 10px;font-size:12px;font-weight:750}
</style>

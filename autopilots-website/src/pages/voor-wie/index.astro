---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VisualIcon from "../../components/ui/VisualIcon.astro";
import { niches } from "../../data/niches";
const schema={"@context":"https://schema.org","@type":"CollectionPage",name:"AI-medewerkers per branche",description:"Bekijk hoe Autopilots AI-producten worden ingericht voor verschillende branches."};
---
<BaseLayout title="AI-medewerkers per branche | Autopilots" description="Bekijk AI-medewerkers voor autobedrijven, dakdekkers, installateurs, vastgoedbeheerders, zorg, hospitality en andere branches." canonical="/voor-wie/" schema={schema}>
  <article class="ap-ecosystem">
    <nav class="ap-breadcrumb" aria-label="Broodkruimel"><div class="ap-container"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Voor wie</span></div></nav>
    <section class="ap-eco-hero"><div class="ap-container ap-eco-hero-grid"><div class="ap-eco-copy"><div class="ap-kicker">Voor wie</div><h1>AI-producten ingericht op de dagelijkse praktijk van <span class="ap-title-accent">jouw branche.</span></h1><p class="ap-lead">Iedere branche heeft eigen klantvragen, intake, planning, urgentie, systemen en menselijke uitzonderingen. Kies je branche en bekijk de volledige klantreis.</p><div class="ap-actions"><a class="ap-button ap-button-primary" href="#alle-branches">Kies je branche</a><a class="ap-button ap-button-secondary" href="/producten/">Vergelijk producten</a></div></div><aside class="ap-product-visual"><div class="ap-visual-head"><span>21 actieve branches</span><strong>Eigen inrichting</strong></div><div class="ap-visual-route">{["Klantvraag en kanaal","Branchegerichte intake","Planning en uitzonderingen","Actie in het systeem"].map((item,index)=><div class="ap-visual-node"><span>{String(index+1).padStart(2,"0")}</span><div><strong>{item}</strong><small>Geen generieke tekstwissel</small></div></div>)}</div></aside></div></section>
    <section class="ap-section ap-soft-section" id="alle-branches"><div class="ap-container"><div class="ap-section-head"><div class="ap-kicker">Alle branches</div><h2>Open de klantreis die bij je <span class="ap-title-accent">werkdag past.</span></h2></div><div class="ap-branch-overview-grid">{niches.map((niche,index)=><a href={`/voor-wie/${niche.slug}/`}><div class="ap-branch-card-head"><VisualIcon type="niche" name={niche.slug} /><span>{String(index+1).padStart(2,"0")}</span></div><h3>{niche.name}</h3><p>{niche.lead}</p><strong>Bekijk AI voor {niche.name.toLowerCase()}</strong></a>)}</div></div></section>
    <section class="ap-section ap-final-section"><div class="ap-container ap-final-card"><div><div class="ap-kicker">Staat je branche er niet tussen?</div><h2>We brengen eerst je huidige proces in kaart.</h2><p>Daarna bepalen we welk product en welke inrichting aantoonbaar waarde kunnen leveren.</p></div><a class="ap-button ap-button-primary" href="/afspraak/">Bespreek je situatie</a></div></section>
  </article>
</BaseLayout>
<style>
  .ap-branch-overview-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.ap-branch-overview-grid a{display:flex;min-height:280px;flex-direction:column;border:1px solid var(--ap-line);border-radius:26px;background:#fff;padding:23px;box-shadow:0 14px 40px rgba(17,17,17,.04);transition:transform .2s ease,border-color .2s ease}.ap-branch-overview-grid a:hover{transform:translateY(-3px);border-color:rgba(159,56,38,.24)}.ap-branch-card-head{display:flex;align-items:center;justify-content:space-between}.ap-branch-card-head>span{color:var(--ap-brown);font-family:"Syne",sans-serif;font-size:11px;font-weight:700}.ap-branch-overview-grid h3{margin:28px 0 0;font-size:23px}.ap-branch-overview-grid p{margin:12px 0 20px;color:var(--ap-muted);font-size:13px;line-height:1.55}.ap-branch-overview-grid a>strong{margin-top:auto;color:var(--ap-brown);font-size:12px}@media(max-width:820px){.ap-branch-overview-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.ap-branch-overview-grid{grid-template-columns:1fr}.ap-branch-overview-grid a{min-height:240px}}
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VisualIcon from "../../components/ui/VisualIcon.astro";
import { niches } from "../../data/niches";
import type { SupportedLocale } from "../../i18n/languages";
import { localizedPath } from "../../i18n/routes";
import { localizedNiche } from "../../i18n/catalog";
import { uiCopy } from "../../i18n/ui";
interface Props { locale?: SupportedLocale }
const { locale = "nl" } = Astro.props;
const ui=uiCopy[locale];
const copy={
nl:{title:"AI-medewerkers per branche",description:"Bekijk hoe Autopilots AI-producten worden ingericht voor verschillende branches.",label:"Voor wie",heading:"AI-medewerkers ingericht op de praktijk van",accent:"jouw branche.",lead:"Kies je branche. Je ziet direct welke klantvragen, intake en systemen de AI ondersteunt.",choose:"Kies je branche",compare:"Vergelijk producten",active:"actieve branches",own:"Eigen inrichting",route:[["Klantvraag","Ingericht op de werkdag"],["Gerichte intake","Ingericht op de werkdag"],["Planning en uitzonderingen","Ingericht op de werkdag"],["Actie in het systeem","Ingericht op de werkdag"]],all:"Alle branches",open:"Open de klantreis die bij je",day:"werkdag past.",missing:"Staat je branche er niet tussen?",process:"We bekijken eerst je huidige proces.",value:"Daarna bepalen we welk product waarde kan leveren."},
en:{title:"AI employees by industry",description:"See how Autopilots AI products are configured for different industries.",label:"Industries",heading:"AI employees configured around the reality of",accent:"your industry.",lead:"Choose your industry and see which customer questions, intake fields and systems the AI supports.",choose:"Choose your industry",compare:"Compare products",active:"active industries",own:"Dedicated configuration",route:[["Customer question","Built around the working day"],["Focused intake","Built around the working day"],["Planning and exceptions","Built around the working day"],["Action in the system","Built around the working day"]],all:"All industries",open:"Open the customer journey that fits",day:"your working day.",missing:"Is your industry not listed?",process:"We start by reviewing your current process.",value:"Then we determine which product can add value."},
de:{title:"KI-Mitarbeiter nach Branche",description:"Erfahren Sie, wie Autopilots KI-Produkte für verschiedene Branchen konfiguriert.",label:"Branchen",heading:"KI-Mitarbeiter, abgestimmt auf die Praxis",accent:"Ihrer Branche.",lead:"Wählen Sie Ihre Branche und sehen Sie, welche Kundenfragen, Aufnahmefelder und Systeme die KI unterstützt.",choose:"Branche wählen",compare:"Produkte vergleichen",active:"aktive Branchen",own:"Eigene Konfiguration",route:[["Kundenfrage","Für den Arbeitsalltag eingerichtet"],["Gezielte Aufnahme","Für den Arbeitsalltag eingerichtet"],["Planung und Ausnahmen","Für den Arbeitsalltag eingerichtet"],["Aktion im System","Für den Arbeitsalltag eingerichtet"]],all:"Alle Branchen",open:"Öffnen Sie die Customer Journey für",day:"Ihren Arbeitsalltag.",missing:"Ihre Branche ist nicht dabei?",process:"Wir betrachten zuerst Ihren aktuellen Prozess.",value:"Danach bestimmen wir, welches Produkt Mehrwert schafft."},
es:{title:"Empleados de IA por sector",description:"Descubre cómo se configuran los productos de IA de Autopilots para distintos sectores.",label:"Sectores",heading:"Empleados de IA configurados para la realidad de",accent:"tu sector.",lead:"Elige tu sector y descubre qué consultas, campos de toma de datos y sistemas admite la IA.",choose:"Elige tu sector",compare:"Comparar productos",active:"sectores activos",own:"Configuración propia",route:[["Consulta del cliente","Adaptado a la jornada"],["Toma de datos dirigida","Adaptado a la jornada"],["Planificación y excepciones","Adaptado a la jornada"],["Acción en el sistema","Adaptado a la jornada"]],all:"Todos los sectores",open:"Abre el recorrido de cliente que encaja con",day:"tu jornada.",missing:"¿No aparece tu sector?",process:"Primero revisamos tu proceso actual.",value:"Después determinamos qué producto puede aportar valor."},
it:{title:"Collaboratori AI per settore",description:"Scopri come i prodotti AI Autopilots vengono configurati per settori diversi.",label:"Settori",heading:"Collaboratori AI configurati sulla realtà del",accent:"tuo settore.",lead:"Scegli il settore e scopri quali domande, dati di intake e sistemi sono supportati dall'AI.",choose:"Scegli il settore",compare:"Confronta i prodotti",active:"settori attivi",own:"Configurazione dedicata",route:[["Domanda del cliente","Configurato sulla giornata lavorativa"],["Raccolta dati mirata","Configurato sulla giornata lavorativa"],["Pianificazione ed eccezioni","Configurato sulla giornata lavorativa"],["Azione nel sistema","Configurato sulla giornata lavorativa"]],all:"Tutti i settori",open:"Apri il customer journey adatto alla",day:"tua giornata lavorativa.",missing:"Il tuo settore non è presente?",process:"Partiamo dal processo attuale.",value:"Poi determiniamo quale prodotto può creare valore."},
fr:{title:"Collaborateurs IA par secteur",description:"Découvrez comment les produits IA Autopilots sont configurés pour différents secteurs.",label:"Secteurs",heading:"Des collaborateurs IA configurés selon la réalité de",accent:"votre secteur.",lead:"Choisissez votre secteur et découvrez les demandes, données de collecte et systèmes pris en charge par l'IA.",choose:"Choisir votre secteur",compare:"Comparer les produits",active:"secteurs actifs",own:"Configuration dédiée",route:[["Demande client","Configuré selon le quotidien"],["Collecte ciblée","Configuré selon le quotidien"],["Planification et exceptions","Configuré selon le quotidien"],["Action dans le système","Configuré selon le quotidien"]],all:"Tous les secteurs",open:"Ouvrez le parcours client adapté à",day:"votre quotidien.",missing:"Votre secteur n'est pas présent ?",process:"Nous commençons par étudier votre processus actuel.",value:"Nous déterminons ensuite quel produit peut apporter de la valeur."}
}[locale];
const localNiches=niches.map(niche=>({...niche,...localizedNiche(locale,niche.slug,niche.name)}));
const schema={"@context":"https://schema.org","@type":"CollectionPage",name:copy.title,description:copy.description};
---
<BaseLayout title={`${copy.title} | Autopilots`} description={copy.description} canonical={localizedPath("page.niches",locale)} locale={locale} contentId="page.niches" schema={schema}>
  <article class="ap-ecosystem">
    <nav class="ap-breadcrumb" aria-label="Breadcrumb"><div class="ap-container"><a href={localizedPath("page.home",locale)}>Home</a><span aria-hidden="true">/</span><span aria-current="page">{copy.label}</span></div></nav>
    <section class="ap-eco-hero"><div class="ap-container ap-eco-hero-grid"><div class="ap-eco-copy"><div class="ap-kicker">{copy.label}</div><h1>{copy.heading} <span class="ap-title-accent">{copy.accent}</span></h1><p class="ap-lead">{copy.lead}</p><div class="ap-actions"><a class="ap-button ap-button-primary" href="#all-industries">{copy.choose}</a><a class="ap-text-link" href={localizedPath("page.products",locale)}>{copy.compare} →</a></div></div><aside class="ap-product-visual"><div class="ap-visual-head"><span>{niches.length} {copy.active}</span><strong>{copy.own}</strong></div><div class="ap-visual-route">{copy.route.map((item,index)=><div class="ap-visual-node"><span>{String(index+1).padStart(2,"0")}</span><div><strong>{item[0]}</strong><small>{item[1]}</small></div></div>)}</div></aside></div></section>
    <section class="ap-section ap-soft-section" id="all-industries"><div class="ap-container"><div class="ap-section-head"><div class="ap-kicker">{copy.all}</div><h2>{copy.open} <span class="ap-title-accent">{copy.day}</span></h2></div><div class="ap-branch-overview-grid">{localNiches.map((niche,index)=><a href={localizedPath(`niche.${niche.slug}`,locale)}><VisualIcon type="niche" name={niche.slug} size="small" /><div><span>{String(index+1).padStart(2,"0")}</span><h3>{niche.name}</h3><p>{niche.lead}</p></div><strong aria-hidden="true">→</strong></a>)}</div></div></section>
    <section class="ap-section ap-final-section"><div class="ap-container ap-final-card"><div><div class="ap-kicker">{copy.missing}</div><h2>{copy.process}</h2><p>{copy.value}</p></div><a class="ap-button ap-button-primary" href={localizedPath("page.appointment",locale)}>{ui.navigation.appointment}</a></div></section>
  </article>
</BaseLayout>
<style>
  .ap-branch-overview-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-block:1px solid var(--ap-line)}.ap-branch-overview-grid a{display:grid;grid-template-columns:48px minmax(0,1fr) auto;gap:14px;align-items:center;border-bottom:1px solid var(--ap-line);padding:18px 4px;transition:padding .18s ease,color .18s ease}.ap-branch-overview-grid a:nth-child(odd){padding-right:24px}.ap-branch-overview-grid a:nth-child(even){border-left:1px solid var(--ap-line);padding-left:24px}.ap-branch-overview-grid a:hover,.ap-branch-overview-grid a:focus-visible{padding-left:12px;color:var(--ap-brown);outline:none}.ap-branch-overview-grid a>div>span{color:var(--ap-brown);font:700 9px "Syne",sans-serif}.ap-branch-overview-grid h3{margin:4px 0 0;font-size:17px;line-height:1.15}.ap-branch-overview-grid p{display:-webkit-box;overflow:hidden;margin:6px 0 0;color:var(--ap-muted);font-size:11px;line-height:1.4;-webkit-line-clamp:2;-webkit-box-orient:vertical}.ap-branch-overview-grid a>strong{color:var(--ap-brown)}@media(max-width:680px){.ap-branch-overview-grid{grid-template-columns:1fr}.ap-branch-overview-grid a:nth-child(n){border-left:0;padding:16px 2px}.ap-branch-overview-grid a:last-child{border-bottom:0}}
</style>

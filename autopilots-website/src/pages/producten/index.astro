---
import BaseLayout from "../../layouts/BaseLayout.astro";

const products = [
  ["AI Inboxmedewerker", "Eén medewerker voor mail, WhatsApp, chat en DM.", "Vragen worden begrepen, verrijkt en doorgezet naar afspraak, ticket, CRM-taak of menselijke overdracht."],
  ["AI Leadopvolger", "Warme leads blijven bewegen tot er een duidelijke vervolgstap is.", "WhatsApp, SMS, mail en telefonie worden per niche afgestemd op de juiste timing en toon."],
  ["AI Telefoniste", "Altijd opgenomen, altijd netjes gekwalificeerd.", "Inbound, outbound, triage, afspraken, urgentie en CRM-notities in één telefonische route."],
  ["Autopilots CRM", "Je volledige funnel en klantdata in één systeem.", "Leads, afspraken, reviews, pipeline, automatisering en AI-opvolging komen samen."],
  ["Leadsmachine AI", "Van klik naar intake, afspraak en klant.", "Advertentie, landingspagina, kwalificatie, opvolging en conversie worden één commerciële machine."]
];
---

<BaseLayout
  title="Producten | Autopilots AI medewerkers"
  description="Bekijk de Autopilots producten: AI Inboxmedewerker, AI Leadopvolger, AI Telefoniste, Autopilots CRM en Leadsmachine AI."
  canonical="/producten/"
>
  <section class="ap-section">
    <div class="ap-container">
      <div class="ap-kicker">Autopilots producten</div>
      <h1>AI producten die in je proces werken.</h1>
      <p class="ap-lead">Elk product heeft een vaste basis, maar wordt per niche ingericht met eigen klantreis, koppelingen, scripts, AI-brein en systeemacties.</p>
      <div class="ap-services-grid">
        {products.map(([title, headline, text]) => (
          <article class="ap-service-card">
            <h2>{title}</h2>
            <strong>{headline}</strong>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    max-width: 960px;
    font-size: clamp(34px, calc(5vw - 12px), 54px);
    line-height: 1.07;
    font-weight: 900;
  }

  .ap-lead {
    max-width: 790px;
    margin-top: 22px;
    color: var(--ap-muted);
    font-size: 19px;
    line-height: 1.62;
    font-weight: 500;
  }

  .ap-services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 36px;
  }

  .ap-service-card {
    border: 1px solid var(--ap-line);
    border-radius: 30px;
    background: var(--ap-card);
    padding: 28px;
    box-shadow: 0 16px 50px rgba(17, 17, 17, 0.06);
  }

  .ap-service-card h2 {
    font-size: 30px;
    line-height: 1.08;
  }

  .ap-service-card strong {
    display: block;
    margin-top: 12px;
    color: var(--ap-brown);
  }

  .ap-service-card p {
    margin-top: 14px;
    color: var(--ap-muted);
    font-weight: 600;
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .ap-services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

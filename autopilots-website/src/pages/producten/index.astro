---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { products } from "../../data/products";
import { niches } from "../../data/niches";
import VisualIcon from "../../components/ui/VisualIcon.astro";
import type { SupportedLocale } from "../../i18n/languages";
import { localizedPath } from "../../i18n/routes";
import { localizedProductData, productPageCopy, productsOverviewCopy } from "../../i18n/productPage";
interface Props { locale?: SupportedLocale }
const { locale = "nl" } = Astro.props;
const copy = productsOverviewCopy[locale];
const actions = productPageCopy[locale];
const labels = {
  nl:{solves:"Lost dit op",included:"Standaard inbegrepen",result:"Van contact naar actie"},
  en:{solves:"Solves this",included:"Included as standard",result:"From contact to action"},
  de:{solves:"Löst das",included:"Standardmäßig enthalten",result:"Vom Kontakt zur Aktion"},
  es:{solves:"Resuelve esto",included:"Incluido de serie",result:"Del contacto a la acción"},
  it:{solves:"Risolve questo",included:"Incluso di serie",result:"Dal contatto all'azione"},
  fr:{solves:"Résout cela",included:"Inclus en standard",result:"Du contact à l'action"}
}[locale];
const localizedProducts = products.map((product) => localizedProductData(locale, product));
const productPaths = Object.fromEntries(products.map((product) => [product.slug, localizedPath(`product.${product.slug}`, locale)]));
const explorer = copy.problems.map((label,index) => [label, products[index].slug]);
const productsPath = localizedPath("page.products", locale);
const nichesPath = localizedPath("page.niches", locale);
const clientData = JSON.stringify({ products:localizedProducts, productPaths, view:copy.view }).replaceAll("<", "\\u003c");
const schema = { "@context":"https://schema.org", "@type":"CollectionPage", name:copy.kicker, description:copy.description, url:new URL(productsPath, Astro.site ?? Astro.url.origin).toString() };
---

<BaseLayout title={`${copy.title} | Autopilots`} description={copy.description} canonical={productsPath} schema={schema} locale={locale} contentId="page.products">
  <article class="ap-ecosystem ap-products-overview" data-explorer-root>
    <nav class="ap-breadcrumb" aria-label="Breadcrumb"><div class="ap-container"><a href={localizedPath("page.home",locale)}>{actions.home}</a><span aria-hidden="true">/</span><span aria-current="page">{actions.products}</span></div></nav>
    <section class="ap-eco-hero"><div class="ap-container ap-eco-hero-grid"><div class="ap-eco-copy"><div class="ap-kicker">{copy.kicker}</div><h1>{copy.hero}</h1><p class="ap-lead">{copy.lead}</p><div class="ap-actions"><a class="ap-button ap-button-primary" href="#productverkenner">{copy.find}</a><a class="ap-text-link" href={nichesPath}>{copy.choose} →</a></div></div><aside class="ap-product-visual"><div class="ap-visual-head"><span>{copy.journey}</span><strong>{copy.five}</strong></div><div class="ap-visual-route">{copy.route.map((label,index)=><div class="ap-visual-node"><span>{String(index+1).padStart(2,"0")}</span><div><strong>{label}</strong><small>{index===3?copy.result:copy.owner}</small></div></div>)}</div><div class="ap-visual-status"><span></span>{copy.status}</div></aside></div></section>

    <section class="ap-section ap-dark-section" id="productverkenner"><div class="ap-container"><div class="ap-section-head"><div class="ap-kicker">{copy.explorer}</div><h2>{copy.question}</h2><p>{copy.questionText}</p></div><div class="ap-demo-shell"><div class="ap-demo-tabs" role="tablist" aria-label={copy.question}>{explorer.map((item,index)=><button type="button" role="tab" aria-selected={index===0?"true":"false"} tabindex={index===0?0:-1} class:list={[{"is-active":index===0}]} data-explore={item[1]} data-explore-index={index}><span>{String(index+1).padStart(2,"0")}</span><strong>{item[0]}</strong></button>)}</div><div class="ap-demo-panel" role="tabpanel" aria-live="polite"><div class="ap-kicker" data-explore-kicker>{localizedProducts[0].name}</div><h3 data-explore-title>{localizedProducts[0].hero} {localizedProducts[0].accent}</h3><p data-explore-text>{localizedProducts[0].intro}</p><div class="ap-demo-output"><small>{copy.first}</small><strong data-explore-promise>{localizedProducts[0].promise}</strong></div><div class="ap-actions"><a class="ap-button ap-button-primary" data-explore-link href={productPaths[products[0].slug]}>{copy.view} {localizedProducts[0].name}</a></div></div></div></div></section>

    <section class="ap-section"><div class="ap-container"><div class="ap-section-head"><div class="ap-kicker">{copy.all}</div><h2>{copy.roles}</h2></div><div class="ap-overview-product-grid">{localizedProducts.map((product,index)=><a class={`ap-overview-product is-product-${index+1}`} href={productPaths[product.slug]}><div class="ap-product-card-head"><VisualIcon type="product" name={product.slug} /><span>{String(index+1).padStart(2,"0")}</span></div><span>{product.eyebrow}</span><h3>{product.name}</h3><p>{product.promise}</p><div class="ap-overview-scope"><div><small>{labels.solves}</small><strong>{product.problems[0]?.title}</strong></div><div><small>{labels.included}</small><ul>{product.core.slice(0,3).map((item)=><li>{item.title}</li>)}</ul></div></div><div class="ap-overview-link"><span>{labels.result}</span><strong>{copy.viewProduct} →</strong></div></a>)}</div></div></section>

    <section class="ap-section ap-soft-section"><div class="ap-container"><div class="ap-section-head"><div class="ap-kicker">{copy.together}</div><h2>{copy.togetherTitle}</h2><p>{copy.togetherText}</p></div><div class="ap-collaboration-system"><div class="ap-collaboration-top"><span>{copy.signal}</span><strong>{copy.system}</strong></div><div class="ap-collaboration-flow" aria-label={copy.together}><div class="ap-collaboration-line" aria-hidden="true"></div><article><div class="ap-collaboration-icons"><VisualIcon type="product" name="leadsmachine-ai" /></div><span>01 · {copy.flow[0][0]}</span><h3>{localizedProducts[4].name}</h3><p>{copy.flow[0][1]}</p></article><article><div class="ap-collaboration-icons"><VisualIcon type="product" name="ai-inboxmedewerker" /><VisualIcon type="product" name="ai-telefoniste" /></div><span>02 · {copy.flow[1][0]}</span><h3>{localizedProducts[0].shortName} + {localizedProducts[2].shortName}</h3><p>{copy.flow[1][1]}</p></article><article><div class="ap-collaboration-icons"><VisualIcon type="product" name="ai-leadopvolger" /></div><span>03 · {copy.flow[2][0]}</span><h3>{localizedProducts[1].name}</h3><p>{copy.flow[2][1]}</p></article><article class="is-result"><div class="ap-collaboration-result-icon"><span></span>✓</div><span>04 · {copy.flow[3][0]}</span><h3>{copy.result}</h3><p>{copy.flow[3][1]}</p></article></div><div class="ap-crm-backbone"><div class="ap-crm-identity"><VisualIcon type="product" name="autopilots-crm" /><div><span>{copy.layer}</span><strong>{copy.crm}</strong></div></div><p>{copy.crmText}</p><div class="ap-crm-data" aria-label={copy.crm}>{copy.data.map((item,index)=><><span>{item}</span>{index < copy.data.length-1 && <i></i>}</>)}</div></div></div></div></section>

    <section class="ap-section"><div class="ap-container ap-branch-router"><div><div class="ap-kicker">{copy.choose}</div><h2>{copy.branchTitle}</h2><p>{copy.branchText}</p></div><a class="ap-button ap-button-secondary" href={nichesPath}>{copy.allBranches}</a></div></section>

    <section class="ap-section ap-final-section"><div class="ap-container ap-final-card"><div><div class="ap-kicker">{copy.next}</div><h2>{copy.nextTitle}</h2><p>{copy.nextText}</p></div><div class="ap-actions"><a class="ap-button ap-button-primary" data-ap-event="appointment_cta_clicked" href={localizedPath("page.appointment",locale)}>{actions.appointment}</a><a class="ap-text-link" data-ap-event="direct_order_clicked" href={localizedPath("page.order",locale)}>{actions.order} →</a></div></div></section>
  </article>
  <script id="ap-products-data" type="application/json" set:html={clientData}></script>
</BaseLayout>

<script is:inline>
  (()=>{const root=document.querySelector("[data-explorer-root]");const node=document.getElementById("ap-products-data");if(!root||!node)return;const data=JSON.parse(node.textContent||"{}");const products=data.products||[];const buttons=[...root.querySelectorAll("[data-explore]")];const show=button=>{const product=products.find(item=>item.slug===button.dataset.explore)||products[0];buttons.forEach(item=>{const active=item===button;item.classList.toggle("is-active",active);item.setAttribute("aria-selected",String(active));item.tabIndex=active?0:-1});const set=(selector,value)=>{const item=root.querySelector(selector);if(item)item.textContent=value};set("[data-explore-kicker]",product.name);set("[data-explore-title]",`${product.hero} ${product.accent}`);set("[data-explore-text]",product.intro);set("[data-explore-promise]",product.promise);const link=root.querySelector("[data-explore-link]");if(link){link.href=data.productPaths[product.slug];link.textContent=`${data.view} ${product.name}`}};buttons.forEach(button=>{button.addEventListener("click",()=>show(button));button.addEventListener("keydown",event=>{if(!["ArrowRight","ArrowDown","ArrowLeft","ArrowUp","Home","End"].includes(event.key))return;event.preventDefault();const current=Number(button.dataset.exploreIndex||0);const last=buttons.length-1;const next=event.key==="Home"?0:event.key==="End"?last:["ArrowRight","ArrowDown"].includes(event.key)?(current+1)%(last+1):(current-1+last+1)%(last+1);show(buttons[next]);buttons[next].focus({preventScroll:true})})})})();
</script>

<style>
  .ap-overview-product-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:16px}
  .ap-overview-product{position:relative;display:flex;grid-column:span 4;min-height:520px;overflow:hidden;flex-direction:column;border:1px solid rgba(8,35,60,.13);border-radius:28px;background:linear-gradient(155deg,#fff,#f4f7f9);padding:26px;color:var(--ap-text);box-shadow:0 18px 50px rgba(8,35,60,.05);transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease}
  .ap-overview-product:after{content:"";position:absolute;right:-85px;bottom:-100px;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,rgba(159,56,38,.13),transparent 68%)}
  .ap-overview-product:nth-child(2),.ap-overview-product:nth-child(4){background:linear-gradient(155deg,#fff,#f4f7f9);color:var(--ap-text)}
  .ap-overview-product:nth-child(4),.ap-overview-product:nth-child(5){grid-column:span 6;min-height:460px}
  .ap-overview-product>*{position:relative;z-index:1}
  .ap-overview-product:hover{transform:translateY(-3px);border-color:rgba(159,56,38,.28);box-shadow:0 18px 44px rgba(17,17,17,.06)}
  .ap-product-card-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px}
  .ap-product-card-head>span{color:var(--ap-brown);font-family:"Syne",sans-serif;font-size:11px;font-weight:700}
  .ap-overview-product>span{color:var(--ap-brown);font-family:"Syne",sans-serif;font-size:9px;font-weight:700;letter-spacing:1.3px;text-transform:uppercase}
  .ap-overview-product:nth-child(2) .ap-product-card-head>span,.ap-overview-product:nth-child(4) .ap-product-card-head>span,.ap-overview-product:nth-child(2)>span,.ap-overview-product:nth-child(4)>span{color:var(--ap-brown)}
  .ap-overview-product h3{max-width:360px;margin:13px 0 0;font-size:26px;line-height:1.08}
  .ap-overview-product:nth-child(4) h3,.ap-overview-product:nth-child(5) h3{font-size:29px}
  .ap-overview-product p{max-width:460px;margin:13px 0 0;color:var(--ap-muted);font-size:14px;line-height:1.55}.ap-overview-product:nth-child(2) p,.ap-overview-product:nth-child(4) p{color:var(--ap-muted)}
  .ap-overview-scope{display:grid;gap:14px;margin-top:24px;border-top:1px solid rgba(8,35,60,.12);padding-top:20px}.ap-overview-product:nth-child(2) .ap-overview-scope,.ap-overview-product:nth-child(4) .ap-overview-scope{border-color:rgba(8,35,60,.12)}.ap-overview-scope small,.ap-overview-link>span{display:block;color:#315068;font:700 8px/1.2 "Syne",sans-serif;letter-spacing:1.1px;text-transform:uppercase}.ap-overview-product:nth-child(2) small,.ap-overview-product:nth-child(4) small,.ap-overview-product:nth-child(2) .ap-overview-link>span,.ap-overview-product:nth-child(4) .ap-overview-link>span{color:#315068}.ap-overview-scope strong{display:block;margin-top:7px;font-size:11px;line-height:1.4}.ap-overview-scope ul{display:flex;flex-wrap:wrap;gap:6px;margin:9px 0 0;padding:0;list-style:none}.ap-overview-scope li{border:1px solid rgba(8,35,60,.12);border-radius:999px;background:rgba(255,255,255,.6);padding:7px 9px;font-size:9px;font-weight:750}.ap-overview-product:nth-child(2) li,.ap-overview-product:nth-child(4) li{border-color:rgba(8,35,60,.12);background:rgba(255,255,255,.6)}
  .ap-overview-link{display:flex;align-items:end;justify-content:space-between;gap:18px;margin-top:auto;padding-top:24px}.ap-overview-link>strong{color:var(--ap-brown);font-size:12px}.ap-overview-product:nth-child(2) .ap-overview-link>strong,.ap-overview-product:nth-child(4) .ap-overview-link>strong{color:var(--ap-brown)}
  .ap-collaboration-system{position:relative;overflow:hidden;border-radius:36px;background:radial-gradient(circle at 88% 8%,rgba(159,56,38,.28),transparent 27%),linear-gradient(145deg,#111,#1c1715);color:#fff;padding:34px;box-shadow:0 28px 80px rgba(17,17,17,.14)}.ap-collaboration-system:after{content:"";position:absolute;right:-100px;bottom:-120px;width:320px;height:320px;border:1px solid rgba(231,162,149,.14);border-radius:50%}.ap-collaboration-system>*{position:relative;z-index:1}.ap-collaboration-top{display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid rgba(255,255,255,.11);padding-bottom:20px}.ap-collaboration-top>span{color:#e7a295;font-family:"Syne",sans-serif;font-size:10px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase}.ap-collaboration-top>strong{color:rgba(255,255,255,.62);font-size:12px}.ap-collaboration-flow{position:relative;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:26px;padding:34px 0 32px}.ap-collaboration-line{position:absolute;top:65px;right:8%;left:8%;height:1px;background:linear-gradient(90deg,rgba(231,162,149,.2),rgba(231,162,149,.7),rgba(231,162,149,.2))}.ap-collaboration-flow article{position:relative;z-index:1;min-width:0}.ap-collaboration-icons{display:flex;min-height:62px;align-items:center}.ap-collaboration-icons :global(.ap-visual-icon){border:5px solid #171412}.ap-collaboration-icons :global(.ap-visual-icon)+:global(.ap-visual-icon){margin-left:-15px}.ap-collaboration-flow article>span{display:block;margin-top:20px;color:#e7a295;font-family:"Syne",sans-serif;font-size:9px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase}.ap-collaboration-flow h3{margin-top:10px;font-size:21px;line-height:1.12}.ap-collaboration-flow p{max-width:250px;margin-top:10px;color:rgba(255,255,255,.6);font-size:12px;line-height:1.55}.ap-collaboration-result-icon{position:relative;display:grid;width:58px;height:58px;place-items:center;border:5px solid #171412;border-radius:50%;background:var(--ap-brown);font-family:"Syne",sans-serif;font-size:18px;font-weight:800}.ap-collaboration-result-icon>span{position:absolute;width:78px;height:78px;border:1px solid rgba(231,162,149,.24);border-radius:50%}.ap-crm-backbone{display:grid;grid-template-columns:minmax(300px,.85fr) minmax(260px,1.15fr);gap:20px 34px;align-items:center;border-top:1px solid rgba(255,255,255,.11);padding-top:25px}.ap-crm-identity{display:flex;align-items:center;gap:15px}.ap-crm-identity span,.ap-crm-identity strong{display:block}.ap-crm-identity span{color:#e7a295;font-family:"Syne",sans-serif;font-size:9px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase}.ap-crm-identity strong{margin-top:6px;font-size:16px;line-height:1.25}.ap-crm-backbone>p{margin:0;color:rgba(255,255,255,.62);font-size:12px;line-height:1.55}.ap-crm-data{grid-column:1/-1;display:flex;align-items:center;color:rgba(255,255,255,.58);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.8px}.ap-crm-data i{height:1px;flex:1;margin:0 12px;background:linear-gradient(90deg,rgba(231,162,149,.18),rgba(231,162,149,.58))}
  .ap-demo-panel .ap-kicker{color:var(--ap-brown)}.ap-branch-router{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:40px;align-items:end;border-block:1px solid var(--ap-line);padding:40px 0}.ap-branch-router h2{max-width:760px;font-size:clamp(30px,4vw,50px);line-height:1.04}.ap-branch-router p{max-width:700px;margin:16px 0 0;color:var(--ap-muted);line-height:1.6}
  @media(max-width:980px){.ap-overview-product{grid-column:span 6}.ap-overview-product:nth-child(4){grid-column:span 6}.ap-overview-product:nth-child(5){grid-column:1/-1;min-height:330px}}
  @media(max-width:820px){.ap-branch-link-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:820px){.ap-collaboration-flow{grid-template-columns:repeat(2,minmax(0,1fr))}.ap-collaboration-line{display:none}.ap-crm-backbone{grid-template-columns:1fr}.ap-crm-data{grid-column:auto}}
  @media(max-width:640px){.ap-overview-product-grid{grid-template-columns:1fr}.ap-overview-product,.ap-overview-product:nth-child(4),.ap-overview-product:nth-child(5){grid-column:1;min-height:470px;padding:24px}.ap-overview-product h3,.ap-overview-product:nth-child(4) h3,.ap-overview-product:nth-child(5) h3{font-size:24px}.ap-collaboration-system{border-radius:28px;padding:24px}.ap-collaboration-top{align-items:flex-start;flex-direction:column}.ap-collaboration-flow{grid-template-columns:1fr;gap:28px}.ap-collaboration-flow article{display:grid;grid-template-columns:70px minmax(0,1fr);column-gap:14px}.ap-collaboration-icons,.ap-collaboration-result-icon{grid-row:1/4}.ap-collaboration-flow article>span,.ap-collaboration-flow h3,.ap-collaboration-flow p{grid-column:2}.ap-collaboration-flow article>span{margin-top:2px}.ap-collaboration-flow h3{margin-top:7px}.ap-collaboration-flow p{max-width:none;margin-top:7px}.ap-crm-data{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.ap-crm-data i{display:none}.ap-crm-data span{border-left:1px solid rgba(231,162,149,.35);padding-left:9px}.ap-branch-router{grid-template-columns:1fr;align-items:start}}
</style>

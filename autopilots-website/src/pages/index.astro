---
import "../styles/global.css";
import { supportedLocales } from "../i18n/languages";
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#071b2e"/><title>Autopilots — Choose your language</title><meta name="description" content="Choose your language to explore Autopilots AI employees for customer contact."/><link rel="canonical" href={new URL("/",Astro.site??Astro.url.origin).toString()}/><link rel="alternate" hreflang="nl-NL" href={new URL("/nl/",Astro.site??Astro.url.origin).toString()}/><link rel="alternate" hreflang="x-default" href={new URL("/",Astro.site??Astro.url.origin).toString()}/></head>
<body><main><a class="logo" href="/">AUTOPILOTS</a><section><div class="eyebrow">International</div><h1>AI employees.<br/><em>Built for action.</em></h1><p>Select your language. We will remember your choice without redirecting you automatically.</p><nav aria-label="Choose your language">{supportedLocales.map(locale=><a href={locale.path} hreflang={locale.tag} lang={locale.tag} data-language-choice={locale.code}><span>{locale.name}</span><small>{locale.market}</small><b>→</b></a>)}</nav></section><footer>Autopilots. For the companies of the future.</footer></main><script is:inline>document.addEventListener("click",e=>{const a=e.target.closest("[data-language-choice]");if(a)try{localStorage.setItem("autopilots_locale",a.dataset.languageChoice)}catch{}})</script></body></html>
<style>
  *{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 88% 108%,rgba(159,56,38,.56),transparent 40%),linear-gradient(145deg,#123e61 0%,#0a2943 35%,#071b2e 75%,#061522 100%);color:#fff;font-family:Inter,Arial,sans-serif}main{display:grid;min-height:100vh;grid-template-rows:auto 1fr auto;width:min(1240px,calc(100% - 40px));margin:auto;padding:34px 0}.logo{color:#fff;font-family:Syne,Arial,sans-serif;font-size:13px;font-weight:800;letter-spacing:2.4px;text-decoration:none}section{align-self:center;padding:60px 0}.eyebrow{color:#e4a092;font-family:Syne,Arial,sans-serif;font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase}h1{max-width:900px;margin:22px 0 0;font-family:Syne,Arial,sans-serif;font-size:clamp(52px,8vw,110px);line-height:.88;letter-spacing:-.055em}h1 em{color:#c7563e;font-family:Georgia,serif;font-weight:700}p{max-width:620px;margin:30px 0 0;color:rgba(255,255,255,.62);font-size:16px;line-height:1.6}nav{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;max-width:950px;margin-top:44px}nav a{display:grid;grid-template-columns:1fr auto;min-height:94px;align-content:center;border:1px solid rgba(255,255,255,.13);border-radius:22px;background:rgba(255,255,255,.055);padding:20px 22px;color:#fff;text-decoration:none;transition:.2s ease}nav a:hover,nav a:focus-visible{transform:translateY(-3px);border-color:rgba(228,160,146,.45);background:rgba(255,255,255,.1);outline:none}nav span{font-family:Syne,Arial,sans-serif;font-size:17px;font-weight:800}nav small{grid-row:2;color:rgba(255,255,255,.48);font-size:11px;margin-top:6px}nav b{grid-column:2;grid-row:1/3;align-self:center;color:#e4a092}footer{color:rgba(255,255,255,.4);font-size:11px}@media(max-width:720px){nav{grid-template-columns:1fr}section{padding:50px 0}h1{font-size:52px}}
</style>

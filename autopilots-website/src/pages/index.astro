---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import { products } from "../data/products";
import { niches } from "../data/niches";
---

<BaseLayout
  title="Autopilots | AI medewerkers voor klantcontact en operatie"
  description="Autopilots bouwt AI medewerkers die klantcontact afhandelen, afspraken plannen, supportvragen voorbereiden en CRM-processen slimmer maken."
>
  <Hero
    eyebrow="Autopilots"
    title="AI-medewerkers die klantcontact omzetten naar"
    accent="een concrete actie."
    text="Autopilots bouwt vijf AI-producten voor inbox, leadopvolging, telefonie, CRM en acquisitie. Ze beantwoorden, vragen door, plannen, dragen over en leggen de uitkomst vast in je systemen."
    primaryLabel="Plan een afspraak"
    primaryHref="/afspraak/"
    secondaryLabel="Bestel direct"
    secondaryHref="/bestel-direct/"
    chips={["AI Inboxmedewerker", "AI Leadopvolger", "AI Telefoniste", "Autopilots CRM", "Leadsmachine AI"]}
  />

  <section class="ap-section" id="producten">
    <div class="ap-container">
      <div class="ap-section-head">
        <div class="ap-kicker">Producten</div>
        <h2 class="ap-section-title">Eén systeem voor alle momenten waarop klantcontact werk vraagt.</h2>
        <p class="ap-text">Vijf gestandaardiseerde AI-producten nemen een duidelijke rol over en worden ingericht op jullie branche, systemen, uitzonderingen en menselijke overdracht.</p>
      </div>
      <div class="ap-grid-3">
        {products.map((product) => (
          <a class="ap-card" href={`/producten/${product.slug}/`}>
            <h3 class="ap-card-title">{product.name}</h3>
            <p class="ap-text">{product.promise}</p>
            <strong>Bekijk {product.name}</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="ap-section" id="klantenmachine">
    <div class="ap-container">
      <div class="ap-dark-band">
        <div class="ap-kicker">Producten werken samen</div>
        <h2 class="ap-section-title">Van eerste vraag naar juiste actie, zonder gaten in je proces.</h2>
        <p class="ap-text">Inboxmedewerker, Telefoniste en Leadopvolger voeren het klantcontact uit. Autopilots CRM bewaart de context. Leadsmachine AI verbindt acquisitie met die route.</p>
        <div class="ap-grid-3 ap-dark-grid">
          <div>
            <span class="ap-step-number">01</span>
            <h3>Instroom</h3>
            <p>Nieuwe leads, klanten, telefoontjes, formulieren, supportvragen en afspraken.</p>
          </div>
          <div>
            <span class="ap-step-number">02</span>
            <h3>AI afhandeling</h3>
            <p>De AI begrijpt de vraag, stelt vervolgvragen en kiest de juiste route.</p>
          </div>
          <div>
            <span class="ap-step-number">03</span>
            <h3>Overdracht</h3>
            <p>Afspraken, tickets, taken en pipeline updates komen netjes bij het team.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="ap-section" id="branches">
    <div class="ap-container">
      <div class="ap-section-head">
        <div class="ap-kicker">Branches</div>
        <h2 class="ap-section-title">Een eigen klantreis voor de dagelijkse praktijk van iedere branche.</h2>
        <p class="ap-text">Elke branchepagina gebruikt herkenbare vragen, intakevelden, planning, systemen, uitzonderingen en een passende productvolgorde.</p>
      </div>
      <div class="ap-niche-grid">
        {niches.map((niche) => (
          <a class="ap-niche-link" href={`/voor-wie/${niche.slug}/`}>
            <span>{niche.name}</span>
            <strong>Bekijk route</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="ap-section" id="proces">
    <div class="ap-container">
      <div class="ap-section-head">
        <div class="ap-kicker">Implementatie</div>
        <h2 class="ap-section-title">We bouwen geen demo. We bouwen een proces dat live kan.</h2>
      </div>
      <div class="ap-accordion">
        <details open>
          <summary>Ontwerp en inrichting</summary>
          <p>We vertalen jullie werkwijze naar gesprekslogica, tone of voice, uitzonderingen, overdracht en technische inrichting.</p>
        </details>
        <details>
          <summary>Bouw en testen</summary>
          <p>We bouwen de AI medewerker, richten koppelingen in en testen belangrijke scenario's voordat de flow live gaat.</p>
        </details>
        <details>
          <summary>Review en livegang</summary>
          <p>We lopen alles samen door, verwerken feedback en zetten de agent klaar voor livegang.</p>
        </details>
        <details>
          <summary>Monitoring en optimalisatie</summary>
          <p>Na livegang sturen we bij op echte gesprekken, conversiepunten en CRM-data.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="ap-section">
    <div class="ap-container">
      <div class="ap-final-cta">
        <div>
          <div class="ap-kicker">Volgende stap</div>
          <h2 class="ap-section-title">Kies advies of start met een bevestigde productroute.</h2>
          <p class="ap-text">Plan een gesprek als product, scope of koppelingen nog niet duidelijk zijn. Via bestellen zie je alleen configuraties waarvan prijs en route zijn bevestigd.</p>
        </div>
        <div class="ap-actions"><a class="ap-button ap-button-primary" data-ap-event="appointment_cta_clicked" href="/afspraak/">Plan een afspraak</a><a class="ap-button ap-button-secondary" data-ap-event="direct_order_clicked" href="/bestel-direct/">Bestel direct</a></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ap-card .ap-text {
    margin-top: 12px;
  }

  .ap-dark-grid {
    margin-top: 34px;
  }

  .ap-dark-grid > div {
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.08);
    padding: 22px;
  }

  .ap-step-number {
    display: inline-flex;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    background: var(--ap-white);
    color: var(--ap-brown);
    font-weight: 700;
  }

  .ap-dark-grid h3 {
    margin-top: 18px;
    font-size: 20px;
    line-height: 1.15;
    font-weight: 900;
  }

  .ap-dark-grid p {
    margin-top: 10px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 14px;
    line-height: 1.58;
    font-weight: 600;
  }

  .ap-niche-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .ap-niche-link {
    display: flex;
    min-height: 112px;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid var(--ap-line);
    border-radius: 24px;
    background: var(--ap-card);
    padding: 18px;
    box-shadow: 0 16px 40px rgba(17, 17, 17, 0.045);
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .ap-niche-link:hover {
    transform: translateY(-2px);
    border-color: rgba(159, 56, 38, 0.28);
    background: #fffaf8;
  }

  .ap-niche-link span {
    font-size: 17px;
    line-height: 1.2;
    font-weight: 900;
  }

  .ap-niche-link strong {
    color: var(--ap-brown);
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ap-final-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: end;
    border: 1px solid var(--ap-line);
    border-radius: 34px;
    background: var(--ap-card);
    padding: 42px;
    box-shadow: 0 16px 50px rgba(17, 17, 17, 0.065);
  }

  @media (max-width: 900px) {
    .ap-niche-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ap-final-cta {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .ap-niche-grid {
      grid-template-columns: 1fr;
    }

    .ap-final-cta {
      padding: 24px;
      border-radius: 26px;
    }
  }
</style>

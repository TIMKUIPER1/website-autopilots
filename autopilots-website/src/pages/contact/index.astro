---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/sections/Hero.astro";
import GhlEmbed from "../../components/embeds/GhlEmbed.astro";
import { publicRuntime } from "../../config/publicRuntime";
import type { SupportedLocale } from "../../i18n/languages";
import { localizedPath } from "../../i18n/routes";
import { contactCopy } from "../../i18n/conversionPage";
interface Props { locale?: SupportedLocale }
const { locale = "nl" } = Astro.props;
const copy = contactCopy[locale];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonical={localizedPath("page.contact",locale)}
  locale={locale}
  contentId="page.contact"
>
  <Hero
    eyebrow={copy.kicker}
    title={copy.hero}
    accent={copy.accent}
    text={copy.lead}
    primaryLabel={copy.appointment}
    primaryHref="#calendar"
    secondaryLabel={copy.products}
    secondaryHref={localizedPath("page.products",locale)}
    chips={[...copy.chips]}
    locale={locale}
  />

  <section class="ap-section" id="calendar">
    <div class="ap-container">
      <div class="ap-section-head">
        <div class="ap-kicker">{copy.plan}</div>
        <h2 class="ap-section-title">{copy.calendarTitle}</h2>
        <p class="ap-text">{copy.calendarText}</p>
      </div>
      <GhlEmbed
        src={publicRuntime.ghlCalendarUrl}
        title={copy.calendar}
        id="autopilots-contact-calendar"
        locale={locale}
      />
    </div>
  </section>
</BaseLayout>

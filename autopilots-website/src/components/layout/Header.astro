---
import { products } from "../../data/products";
import { niches } from "../../data/niches";
import VisualIcon from "../ui/VisualIcon.astro";

const popularNiches = niches.slice(0, 8);
---

<header class="ap-header">
  <div class="ap-container ap-header-inner">
    <a class="ap-logo" href="/" aria-label="Autopilots home">AUTOPILOTS</a>
    <button class="ap-mobile-toggle" type="button" aria-expanded="false" aria-controls="ap-main-nav" data-mobile-toggle><span></span><span></span><span></span><strong>Menu</strong></button>
    <nav class="ap-nav" id="ap-main-nav" aria-label="Hoofdnavigatie" data-main-nav>
      <div class="ap-menu-shell">
        <a class="ap-menu-trigger" href="/producten/" aria-haspopup="true">Producten</a>
        <div class="ap-mega" aria-label="Producten megamenu">
          <div class="ap-mega-feature">
            <div><div class="ap-menu-label">Autopilots producten</div><h3>Vijf AI-producten voor klantcontact en groei.</h3><p>Een vaste productbasis, ingericht op de processen en systemen van je branche.</p></div>
            <a class="ap-button ap-button-primary" href="/producten/">Vergelijk de vijf producten</a>
          </div>
          <div class="ap-mega-grid">
            {products.map((product) => <a class="ap-mega-link" href={`/producten/${product.slug}/`}><VisualIcon type="product" name={product.slug} size="small" /><div><strong>{product.name}</strong><span>{product.promise}</span></div></a>)}
          </div>
        </div>
      </div>
      <div class="ap-menu-shell">
        <a class="ap-menu-trigger" href="/voor-wie/" aria-haspopup="true">Voor wie</a>
        <div class="ap-mega" aria-label="Voor wie megamenu">
          <div class="ap-mega-feature">
            <div><div class="ap-menu-label">Voor wie</div><h3>Een eigen klantreis voor iedere branche.</h3><p>Vragen, intake, planning, systemen en menselijke fallback sluiten aan op de praktijk.</p></div>
            <a class="ap-button ap-button-primary" href="/voor-wie/">Bekijk alle branches</a>
          </div>
          <div class="ap-mega-grid">
            {popularNiches.map((niche) => <a class="ap-mega-link" href={`/voor-wie/${niche.slug}/`}><VisualIcon type="niche" name={niche.slug} size="small" /><div><strong>{niche.name}</strong><span>{niche.lead}</span></div></a>)}
          </div>
        </div>
      </div>
      <a href="/proces/">Proces</a><a href="/kennisbank/">Kennisbank</a><a href="/crew/">Crew</a><a class="ap-nav-mobile-only" href="/afspraak/">Plan afspraak</a><a class="ap-nav-mobile-only" href="/bestel-direct/">Bestel direct</a>
    </nav>
    <div class="ap-header-actions"><a class="ap-button ap-button-primary ap-header-cta" href="/afspraak/">Plan afspraak</a><a class="ap-button ap-button-secondary ap-header-cta" href="/bestel-direct/">Bestel direct</a></div>
  </div>
</header>

<style>
  .ap-header{position:sticky;top:0;z-index:40;border-bottom:1px solid rgba(0,0,0,.08);background:rgba(245,245,242,.9);backdrop-filter:blur(16px)}
  .ap-header-inner{position:relative;display:flex;min-height:74px;align-items:center;justify-content:space-between;gap:18px}.ap-logo{font-family:"Syne",sans-serif;font-size:13px;font-weight:700;letter-spacing:2px}
  .ap-nav{display:flex;align-items:center;gap:8px;border:1px solid var(--ap-line);border-radius:999px;background:rgba(255,255,255,.76);padding:6px}.ap-nav>a,.ap-menu-trigger{display:inline-flex;align-items:center;border:0;border-radius:999px;padding:10px 12px;color:var(--ap-muted);font-size:13px;font-weight:850;transition:background .18s ease,color .18s ease}.ap-nav>a:hover,.ap-nav>a:focus-visible,.ap-nav>a[aria-current="page"],.ap-menu-shell:hover .ap-menu-trigger,.ap-menu-trigger:focus-visible,.ap-menu-trigger[aria-current="page"]{background:var(--ap-soft-2);color:var(--ap-text);outline:none}.ap-nav .ap-nav-mobile-only{display:none}
  .ap-menu-shell{position:relative}.ap-mega{position:fixed;top:88px;left:50vw;width:min(1120px,calc(100vw - 36px));display:grid;grid-template-columns:minmax(360px,.8fr) minmax(0,1.2fr);gap:16px;transform:translateX(-50%) translateY(8px);border:1px solid var(--ap-line);border-radius:30px;background:rgba(255,255,255,.98);box-shadow:0 24px 70px rgba(17,17,17,.14);padding:16px;opacity:0;pointer-events:none;transition:opacity .16s ease,transform .16s ease}.ap-menu-shell:hover .ap-mega,.ap-menu-shell:focus-within .ap-mega{opacity:1;pointer-events:auto;transform:translateX(-50%) translateY(0)}
  .ap-mega-feature{position:relative;overflow:hidden;min-height:280px;display:flex;flex-direction:column;justify-content:space-between;border-radius:24px;background:#111;color:#fff;padding:25px}.ap-mega-feature:after{content:"";position:absolute;right:-75px;bottom:-85px;width:220px;height:220px;border-radius:50%;background:rgba(159,56,38,.34);filter:blur(22px)}.ap-mega-feature>*{position:relative;z-index:1}.ap-menu-label{color:#e4a092;font-family:"Syne",sans-serif;font-size:10px;font-weight:700;letter-spacing:1.7px;text-transform:uppercase}.ap-mega-feature h3{margin:12px 0 0;font-size:28px;line-height:1.06}.ap-mega-feature p{margin:12px 0 0;color:rgba(255,255,255,.68);font-size:13px;line-height:1.5}.ap-mega-feature .ap-button{align-self:flex-start}
  .ap-mega-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.ap-mega-link{display:grid;grid-template-columns:40px minmax(0,1fr);gap:10px;align-items:center;border:1px solid transparent;border-radius:17px;padding:10px;transition:background .16s ease,border-color .16s ease}.ap-mega-link:hover,.ap-mega-link:focus-visible{border-color:var(--ap-line);background:var(--ap-soft-2);outline:none}.ap-mega-icon{display:grid;width:40px;height:40px;place-items:center;border-radius:14px;background:#111;color:#fff;font-family:"Syne",sans-serif;font-size:10px;font-weight:700}.ap-mega-link strong,.ap-mega-link span{display:block}.ap-mega-link strong{font-size:13px;line-height:1.1}.ap-mega-link div>span{display:-webkit-box;overflow:hidden;margin-top:4px;color:var(--ap-muted);font-size:10px;line-height:1.25;-webkit-line-clamp:2;-webkit-box-orient:vertical}
  .ap-header-actions{display:flex;align-items:center;gap:8px;white-space:nowrap}.ap-header-cta{min-height:42px;padding:12px 17px;font-size:13px}.ap-mobile-toggle{display:none;border:0;background:transparent;color:#111;cursor:pointer}.ap-mobile-toggle span{display:block;width:21px;height:2px;border-radius:2px;background:currentColor}.ap-mobile-toggle strong{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  @media(max-width:920px){.ap-mega{display:none}}
  @media(max-width:820px){.ap-header-inner{padding:11px 0}.ap-mobile-toggle{display:inline-flex;min-width:44px;min-height:44px;flex-direction:column;align-items:center;justify-content:center;gap:4px;margin-left:auto;border-radius:14px}.ap-mobile-toggle:hover,.ap-mobile-toggle:focus-visible{background:#fff;outline:2px solid rgba(159,56,38,.28);outline-offset:2px}.ap-nav{position:absolute;inset:calc(100% + 1px) 0 auto;display:none;flex-direction:column;align-items:stretch;border-radius:22px;background:#fff;box-shadow:0 24px 70px rgba(17,17,17,.15);padding:9px}.ap-nav.is-open{display:flex}.ap-nav>a,.ap-menu-trigger{width:100%;justify-content:flex-start;padding:13px 14px}.ap-nav .ap-nav-mobile-only{display:inline-flex;background:#111;color:#fff}.ap-header-actions{display:none}}
</style>

<script is:inline>
  (()=>{const toggle=document.querySelector("[data-mobile-toggle]");const nav=document.querySelector("[data-main-nav]");if(!toggle||!nav)return;const close=()=>{nav.classList.remove("is-open");toggle.setAttribute("aria-expanded","false");document.body.classList.remove("ap-menu-open")};const setOpen=open=>{nav.classList.toggle("is-open",open);toggle.setAttribute("aria-expanded",String(open));document.body.classList.toggle("ap-menu-open",open&&innerWidth<=820)};toggle.addEventListener("click",()=>setOpen(!nav.classList.contains("is-open")));nav.addEventListener("click",event=>{if(event.target.closest("a")&&innerWidth<=820)close()});document.addEventListener("keydown",event=>{if(event.key==="Escape"&&nav.classList.contains("is-open")){close();toggle.focus()}});document.addEventListener("click",event=>{if(innerWidth<=820&&nav.classList.contains("is-open")&&!event.target.closest(".ap-header"))close()});addEventListener("resize",()=>{if(innerWidth>820)close()});const path=location.pathname;nav.querySelectorAll("a[href]").forEach(link=>{const href=new URL(link.href).pathname;if(href!=="/"&&path.startsWith(href))link.setAttribute("aria-current","page")})})();
</script>

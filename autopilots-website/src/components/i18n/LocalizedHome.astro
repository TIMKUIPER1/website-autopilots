---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../sections/Hero.astro";
import VisualIcon from "../ui/VisualIcon.astro";
import { products } from "../../data/products";
import { niches } from "../../data/niches";
import type { SupportedLocale } from "../../i18n/languages";
import { localizedPath } from "../../i18n/routes";
import { uiCopy } from "../../i18n/ui";

interface Props { locale: SupportedLocale }
const { locale } = Astro.props;
const ui = uiCopy[locale];
const text = {
  nl: { productsLead:"Vijf concrete rollen die samenwerken binnen één klantreis.", view:"Bekijk", flow:"Zo werkt het samen", flowTitle:"Van eerste vraag naar afspraak, taak of klant.", steps:[["Contact komt binnen","E-mail, WhatsApp, formulier of telefoon."],["AI begrijpt de context","De juiste vragen, kennis en afspraken worden gebruikt."],["Systeem voert de actie uit","CRM, agenda en team krijgen de complete uitkomst."]], industries:"Gebouwd voor uw dagelijkse praktijk", industriesLead:"Iedere branche krijgt eigen vragen, uitzonderingen, systemen en overdrachtsregels.", route:"Bekijk de route", delivery:"Van intake naar live in 2–4 weken", deliveryText:"Na complete aanlevering ontwerpen, koppelen, testen en lanceren we gecontroleerd. Privacy by design en menselijke overdracht zijn onderdeel van iedere stap.", cta:"Bekijk het proces" },
  en: { productsLead:"Five focused roles working together across one customer journey.", view:"View", flow:"How it works together", flowTitle:"From first question to appointment, task or customer.", steps:[["Contact arrives","Email, WhatsApp, form or phone."],["AI understands context","It uses the right questions, knowledge and rules."],["The system takes action","CRM, calendar and team receive the complete outcome."]], industries:"Built around daily operations", industriesLead:"Every industry gets its own questions, exceptions, systems and handover rules.", route:"View the journey", delivery:"From intake to live in 2–4 weeks", deliveryText:"Once inputs are complete, we design, connect, test and launch in a controlled way. Privacy by design and human handover are built into every step.", cta:"View the process" },
  es: { productsLead:"Cinco funciones concretas que colaboran en un mismo recorrido de cliente.", view:"Ver", flow:"Cómo colaboran", flowTitle:"De la primera consulta a una cita, tarea o cliente.", steps:[["Llega el contacto","Email, WhatsApp, formulario o teléfono."],["La IA entiende el contexto","Utiliza las preguntas, el conocimiento y las reglas correctas."],["El sistema actúa","El CRM, la agenda y el equipo reciben el resultado completo."]], industries:"Diseñado para la operativa diaria", industriesLead:"Cada sector tiene sus propias preguntas, excepciones, sistemas y reglas de transferencia.", route:"Ver el recorrido", delivery:"De la toma de datos a producción en 2–4 semanas", deliveryText:"Con toda la información disponible, diseñamos, conectamos, probamos y lanzamos de forma controlada. La privacidad y la transferencia humana forman parte de cada paso.", cta:"Ver el proceso" },
  de: { productsLead:"Fünf klare Rollen, die in einer Customer Journey zusammenarbeiten.", view:"Ansehen", flow:"So arbeitet alles zusammen", flowTitle:"Von der ersten Frage zum Termin, zur Aufgabe oder zum Kunden.", steps:[["Kontakt geht ein","E-Mail, WhatsApp, Formular oder Telefon."],["KI versteht den Kontext","Sie nutzt die richtigen Fragen, Kenntnisse und Regeln."],["Das System handelt","CRM, Kalender und Team erhalten das vollständige Ergebnis."]], industries:"Für den Arbeitsalltag entwickelt", industriesLead:"Jede Branche erhält eigene Fragen, Ausnahmen, Systeme und Übergaberegeln.", route:"Journey ansehen", delivery:"Von der Aufnahme bis live in 2–4 Wochen", deliveryText:"Nach vollständiger Bereitstellung entwickeln, verbinden, testen und starten wir kontrolliert. Privacy by Design und menschliche Übergabe gehören zu jedem Schritt.", cta:"Prozess ansehen" },
  it: { productsLead:"Cinque ruoli concreti che collaborano in un unico customer journey.", view:"Scopri", flow:"Come collaborano", flowTitle:"Dal primo contatto a un appuntamento, un'attività o un cliente.", steps:[["Arriva il contatto","Email, WhatsApp, modulo o telefono."],["L'AI comprende il contesto","Usa domande, conoscenze e regole corrette."],["Il sistema agisce","CRM, agenda e team ricevono il risultato completo."]], industries:"Progettato per il lavoro quotidiano", industriesLead:"Ogni settore ha domande, eccezioni, sistemi e regole di passaggio specifiche.", route:"Scopri il percorso", delivery:"Dall'analisi al go-live in 2–4 settimane", deliveryText:"Con tutti gli elementi disponibili, progettiamo, colleghiamo, testiamo e lanciamo in modo controllato. Privacy by design e passaggio umano sono inclusi in ogni fase.", cta:"Scopri il processo" },
  fr: { productsLead:"Cinq rôles précis qui collaborent dans un même parcours client.", view:"Découvrir", flow:"Comment tout fonctionne ensemble", flowTitle:"Du premier contact au rendez-vous, à la tâche ou au client.", steps:[["Le contact arrive","E-mail, WhatsApp, formulaire ou téléphone."],["L'IA comprend le contexte","Elle applique les bonnes questions, connaissances et règles."],["Le système agit","Le CRM, l'agenda et l'équipe reçoivent le résultat complet."]], industries:"Conçu pour les opérations quotidiennes", industriesLead:"Chaque secteur bénéficie de questions, exceptions, systèmes et règles de transfert adaptés.", route:"Voir le parcours", delivery:"Du cadrage à la mise en ligne en 2–4 semaines", deliveryText:"Une fois les éléments fournis, nous concevons, connectons, testons et lançons de manière contrôlée. La confidentialité dès la conception et le transfert humain font partie de chaque étape.", cta:"Voir le processus" }
}[locale];
const nichePath = (slug:string) => localizedPath(`niche.${slug}`, locale);
const label = (slug:string, fallback:string) => locale === "nl" ? fallback : nichePath(slug).split("/").filter(Boolean).at(-1)!.replaceAll("-"," ").replace(/(^|\s)\p{L}/gu, l => l.toUpperCase());
---

<BaseLayout title={ui.home.title} description={ui.home.description} canonical={localizedPath("page.home", locale)} locale={locale} contentId="page.home">
  <Hero eyebrow={ui.home.eyebrow} title={ui.home.heading} accent={ui.home.accent} text={ui.home.lead} primaryLabel={ui.navigation.appointment} primaryHref={localizedPath("page.appointment",locale)} secondaryLabel={ui.navigation.order} secondaryHref={localizedPath("page.order",locale)} chips={products.map(p=>ui.products[p.slug])} />

  <section class="ap-section"><div class="ap-container"><div class="ap-section-head"><div class="ap-kicker">{ui.navigation.products}</div><h2 class="ap-section-title">{text.productsLead}</h2></div><div class="ap-locale-products">{products.map((product,index)=><a href={localizedPath(`product.${product.slug}`,locale)}><div><VisualIcon type="product" name={product.slug} size="small"/><span>{String(index+1).padStart(2,"0")}</span></div><h3>{ui.products[product.slug]}</h3><strong>{text.view} <span>→</span></strong></a>)}</div></div></section>

  <section class="ap-section"><div class="ap-container"><div class="ap-locale-flow"><div class="ap-kicker">{text.flow}</div><h2>{text.flowTitle}</h2><ol>{text.steps.map((step,index)=><li><span>{String(index+1).padStart(2,"0")}</span><div><strong>{step[0]}</strong><p>{step[1]}</p></div></li>)}</ol></div></div></section>

  <section class="ap-section"><div class="ap-container"><div class="ap-section-head"><div class="ap-kicker">{ui.navigation.niches}</div><h2 class="ap-section-title">{text.industries}</h2><p class="ap-text">{text.industriesLead}</p></div><div class="ap-locale-niches">{niches.map(niche=><a href={nichePath(niche.slug)}><span>{label(niche.slug,niche.name)}</span><strong>{text.route} →</strong></a>)}</div></div></section>

  <section class="ap-section"><div class="ap-container"><div class="ap-locale-delivery"><div><div class="ap-kicker">{ui.navigation.process}</div><h2>{text.delivery}</h2><p>{text.deliveryText}</p></div><a class="ap-button ap-button-primary" href={localizedPath("page.process",locale)}>{text.cta}</a></div></div></section>
</BaseLayout>

<style>
  .ap-locale-products{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}.ap-locale-products>a{display:flex;min-height:270px;flex-direction:column;border:1px solid var(--ap-line);border-radius:28px;background:radial-gradient(circle at 90% 10%,rgba(159,56,38,.09),transparent 32%),#fff;padding:23px;box-shadow:0 18px 45px rgba(17,17,17,.055);transition:.2s ease}.ap-locale-products>a:hover{transform:translateY(-4px);border-color:rgba(159,56,38,.28)}.ap-locale-products>a>div{display:flex;align-items:flex-start;justify-content:space-between}.ap-locale-products>a>div>span{color:var(--ap-brown);font-family:"Syne",sans-serif;font-size:10px;font-weight:800}.ap-locale-products h3{margin:30px 0 0;font-size:22px;line-height:1.08}.ap-locale-products strong{display:flex;justify-content:space-between;margin-top:auto;padding-top:30px;font-size:12px}.ap-locale-products strong span{color:var(--ap-brown)}.ap-locale-flow{overflow:hidden;border-radius:36px;background:radial-gradient(circle at 90% 10%,rgba(159,56,38,.28),transparent 28%),#111;padding:48px;color:#fff}.ap-locale-flow .ap-kicker{color:#e4a092}.ap-locale-flow h2{max-width:900px;margin-top:18px;font-size:clamp(34px,5vw,64px);line-height:1}.ap-locale-flow ol{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin:48px 0 0;padding:0;list-style:none}.ap-locale-flow li{display:grid;grid-template-columns:48px 1fr;gap:14px;border-top:1px solid rgba(255,255,255,.16);padding:24px 28px 0 0}.ap-locale-flow li>span{display:grid;width:42px;height:42px;place-items:center;border-radius:14px;background:#fff;color:var(--ap-brown);font:800 10px "Syne",sans-serif}.ap-locale-flow li strong{font-size:17px}.ap-locale-flow li p{margin:8px 0 0;color:rgba(255,255,255,.6);font-size:13px;line-height:1.5}.ap-locale-niches{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.ap-locale-niches a{display:flex;min-height:100px;flex-direction:column;justify-content:space-between;border:1px solid var(--ap-line);border-radius:22px;background:#fff;padding:18px}.ap-locale-niches a>span{font-size:16px;font-weight:900}.ap-locale-niches strong{color:var(--ap-brown);font-size:10px;text-transform:uppercase}.ap-locale-delivery{display:flex;align-items:end;justify-content:space-between;gap:36px;border:1px solid var(--ap-line);border-radius:34px;background:#fff;padding:42px;box-shadow:0 18px 50px rgba(17,17,17,.06)}.ap-locale-delivery h2{max-width:800px;margin-top:16px;font-size:clamp(32px,4vw,54px);line-height:1.02}.ap-locale-delivery p{max-width:800px;margin:20px 0 0;color:var(--ap-muted);line-height:1.65}@media(max-width:1050px){.ap-locale-products{grid-template-columns:repeat(3,1fr)}.ap-locale-niches{grid-template-columns:repeat(3,1fr)}}@media(max-width:720px){.ap-locale-products,.ap-locale-flow ol,.ap-locale-niches{grid-template-columns:1fr}.ap-locale-products>a{min-height:220px}.ap-locale-flow{padding:28px}.ap-locale-flow li{padding-right:0}.ap-locale-delivery{align-items:flex-start;flex-direction:column;padding:28px}}
</style>

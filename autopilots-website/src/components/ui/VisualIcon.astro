---
interface Props { type: "product" | "niche"; name: string; label?: string; size?: "small" | "regular" | "large" }
const { type, name, label = "", size = "regular" } = Astro.props;
const productKey: Record<string,string> = {
  "ai-inboxmedewerker":"chat", "ai-leadopvolger":"follow", "ai-telefoniste":"voice", "autopilots-crm":"crm", "leadsmachine-ai":"leadsmachine"
};
const icons: Record<string,string> = {
  chat:'<svg viewBox="0 0 32 32"><path d="M7 9h14a4 4 0 0 1 4 4v5a4 4 0 0 1-4 4h-6l-6 4v-4H7a4 4 0 0 1-4-4v-5a4 4 0 0 1 4-4Z"/><path d="M10 14h8M10 18h5"/></svg>',
  follow:'<svg viewBox="0 0 32 32"><path d="M10 11H5V6M5.5 11c2.2-4.7 8.4-7 13.4-4.4 3.8 2 6.1 5.8 6.1 9.9M22 21h5v5M26.5 21c-2.2 4.7-8.4 7-13.4 4.4A11 11 0 0 1 7 15.5"/></svg>',
  voice:'<svg viewBox="0 0 32 32"><path d="M7 18v-4M12 22V10M17 25V7M22 22V10M27 18v-4"/></svg>',
  leadsmachine:'<svg viewBox="0 0 32 32"><path d="M5 7h22l-9 10v7l-4 2v-9L5 7Z"/><path d="M10 7c2.8 3.6 9.2 3.6 12 0"/></svg>',
  autobedrijven:'<svg viewBox="0 0 32 32"><path d="M7 19h18l-2-6H9l-2 6ZM9 19v4M23 19v4M10 23h2M20 23h2M11 13l2-4h6l2 4"/></svg>',
  dakdekkers:'<svg viewBox="0 0 32 32"><path d="M5 17 16 7l11 10M8 16v10h16V16M13 26v-6h6v6"/></svg>',
  hoveniers:'<svg viewBox="0 0 32 32"><path d="M16 26V9M16 9c-4 0-7 3-7 7 4 0 7-3 7-7ZM16 12c4 0 7 3 7 7-4 0-7-3-7-7ZM8 26h16"/></svg>',
  installatietechniek:'<svg viewBox="0 0 32 32"><path d="m21 5 6 6-5 5-6-6 5-5Zm-5 5-9 9v6h6l9-9M8 24l5-5"/></svg>',
  vastgoedbeheerders:'<svg viewBox="0 0 32 32"><path d="M5 15 16 6l11 9M8 14v12h16V14M13 26v-7h6v7M22 11V7h3v7"/></svg>',
  kapperszaken:'<svg viewBox="0 0 32 32"><path d="M9 8l14 16M23 8 9 24"/><circle cx="8" cy="7" r="3"/><circle cx="8" cy="25" r="3"/></svg>',
  tandartsen:'<svg viewBox="0 0 32 32"><path d="M11 5c-3 0-5 2.2-5 5.7 0 5.2 3 14.3 5.3 14.3 1.5 0 1.6-5.2 4.7-5.2s3.2 5.2 4.7 5.2C23 25 26 15.9 26 10.7 26 7.2 24 5 21 5c-2 0-3.2 1-5 1s-3-1-5-1Z"/></svg>',
  makelaars:'<svg viewBox="0 0 32 32"><path d="M7 26V8h14l4 4-4 4H7M13 13h8"/></svg>',
  "cosmetische-klinieken":'<svg viewBox="0 0 32 32"><path d="M16 5v22M8 13h16M10 9h12M10 23h12"/><rect x="10" y="5" width="12" height="22" rx="2"/></svg>',
  verzekeraars:'<svg viewBox="0 0 32 32"><path d="M16 5 7 9v7c0 6 4 10 9 12 5-2 9-6 9-12V9l-9-4ZM16 12v8M12 16h8"/></svg>',
  glaszetters:'<svg viewBox="0 0 32 32"><path d="M9 5h14v22H9zM13 5v22M19 5v22m-10-7 14-6m-14 14 14-6"/></svg>',
  hotels:'<svg viewBox="0 0 32 32"><path d="M6 26V8h12v18M18 14h8v12M10 12h4M10 17h4M22 18h1M22 22h1"/></svg>',
  restaurants:'<svg viewBox="0 0 32 32"><path d="M10 5v22M7 5v8a3 3 0 0 0 6 0V5M21 5v22M21 5c3 2 4 5 4 9h-4"/></svg>',
  evenementen:'<svg viewBox="0 0 32 32"><path d="M9 6v5M23 6v5M6 12h20M7 8h18v18H7zm5 11 3 3 6-7"/></svg>',
  kozijnen:'<svg viewBox="0 0 32 32"><path d="M7 6h18v20H7zM16 6v20M7 16h18M11 11h2M19 21h2"/></svg>',
  zonnepanelen:'<svg viewBox="0 0 32 32"><path d="M6 13h20v12H6zM10 13v12M16 13v12M22 13v12M8 19h16M16 5v3M10 7l2 2M22 7l-2 2"/></svg>',
  vloerenleggers:'<svg viewBox="0 0 32 32"><path d="M6 9h20M6 16h20M6 23h20M10 9v7M18 16v7M24 9v7"/></svg>',
  woningcorporaties:'<svg viewBox="0 0 32 32"><path d="M5 15 16 6l11 9M8 14v12h16V14M12 26v-6h8v6M12 14h2M18 14h2"/></svg>',
  "non-profit":'<svg viewBox="0 0 32 32"><path d="M16 27s-9-5.6-9-13a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 7.4-9 13-9 13Z"/></svg>',
  dierenarts:'<svg viewBox="0 0 32 32"><path d="M16 7v18M7 16h18M10 10h12v12H10z"/></svg>',
  dierenverzorging:'<svg viewBox="0 0 32 32"><path d="M9 18c-2 0-3-1.4-3-3.1S7.3 12 9 12s3 1.2 3 2.9S11 18 9 18ZM23 18c-2 0-3-1.4-3-3.1s1.3-2.9 3-2.9 3 1.2 3 2.9S25 18 23 18ZM12.5 22.5c0-2 1.6-4.5 3.5-4.5s3.5 2.5 3.5 4.5c0 1.7-1.2 2.5-3.5 2.5s-3.5-.8-3.5-2.5ZM13 12c0-1.7 1.3-3 3-3s3 1.3 3 3"/></svg>'
};
const key = type === "product" ? productKey[name] : name;
const isCrm = key === "crm";
---
<span class:list={["ap-visual-icon", `is-${size}`, {"is-crm":isCrm}]} role={label ? "img" : undefined} aria-label={label || undefined} aria-hidden={label ? undefined : "true"}>
  {isCrm ? <img src="/ap-crm-logo.svg" alt="" /> : <Fragment set:html={icons[key] || icons["leadsmachine"]} />}
</span>

<style>
  .ap-visual-icon{display:grid;width:58px;height:58px;flex:0 0 auto;place-items:center;border:1px solid rgba(159,56,38,.16);border-radius:19px;background:#fff;color:var(--ap-brown);box-shadow:0 14px 34px rgba(17,17,17,.07)}
  .ap-visual-icon :global(svg){width:31px;height:31px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ap-visual-icon :global(img){width:34px;height:34px;object-fit:contain}.ap-visual-icon.is-small{width:40px;height:40px;border-radius:13px}.ap-visual-icon.is-small :global(svg){width:23px;height:23px}.ap-visual-icon.is-small :global(img){width:25px;height:25px}.ap-visual-icon.is-large{width:82px;height:82px;border-radius:25px}.ap-visual-icon.is-large :global(svg){width:43px;height:43px}.ap-visual-icon.is-large :global(img){width:48px;height:48px}
</style>

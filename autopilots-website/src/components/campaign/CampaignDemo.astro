---
import type { FunnelDemoScenario } from "../../data/marketingFunnels";
interface Props { scenarios: FunnelDemoScenario[] }
const { scenarios } = Astro.props;
const data = JSON.stringify(scenarios).replaceAll("<", "\\u003c");
const first = scenarios[0];
---
<div class="ap-campaign-demo" data-campaign-demo>
  <div class="ap-demo-tabs" role="tablist" aria-label="Kies een AI-medewerker">
    {scenarios.map((scenario,index)=><button class:list={[{"is-active":index===0}]} type="button" role="tab" aria-selected={index===0?"true":"false"} data-campaign-demo-tab={index}><span>{String(index+1).padStart(2,"0")}</span><div><strong>{scenario.product}</strong><small>{scenario.promise}</small></div></button>)}
  </div>
  <div class="ap-demo-stage">
    <section class="ap-demo-chat" aria-live="polite">
      <header><div><span data-demo-channel>{first.channel}</span><strong data-demo-product>{first.product}</strong></div><small><i></i> Live scenario</small></header>
      <div class="ap-demo-messages" data-demo-messages></div>
      <div class="ap-demo-controls"><button type="button" data-demo-reset>Opnieuw</button><button type="button" class="is-next" data-demo-next>Volgende stap <span>→</span></button></div>
    </section>
    <aside class="ap-demo-route">
      <div class="ap-campaign-kicker">Actie in het systeem</div><h3>Je ziet wat er achter het gesprek gebeurt.</h3>
      <ol data-demo-route></ol>
      <div class="ap-demo-result"><span>Resultaat voor het team</span><strong data-demo-result>{first.result}</strong></div>
    </aside>
  </div>
  <div class="ap-demo-progress"><i data-demo-progress></i></div>
  <script type="application/json" data-demo-data set:html={data}></script>
</div>

<script>
  document.querySelectorAll("[data-campaign-demo]").forEach((root) => {
    const scenarios=JSON.parse(root.querySelector("[data-demo-data]")?.textContent||"[]");
    const messages=root.querySelector("[data-demo-messages]"),route=root.querySelector("[data-demo-route]");
    const product=root.querySelector("[data-demo-product]"),channel=root.querySelector("[data-demo-channel]"),result=root.querySelector("[data-demo-result]"),progress=root.querySelector("[data-demo-progress]");
    const next=root.querySelector("[data-demo-next]");let selected=0,step=0;
    const render=()=>{const scenario=scenarios[selected];product.textContent=scenario.product;channel.textContent=scenario.channel;result.textContent=scenario.result;messages.replaceChildren();scenario.messages.slice(0,step+1).forEach(item=>{const article=document.createElement("article");article.className=item.from==="Klant"?"is-customer":"is-ai";const label=document.createElement("span");label.textContent=item.from;const p=document.createElement("p");p.textContent=item.text;article.append(label,p);messages.append(article)});route.replaceChildren();scenario.route.forEach((item,index)=>{const li=document.createElement("li");if(index<=step)li.className="is-active";const number=document.createElement("span");number.textContent=String(index+1).padStart(2,"0");const strong=document.createElement("strong");strong.textContent=item;const status=document.createElement("i");status.textContent=index<=step?"✓":"";li.append(number,strong,status);route.append(li)});progress.style.width=`${((step+1)/scenario.messages.length)*100}%`;next.firstChild.textContent=step>=scenario.messages.length-1?"Scenario voltooid ":"Volgende stap ";messages.scrollTop=messages.scrollHeight;window.apCampaign?.emit?.(step>=scenario.messages.length-1?"demo_completed":"demo_step_viewed",{product:scenario.key,step:step+1})};
    root.querySelectorAll("[data-campaign-demo-tab]").forEach(button=>button.addEventListener("click",()=>{selected=Number(button.dataset.campaignDemoTab);step=0;root.querySelectorAll("[data-campaign-demo-tab]").forEach((item,index)=>{item.classList.toggle("is-active",index===selected);item.setAttribute("aria-selected",String(index===selected))});render()}));
    next.addEventListener("click",()=>{const max=scenarios[selected].messages.length-1;step=step>=max?0:step+1;render()});root.querySelector("[data-demo-reset]").addEventListener("click",()=>{step=0;render()});render();
  });
</script>

<style>
  .ap-campaign-demo{overflow:hidden;border:1px solid rgba(255,255,255,.1);border-radius:34px;background:#111;box-shadow:0 28px 80px rgba(17,17,17,.18)}.ap-demo-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-bottom:1px solid rgba(255,255,255,.1);padding:10px}.ap-demo-tabs button{display:grid;min-width:0;grid-template-columns:38px 1fr;gap:11px;align-items:center;border:0;border-right:1px solid rgba(255,255,255,.08);background:transparent;padding:15px;color:rgba(255,255,255,.45);font:inherit;text-align:left;cursor:pointer}.ap-demo-tabs button:last-child{border-right:0}.ap-demo-tabs button:hover,.ap-demo-tabs button:focus-visible,.ap-demo-tabs button.is-active{border-radius:18px;background:rgba(255,255,255,.07);color:#fff;outline:none}.ap-demo-tabs button>span{font:700 9px/1 "Syne",sans-serif;color:#e7a295}.ap-demo-tabs strong,.ap-demo-tabs small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ap-demo-tabs strong{font-size:12px}.ap-demo-tabs small{margin-top:5px;font-size:9px}.ap-demo-stage{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);min-height:570px}.ap-demo-chat{display:flex;min-width:0;flex-direction:column;border-right:1px solid rgba(255,255,255,.1);background:linear-gradient(145deg,#fbfbf8,#eeeae5);padding:26px;color:#111}.ap-demo-chat header{display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid rgba(17,17,17,.09);padding-bottom:18px}.ap-demo-chat header span,.ap-demo-chat header strong{display:block}.ap-demo-chat header span{color:var(--campaign-rust);font:700 9px/1 "Syne",sans-serif;letter-spacing:1.2px;text-transform:uppercase}.ap-demo-chat header strong{margin-top:7px;font-size:14px}.ap-demo-chat header>small{display:flex;align-items:center;gap:8px;border-radius:999px;background:#e8f4ea;padding:8px 10px;color:#347441;font-size:9px;font-weight:850}.ap-demo-chat header i{width:6px;height:6px;border-radius:50%;background:#65b774}.ap-demo-messages{display:flex;overflow:auto;min-height:390px;flex-direction:column;gap:11px;padding:24px 2px}.ap-demo-messages article{max-width:80%;animation:apMessageIn .25s ease both}.ap-demo-messages article.is-ai{align-self:flex-end}.ap-demo-messages article>span{display:block;margin:0 7px 6px;color:#8a8885;font:700 8px/1 "Syne",sans-serif;letter-spacing:1px;text-transform:uppercase}.ap-demo-messages article.is-ai>span{text-align:right}.ap-demo-messages p{border:1px solid rgba(17,17,17,.1);border-radius:6px 20px 20px 20px;background:#fff;padding:13px 15px;font-size:12px;font-weight:700;line-height:1.5;box-shadow:0 8px 24px rgba(17,17,17,.05)}.ap-demo-messages article.is-ai p{border-color:#111;border-radius:20px 6px 20px 20px;background:#111;color:#fff}.ap-demo-controls{display:flex;justify-content:space-between;gap:10px;margin-top:auto}.ap-demo-controls button{min-height:44px;border:1px solid rgba(17,17,17,.12);border-radius:999px;background:#fff;padding:10px 14px;color:#111;font-size:10px;font-weight:850;cursor:pointer}.ap-demo-controls button.is-next{display:flex;align-items:center;gap:20px;border-color:var(--campaign-rust);background:var(--campaign-rust);color:#fff}.ap-demo-route{position:relative;overflow:hidden;padding:28px;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px),radial-gradient(circle at 100% 100%,rgba(159,56,38,.32),transparent 42%);background-size:28px 28px,28px 28px,auto}.ap-demo-route .ap-campaign-kicker{color:#e7a295}.ap-demo-route h3{font-size:24px;line-height:1.12}.ap-demo-route ol{display:grid;margin:25px 0 0;padding:0;list-style:none}.ap-demo-route li{display:grid;grid-template-columns:38px minmax(0,1fr) 24px;gap:11px;align-items:center;min-height:72px;border-left:1px solid rgba(255,255,255,.12);padding:8px 0 8px 16px;color:rgba(255,255,255,.34);transition:.25s}.ap-demo-route li>span{display:grid;width:38px;height:38px;place-items:center;border-radius:12px;background:rgba(255,255,255,.06);font:700 9px/1 "Syne",sans-serif}.ap-demo-route li>strong{font-size:11px}.ap-demo-route li>i{display:grid;width:24px;height:24px;place-items:center;border-radius:50%;background:rgba(255,255,255,.06);font-size:9px;font-style:normal}.ap-demo-route li.is-active{border-left-color:#e7a295;color:#fff}.ap-demo-route li.is-active>span{background:rgba(159,56,38,.3);color:#f2ad9f}.ap-demo-route li.is-active>i{background:#e7f3e8;color:#347441}.ap-demo-result{margin-top:20px;border:1px solid rgba(231,162,149,.25);border-radius:20px;background:rgba(159,56,38,.18);padding:16px}.ap-demo-result span{display:block;color:#f2ad9f;font:700 8px/1 "Syne",sans-serif;letter-spacing:1.2px;text-transform:uppercase}.ap-demo-result strong{display:block;margin-top:9px;font-size:11px;line-height:1.45}.ap-demo-progress{height:3px;background:rgba(255,255,255,.08)}.ap-demo-progress i{display:block;width:25%;height:100%;background:linear-gradient(90deg,var(--campaign-rust),#e59684);transition:.3s}@keyframes apMessageIn{from{transform:translateY(7px);opacity:0}to{transform:none;opacity:1}}@media(max-width:850px){.ap-demo-stage{grid-template-columns:1fr}.ap-demo-chat{border-right:0;border-bottom:1px solid rgba(255,255,255,.1)}}@media(max-width:620px){.ap-campaign-demo{border-radius:26px}.ap-demo-tabs{grid-template-columns:1fr}.ap-demo-tabs button{border-right:0;border-bottom:1px solid rgba(255,255,255,.08);padding:12px}.ap-demo-chat,.ap-demo-route{padding:20px}.ap-demo-messages{min-height:420px}.ap-demo-messages article{max-width:92%}}
</style>

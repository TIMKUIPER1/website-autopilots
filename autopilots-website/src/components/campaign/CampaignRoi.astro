---
import type { MarketingFunnelConfig } from "../../data/marketingFunnels";
import type { SupportedLocale } from "../../i18n/languages";
interface Props { config: MarketingFunnelConfig; locale?: SupportedLocale }
const { config, locale="nl" } = Astro.props;
const t={nl:["Welke rol wil je berekenen?","Inboxmedewerker","Telefoniste","Leadopvolger","Nieuwe leads en vragen per maand","Nu te laat of niet opgevolgd (%)","Naar proefrit of concrete afspraak (%)","Van afspraak naar klant (%)","Gemiddelde waarde per resultaat (€)","Herstel voorbeeld","Indicatief verschil per maand","Zonder gekozen AI-rol","Met gekozen AI-rol","Mogelijke extra waarde","extra vragen op tijd verwerkt","extra afspraken","extra resultaten","Indicatie op basis van je invoer en vaste rekenregels. Geen garantie op conversie, omzet of resultaat."],en:["Which role do you want to calculate?","Inbox agent","Receptionist","Lead follow-up","New leads and questions per month","Currently late or not followed up (%)","To test drive or concrete appointment (%)","From appointment to customer (%)","Average value per result (€)","Reset example","Indicative difference per month","Without selected AI role","With selected AI role","Potential additional value","extra questions handled on time","extra appointments","extra results","Indicative calculation based on your input and fixed rules. No guarantee of conversion, revenue or results."],es:["¿Qué función quieres calcular?","Agente de bandeja","Recepcionista","Seguimiento de leads","Nuevos leads y consultas al mes","Actualmente tarde o sin seguimiento (%)","A prueba o cita concreta (%)","De cita a cliente (%)","Valor medio por resultado (€)","Restablecer ejemplo","Diferencia mensual indicativa","Sin la función de IA","Con la función de IA","Valor adicional posible","consultas extra atendidas a tiempo","citas extra","resultados extra","Cálculo indicativo según tus datos y reglas fijas. Sin garantía de conversión, ingresos o resultados."],de:["Welche Rolle möchten Sie berechnen?","Postfachassistent","Telefonassistent","Lead-Nachverfolgung","Neue Leads und Anfragen pro Monat","Derzeit verspätet oder nicht verfolgt (%)","Zu Probefahrt oder Termin (%)","Vom Termin zum Kunden (%)","Durchschnittswert pro Ergebnis (€)","Beispiel zurücksetzen","Richtwert pro Monat","Ohne gewählte KI-Rolle","Mit gewählter KI-Rolle","Möglicher Zusatzwert","zusätzliche Anfragen rechtzeitig bearbeitet","zusätzliche Termine","zusätzliche Ergebnisse","Richtwert auf Basis Ihrer Eingaben und fester Regeln. Keine Garantie für Conversion, Umsatz oder Ergebnis."],it:["Quale ruolo vuoi calcolare?","Assistente inbox","Receptionist","Follow-up lead","Nuovi lead e richieste al mese","Attualmente in ritardo o senza follow-up (%)","A test drive o appuntamento (%)","Da appuntamento a cliente (%)","Valore medio per risultato (€)","Ripristina esempio","Differenza mensile indicativa","Senza il ruolo AI","Con il ruolo AI","Possibile valore aggiuntivo","richieste extra gestite in tempo","appuntamenti extra","risultati extra","Calcolo indicativo basato sui dati inseriti e su regole fisse. Nessuna garanzia di conversione, fatturato o risultato."],fr:["Quel rôle souhaitez-vous calculer ?","Assistant messagerie","Standardiste","Suivi des prospects","Nouveaux prospects et demandes par mois","Actuellement en retard ou sans suivi (%)","Vers essai ou rendez-vous concret (%)","Du rendez-vous au client (%)","Valeur moyenne par résultat (€)","Réinitialiser l'exemple","Écart mensuel indicatif","Sans le rôle IA choisi","Avec le rôle IA choisi","Valeur additionnelle possible","demandes supplémentaires traitées à temps","rendez-vous supplémentaires","résultats supplémentaires","Estimation basée sur vos données et des règles fixes. Aucune garantie de conversion, chiffre d'affaires ou résultat."]}[locale];
const payload=JSON.stringify(config.roi).replaceAll("<","\\u003c");
---
<div class="ap-campaign-roi" data-campaign-roi>
  <form data-campaign-roi-form>
    <fieldset><legend>{t[0]}</legend><div class="ap-roi-roles">{[["inbox",t[1]],["telefoniste",t[2]],["leadopvolger",t[3]]].map((item,index)=><label><input type="radio" name="packageKey" value={item[0]} checked={index===0}/><span>{String(index+1).padStart(2,"0")}</span><strong>{item[1]}</strong><i>✓</i></label>)}</div></fieldset>
    <div class="ap-roi-fields">{[["volume",t[4],config.roi.volume,100000],["issue",t[5],config.roi.issue,100],["appointment",t[6],config.roi.appointment,100],["close",t[7],config.roi.close,100],["value",t[8],config.roi.value,1000000]].map(item=><label><span>{item[1]}</span><input name={item[0]} type="number" min="0" max={item[3]} value={item[2]}/></label>)}</div>
    <button class="ap-campaign-button is-secondary" type="reset">{t[9]}</button>
  </form>
  <aside aria-live="polite"><div class="ap-campaign-kicker">{t[10]}</div><div class="ap-roi-compare"><article><span>{t[11]}</span><strong data-roi-manual>0</strong></article><article><span>{t[12]}</span><strong data-roi-ai>0</strong></article></div><div class="ap-roi-impact"><span>{t[13]}</span><strong data-roi-value>€ 0</strong><p><b data-roi-extra>0</b> {t[14]}, <b data-roi-actions>0</b> {t[15]}, <b data-roi-results>0</b> {t[16]}.</p></div><small>{t[17]}</small></aside>
  <script type="application/json" data-roi-defaults data-locale={locale} set:html={payload}></script>
</div>

<script>
  import { calculateRoi } from "../../lib/roi";
  document.querySelectorAll("[data-campaign-roi]").forEach(root=>{const form=root.querySelector("form");const locale=root.querySelector("[data-roi-defaults]")?.dataset.locale||"nl";const value=name=>Number(form.elements[name]?.value||0);const format=(number,digits=1)=>new Intl.NumberFormat(locale,{maximumFractionDigits:digits}).format(number||0);const euro=number=>new Intl.NumberFormat(locale,{style:"currency",currency:"EUR",maximumFractionDigits:0}).format(number||0);const set=(selector,text)=>root.querySelector(selector).textContent=text;const update=()=>{const result=calculateRoi({packageKey:form.elements.packageKey.value,volume:value("volume"),issuePercent:value("issue"),peakPercent:0,appointmentPercent:value("appointment"),closePercent:value("close"),valuePerCustomer:value("value")});set("[data-roi-manual]",format(result.handledWithoutAi));set("[data-roi-ai]",format(result.handledWithAi));set("[data-roi-extra]",format(result.extraHandled));set("[data-roi-actions]",format(result.extraAppointments));set("[data-roi-results]",format(result.extraCustomers));set("[data-roi-value]",euro(result.indicativeValue));window.apCampaign?.emit?.("roi_calculated",{product:form.elements.packageKey.value})};form.querySelectorAll("input").forEach(input=>{input.addEventListener("input",update);input.addEventListener("change",update)});form.addEventListener("reset",()=>requestAnimationFrame(update));update()});
</script>

<style>
  .ap-campaign-roi{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(350px,.95fr);gap:16px;border:1px solid rgba(17,17,17,.1);border-radius:34px;background:#fff;padding:18px;box-shadow:0 22px 70px rgba(17,17,17,.07)}.ap-campaign-roi form{display:grid;gap:16px;padding:12px}.ap-campaign-roi fieldset{margin:0;border:0;padding:0}.ap-campaign-roi legend{margin-bottom:10px;color:#656565;font-size:11px;font-weight:850}.ap-roi-roles{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.ap-roi-roles label{position:relative;display:grid;min-width:0;grid-template-columns:28px minmax(0,1fr) 19px;gap:8px;align-items:center;border:1px solid rgba(17,17,17,.1);border-radius:17px;background:#fafaf8;padding:11px;cursor:pointer}.ap-roi-roles input{position:absolute;clip:rect(0 0 0 0)}.ap-roi-roles label:has(input:checked){border-color:rgba(159,56,38,.45);background:#fff5f1}.ap-roi-roles span{font:700 8px/1 "Syne",sans-serif;color:var(--campaign-rust)}.ap-roi-roles strong{overflow:hidden;font-size:10px;text-overflow:ellipsis;white-space:nowrap}.ap-roi-roles i{display:grid;width:19px;height:19px;place-items:center;border-radius:50%;background:#ddd;color:transparent;font-size:9px;font-style:normal}.ap-roi-roles label:has(input:checked) i{background:var(--campaign-rust);color:#fff}.ap-roi-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.ap-roi-fields label{display:grid;gap:7px;color:#656565;font-size:10px;font-weight:850}.ap-roi-fields input{width:100%;min-height:48px;border:1px solid rgba(17,17,17,.1);border-radius:14px;background:#f8f8f5;padding:0 13px;color:#111;font-size:14px;font-weight:750}.ap-roi-fields input:focus{border-color:var(--campaign-rust);outline:3px solid rgba(159,56,38,.12)}.ap-campaign-roi form>.ap-campaign-button{justify-self:start}.ap-campaign-roi>aside{position:relative;overflow:hidden;border-radius:27px;background:radial-gradient(circle at 100% 100%,rgba(159,56,38,.48),transparent 42%),#111;padding:27px;color:#fff}.ap-campaign-roi>aside .ap-campaign-kicker{color:#e7a295}.ap-roi-compare{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:18px}.ap-roi-compare article{border:1px solid rgba(255,255,255,.12);border-radius:17px;background:rgba(255,255,255,.07);padding:13px}.ap-roi-compare article:last-child{border-color:rgba(231,162,149,.3);background:rgba(159,56,38,.18)}.ap-roi-compare span,.ap-roi-compare strong{display:block}.ap-roi-compare span{color:rgba(255,255,255,.58);font-size:9px;line-height:1.35}.ap-roi-compare strong{margin-top:8px;font:700 24px/1 "Syne",sans-serif}.ap-roi-impact{margin-top:10px;border-radius:20px;background:#fff;padding:17px;color:#111}.ap-roi-impact>span{color:var(--campaign-rust);font:700 8px/1 "Syne",sans-serif;letter-spacing:1.1px;text-transform:uppercase}.ap-roi-impact>strong{display:block;margin-top:10px;font:700 38px/1 "Syne",sans-serif}.ap-roi-impact p{margin-top:11px!important;color:#656565;font-size:10px;line-height:1.5}.ap-campaign-roi>aside>small{display:block;margin-top:15px;color:rgba(255,255,255,.48);font-size:9px;line-height:1.45}@media(max-width:850px){.ap-campaign-roi{grid-template-columns:1fr}}@media(max-width:580px){.ap-campaign-roi{border-radius:26px;padding:11px}.ap-roi-roles,.ap-roi-fields{grid-template-columns:1fr}.ap-campaign-roi>aside{border-radius:22px;padding:20px}.ap-campaign-roi form>.ap-campaign-button{width:100%}}
</style>

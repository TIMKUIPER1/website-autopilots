---
import type { Niche } from "../../data/niches";
import type { SupportedLocale } from "../../i18n/languages";
import { nichePageCopy } from "../../i18n/nichePage";

interface Props { niche: Niche; locale?: SupportedLocale; copy?: (typeof nichePageCopy)[SupportedLocale]["roi"] }
const { niche, locale = "nl", copy = nichePageCopy[locale].roi } = Astro.props;
const valueDefaults: Record<string, number> = {
  autobedrijven: 2500, dakdekkers: 1800, hoveniers: 2200, installatietechniek: 1200, vastgoedbeheerders: 180,
  kapperszaken: 85, tandartsen: 180, makelaars: 3500, "cosmetische-klinieken": 450, verzekeraars: 220,
  glaszetters: 950, hotels: 240, restaurants: 95, evenementen: 3200, kozijnen: 2800, zonnepanelen: 3500,
  vloerenleggers: 2100, woningcorporaties: 140, "non-profit": 100, dierenarts: 160, dierenverzorging: 95
};
const defaults = { volume: niche.metric.volume, issue: 35, peak: 15, appointment: 40, close: 30, value: valueDefaults[niche.slug] ?? 500 };
const payload = JSON.stringify({ niche: niche.slug, locale, defaults }).replaceAll("<", "\u003c");
---

<section class="ap-section ap-roi-section" id="roi-calculator" data-roi-calculator>
  <div class="ap-container">
    <div class="ap-section-head"><div class="ap-kicker">{copy.kicker} {niche.name}</div><h2>{copy.title} <span class="ap-title-accent">{copy.accent}</span></h2><p>{copy.lead}</p></div>
    <div class="ap-roi-shell">
      <form class="ap-roi-inputs" data-roi-form>
        <fieldset class="ap-roi-product-picker">
          <legend>{copy.choose}</legend>
          <div role="radiogroup" aria-label={copy.aria}>
            {[
              ["inbox", "01", copy.products[0][0], copy.products[0][1]],
              ["telefoniste", "02", copy.products[1][0], copy.products[1][1]],
              ["leadopvolger", "03", copy.products[2][0], copy.products[2][1]],
              ["complete", "04", copy.products[3][0], copy.products[3][1]]
            ].map((item, index) => <label class="ap-roi-product-option">
              <input type="radio" name="packageKey" value={item[0]} data-roi-package checked={index === 0} />
              <span>{item[1]}</span><div><strong>{item[2]}</strong><small>{item[3]}</small></div><i aria-hidden="true">✓</i>
            </label>)}
          </div>
        </fieldset>
        <label><span>{niche.metric.label} {copy.perMonth}</span><input name="volume" data-roi-volume type="number" min="0" max="100000" step="10" value={defaults.volume} inputmode="numeric" /></label>
        <label><span>{copy.late}</span><input name="issue" data-roi-issue type="number" min="0" max="100" step="1" value={defaults.issue} inputmode="decimal" /></label>
        <label data-roi-peak-field hidden><span>{copy.peak}</span><input name="peak" data-roi-peak type="number" min="0" max="100" step="1" value={defaults.peak} inputmode="decimal" /></label>
        <label><span>{copy.action}</span><input name="appointment" data-roi-appointment type="number" min="0" max="100" step="1" value={defaults.appointment} inputmode="decimal" /></label>
        <label><span>{copy.result}</span><input name="close" data-roi-close type="number" min="0" max="100" step="1" value={defaults.close} inputmode="decimal" /></label>
        <label><span>{copy.value}</span><input name="value" data-roi-value type="number" min="0" max="1000000" step="50" value={defaults.value} inputmode="decimal" /></label>
        <button class="ap-button ap-button-secondary" type="reset" data-roi-reset>{copy.restore}</button>
      </form>
      <div class="ap-roi-results" aria-live="polite">
        <div class="ap-kicker">{copy.difference}</div>
        <div class="ap-roi-compare"><article><span>{copy.without}</span><strong data-roi-manual>0</strong></article><article class="is-ai"><span>{copy.with}</span><strong data-roi-ai>0</strong></article></div>
        <div class="ap-roi-primary"><span>{copy.extraValue}</span><strong data-roi-euro>€ 0</strong><p><b data-roi-extra>0</b> {copy.sentence[0]} <b data-roi-appointments>0</b> {copy.sentence[1]} <b data-roi-customers>0</b> {copy.sentence[2]}</p></div>
        <details><summary>{copy.calculation} <span aria-hidden="true">+</span></summary><p>{copy.calculationText}</p></details>
      </div>
    </div>
  </div>
  <script type="application/json" data-roi-payload set:html={payload}></script>
</section>

<script>
  import { calculateRoi } from "../../lib/roi";
  document.querySelectorAll("[data-roi-calculator]").forEach((root) => {
    const payload = JSON.parse(root.querySelector("[data-roi-payload]")?.textContent || "{}");
    const get = (selector) => root.querySelector(selector);
    const number = (selector) => Number.parseFloat(get(selector)?.value || "0");
    const format = (value, digits = 1) => new Intl.NumberFormat(payload.locale, { maximumFractionDigits: digits }).format(Number.isFinite(value) ? value : 0);
    const euro = (value) => new Intl.NumberFormat(payload.locale, { style: "currency", currency: "EUR", maximumFractionDigits: 0 }).format(Number.isFinite(value) ? value : 0);
    const set = (selector, value) => { const node = get(selector); if (node) node.textContent = value; };
    const update = () => {
      const packageKey = get("[data-roi-package]:checked")?.value || "inbox";
      get("[data-roi-peak-field]").hidden = !["telefoniste", "complete"].includes(packageKey);
      const result = calculateRoi({ packageKey, volume:number("[data-roi-volume]"), issuePercent:number("[data-roi-issue]"), peakPercent:number("[data-roi-peak]"), appointmentPercent:number("[data-roi-appointment]"), closePercent:number("[data-roi-close]"), valuePerCustomer:number("[data-roi-value]") });
      set("[data-roi-manual]", format(result.handledWithoutAi)); set("[data-roi-ai]", format(result.handledWithAi)); set("[data-roi-extra]", format(result.extraHandled)); set("[data-roi-appointments]", format(result.extraAppointments)); set("[data-roi-customers]", format(result.extraCustomers)); set("[data-roi-euro]", euro(result.indicativeValue));
      root.dispatchEvent(new CustomEvent("autopilots:roi-updated", { bubbles:true, detail:{ niche:payload.niche, package:packageKey } }));
    };
    root.querySelectorAll("input").forEach((input) => { input.addEventListener("input", update); input.addEventListener("change", update); });
    get("[data-roi-form]")?.addEventListener("reset", () => requestAnimationFrame(update));
    update();
  });
</script>

<style>
  .ap-roi-section{background:#efefeb}.ap-roi-shell{display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,.82fr);gap:16px;border:1px solid var(--ap-line);border-radius:34px;background:#fff;padding:18px;box-shadow:0 22px 70px rgba(17,17,17,.065)}
  .ap-roi-inputs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;padding:12px}.ap-roi-inputs>label{display:grid;gap:8px;color:var(--ap-muted);font-size:12px;font-weight:800}.ap-roi-inputs input:not([type="radio"]){width:100%;min-height:50px;border:1px solid var(--ap-line);border-radius:15px;background:#f8f8f5;padding:0 14px;color:#111;font:750 15px/1 "Public Sans",sans-serif}.ap-roi-inputs input:not([type="radio"]):focus{border-color:var(--ap-brown);outline:3px solid rgba(159,56,38,.13)}.ap-roi-inputs .ap-button{align-self:end;justify-content:center}
  .ap-roi-product-picker{grid-column:1/-1;margin:0;border:0;padding:0}.ap-roi-product-picker legend{margin-bottom:10px;color:var(--ap-muted);font-size:12px;font-weight:800}.ap-roi-product-picker>div{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.ap-roi-product-option{position:relative;display:grid;min-width:0;grid-template-columns:34px minmax(0,1fr) 22px;gap:11px;align-items:center;min-height:78px;border:1px solid var(--ap-line);border-radius:20px;background:linear-gradient(145deg,#fff,#f8f8f5);padding:13px;cursor:pointer;box-shadow:0 8px 24px rgba(17,17,17,.035);transition:border-color .18s ease,transform .18s ease,box-shadow .18s ease,background .18s ease}.ap-roi-product-option:hover{transform:translateY(-2px);border-color:rgba(159,56,38,.28);box-shadow:0 12px 30px rgba(17,17,17,.07)}.ap-roi-product-option:has(input:focus-visible){outline:3px solid rgba(159,56,38,.14);outline-offset:2px}.ap-roi-product-option:has(input:checked){border-color:rgba(159,56,38,.48);background:linear-gradient(145deg,#fffaf8,#f7e9e4);box-shadow:inset 0 0 0 1px rgba(159,56,38,.08),0 12px 32px rgba(159,56,38,.09)}.ap-roi-product-option input{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap}.ap-roi-product-option>span{display:grid;width:34px;height:34px;place-items:center;border-radius:11px;background:#111;color:#fff;font:700 9px/1 "Syne",sans-serif;transition:.18s ease}.ap-roi-product-option:has(input:checked)>span{background:var(--ap-brown)}.ap-roi-product-option strong,.ap-roi-product-option small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ap-roi-product-option strong{color:#111;font-size:12px;line-height:1.2}.ap-roi-product-option small{margin-top:5px;color:var(--ap-muted);font-size:9px;line-height:1.2}.ap-roi-product-option>i{display:grid;width:22px;height:22px;place-items:center;border:1px solid var(--ap-line);border-radius:50%;background:#fff;color:transparent;font-size:10px;font-style:normal;transition:.18s ease}.ap-roi-product-option:has(input:checked)>i{border-color:var(--ap-brown);background:var(--ap-brown);color:#fff}
  .ap-roi-results{position:relative;overflow:hidden;border-radius:28px;background:#111;color:#fff;padding:27px}.ap-roi-results:after{content:"";position:absolute;right:-90px;bottom:-110px;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,rgba(159,56,38,.48),transparent 68%)}.ap-roi-results>*{position:relative;z-index:1}.ap-roi-results .ap-kicker{color:#e7a295}
  .ap-roi-compare{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:20px}.ap-roi-compare article{border:1px solid rgba(255,255,255,.12);border-radius:18px;background:rgba(255,255,255,.07);padding:14px}.ap-roi-compare article.is-ai{border-color:rgba(231,162,149,.35);background:rgba(159,56,38,.18)}.ap-roi-compare span,.ap-roi-compare strong{display:block}.ap-roi-compare span{color:rgba(255,255,255,.62);font-size:10px;line-height:1.35}.ap-roi-compare strong{margin-top:9px;font:700 26px/1 "Syne",sans-serif}
  .ap-roi-primary{margin-top:10px;border-radius:21px;background:#fff;padding:18px;color:#111}.ap-roi-primary>span{color:var(--ap-brown);font:700 9px/1 "Syne",sans-serif;letter-spacing:1.2px;text-transform:uppercase}.ap-roi-primary>strong{display:block;margin-top:10px;font:700 38px/1 "Syne",sans-serif}.ap-roi-primary p{margin:12px 0 0;color:var(--ap-muted);font-size:11px;line-height:1.5}
  .ap-roi-results details{margin-top:12px;border:1px solid rgba(255,255,255,.13);border-radius:17px}.ap-roi-results summary{display:flex;justify-content:space-between;gap:10px;padding:14px;cursor:pointer;list-style:none;font-size:11px;font-weight:850}.ap-roi-results summary::-webkit-details-marker{display:none}.ap-roi-results details p{margin:0;padding:0 14px 14px;color:rgba(255,255,255,.62);font-size:10px;line-height:1.55}
  @media(max-width:820px){.ap-roi-shell{grid-template-columns:1fr}.ap-roi-inputs{grid-template-columns:1fr}.ap-roi-results{min-height:480px;display:flex;flex-direction:column;justify-content:center}}@media(max-width:520px){.ap-roi-product-picker>div{grid-template-columns:1fr}}@media(max-width:430px){.ap-roi-shell{border-radius:27px;padding:12px}.ap-roi-results{border-radius:22px;padding:20px}.ap-roi-compare{grid-template-columns:1fr}.ap-roi-primary>strong{font-size:32px}}
</style>

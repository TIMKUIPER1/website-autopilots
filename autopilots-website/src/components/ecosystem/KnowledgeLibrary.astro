---
import BaseLayout from "../../layouts/BaseLayout.astro";
interface Item { title:string; description:string; href:string; category:string; label:string; keywords?:string[] }
interface Props { mode:"ai"|"autopilots"; items:Item[] }
const { mode, items }=Astro.props;
const isAi=mode==="ai";
const page={
  title:isAi?"AI kennis | Tools, modellen en praktische toepassingen":"Autopilots kennis | AI-systemen en implementatie",
  description:isAi?"Doorzoek praktische AI kennis over OpenAI, Claude, agents, voice AI, zoekgedrag en branchetoepassingen.":"Doorzoek Autopilots kennis over AI-breinen, klantreizen, CRM-acties, koppelingen, livegang en optimalisatie.",
  kicker:isAi?"AI kennis":"Autopilots kennis",
  heading:isAi?"Nieuwe AI-inzichten, vertaald naar":"Hoe Autopilots AI omzet naar",
  accent:isAi?"bedrijfswaarde.":"werkende systemen.",
  copy:isAi?"Zoek op OpenAI, Claude, AI zoeken, voice agents, chat agents, automatisering of een branche. Deze route helpt ondernemers bepalen welke AI-ontwikkelingen praktisch relevant worden.":"Zoek op implementatie, klantreis, AI-brein, CRM, voice, chat, livegang of optimalisatie. Deze kennis komt uit hoe we systemen ontwerpen, bouwen en verbeteren.",
  topics:isAi?["OpenAI, Claude en modellen","AI-agents en automatisering","Voice, chat en branchetoepassingen"]:["AI-breinen en klantreizen","CRM-acties en koppelingen","Livegang, support en optimalisatie"],
  search:isAi?"Zoek op OpenAI, Claude, voice, chat of branche":"Zoek op AI-brein, CRM, proces, livegang of support"
};
const schema={"@context":"https://schema.org","@type":"CollectionPage",name:page.kicker,description:page.description,url:new URL(`/kennisbank/${mode}/`,Astro.site??Astro.url.origin).toString()};
---
<BaseLayout title={page.title} description={page.description} canonical={`/kennisbank/${mode}/`} schema={schema}>
  <article class:list={["ap-library-page",`is-${mode}`]} data-library-root>
    <section class="ap-section"><div class="ap-container"><a class="ap-route-back" href="/kennisbank/">← Terug naar routekeuze</a><div class="ap-library-head"><div><div class="ap-kicker">{page.kicker}</div><h1>{page.heading} <span class="ap-accent">{page.accent}</span></h1><p class="ap-lead">{page.copy}</p><div class="ap-focus-strip">{page.topics.map(topic=><span>{topic}</span>)}</div></div><label class="ap-knowledge-search"><span>Zoeken in {page.kicker.toLowerCase()}</span><input type="search" placeholder={page.search} data-library-search autocomplete="off" /><small>Zoek op onderwerp, product, tool of toepassing.</small></label></div></div></section>
    <section class="ap-section ap-library-results-section"><div class="ap-container"><div class="ap-library-count"><div><div class="ap-kicker">Kennisoverzicht</div><h2>{isAi?"Algemene AI-kennis voor praktische keuzes.":"Van klantreis naar een systeem dat live werkt."}</h2></div><span data-result-count>{items.length} resultaten</span></div><div class="ap-library-grid" data-library-grid>{items.map(item=><a class="ap-library-card" href={item.href} data-library-card data-search-text={[item.title,item.description,item.category,item.label,...(item.keywords??[])].join(" ").toLowerCase()}><span>{item.category}</span><h3>{item.title}</h3><p>{item.description}</p><div><em>{item.label}</em><strong>Lees verder →</strong></div></a>)}</div><div class="ap-library-empty" data-library-empty hidden><h3>Geen kennis gevonden.</h3><p>Probeer een bredere term zoals AI, CRM, voice, klantreis of implementatie.</p></div></div></section>
    <section class="ap-section"><div class="ap-container"><div class="ap-final-cta"><div><div class="ap-kicker">Van kennis naar actie</div><h2 class="ap-section-title">Wil je weten welke route bij jouw situatie past?</h2><p class="ap-text">We bekijken je huidige klantcontact en bepalen welk product en welke koppelingen waarde kunnen leveren.</p></div><a class="ap-button ap-button-primary" href="/afspraak/">Plan afspraak</a></div></div></section>
  </article>
</BaseLayout>
<script is:inline>(()=>{const root=document.querySelector('[data-library-root]');if(!root)return;const input=root.querySelector('[data-library-search]');const cards=[...root.querySelectorAll('[data-library-card]')];const count=root.querySelector('[data-result-count]');const empty=root.querySelector('[data-library-empty]');const filter=()=>{const query=(input.value||'').trim().toLowerCase();let visible=0;cards.forEach(card=>{const show=!query||card.dataset.searchText.includes(query);card.hidden=!show;if(show)visible++});count.textContent=`${visible} ${visible===1?'resultaat':'resultaten'}`;empty.hidden=visible!==0};input.addEventListener('input',filter)})();</script>
<style>
  .ap-route-back{display:inline-flex;margin-bottom:34px;color:var(--ap-brown);font-size:13px;font-weight:850}.ap-library-head{display:grid;grid-template-columns:minmax(0,1fr) 350px;gap:34px;align-items:end}.ap-library-head h1{max-width:800px}.ap-focus-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:28px}.ap-focus-strip span{border:1px solid var(--ap-line);border-radius:18px;background:#fff;padding:14px;font-size:12px;font-weight:800}.ap-knowledge-search{display:block;border:1px solid var(--ap-line);border-radius:28px;background:#fff;padding:24px;box-shadow:0 18px 50px rgba(17,17,17,.06)}.ap-knowledge-search>span,.ap-knowledge-search small{display:block}.ap-knowledge-search>span{margin-bottom:13px;font-weight:900}.ap-knowledge-search input{width:100%;min-height:56px;border:1px solid var(--ap-line);border-radius:17px;background:var(--ap-soft-2);padding:0 16px;color:#111;font:inherit;font-size:14px}.ap-knowledge-search input:focus{outline:3px solid rgba(159,56,38,.13);border-color:var(--ap-brown)}.ap-knowledge-search small{margin-top:10px;color:var(--ap-muted);line-height:1.4}.ap-library-results-section{background:var(--ap-soft-2)}.ap-library-count{display:flex;align-items:end;justify-content:space-between;gap:22px;margin-bottom:30px}.ap-library-count h2{max-width:760px;font-size:clamp(28px,4vw,48px)}.ap-library-count>span{border-radius:999px;background:#111;color:#fff;padding:10px 14px;font-size:12px;font-weight:800}.ap-library-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.ap-library-card{display:flex;min-height:330px;flex-direction:column;border:1px solid var(--ap-line);border-radius:28px;background:#fff;padding:24px;box-shadow:0 15px 44px rgba(17,17,17,.045);transition:.2s}.ap-library-card:hover{transform:translateY(-4px);border-color:rgba(159,56,38,.28)}.ap-library-card>span{color:var(--ap-brown);font-family:"Syne",sans-serif;font-size:10px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase}.ap-library-card h3{margin-top:24px;font-size:23px;line-height:1.12}.ap-library-card p{margin-top:13px;color:var(--ap-muted);font-size:14px;line-height:1.58}.ap-library-card>div{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:auto;padding-top:24px}.ap-library-card em{color:var(--ap-muted);font-style:normal;font-size:11px;font-weight:800}.ap-library-card strong{color:var(--ap-brown);font-size:12px}.ap-library-empty{border:1px dashed rgba(159,56,38,.35);border-radius:28px;background:#fff;padding:34px;text-align:center}.ap-library-empty p{margin-top:8px;color:var(--ap-muted)}@media(max-width:900px){.ap-library-head{grid-template-columns:1fr}.ap-knowledge-search{max-width:none}.ap-library-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:620px){.ap-focus-strip,.ap-library-grid{grid-template-columns:1fr}.ap-library-count{align-items:start;flex-direction:column}.ap-library-card{min-height:270px}}
</style>

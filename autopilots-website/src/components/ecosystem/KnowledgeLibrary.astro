---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { SupportedLocale } from "../../i18n/languages";
import { getLocale } from "../../i18n/languages";
import { localizedPath } from "../../i18n/routes";
interface Item { title:string; description:string; href:string; category:string; cluster?:string; label:string; keywords?:string[]; searchText?:string; modified?:string; pillar?:boolean }
interface Props { mode:"ai"|"autopilots"; items:Item[]; locale?:SupportedLocale }
const { mode, items, locale="nl" }=Astro.props;
const isAi=mode==="ai";
const l={
 nl:{ai:["AI kennis | Tools, modellen en praktische toepassingen","Doorzoek praktische AI kennis over agents, voice AI en branchetoepassingen.","AI kennis","Nieuwe AI-inzichten, vertaald naar","bedrijfswaarde.","Vind onafhankelijke uitleg over AI-medewerkers, leadopvolging, CRM, implementatie, privacy en voice AI.",["AI-medewerkers en klantcontact","Leads, inbox en CRM","Implementatie, privacy en voice"],"Zoek op onderwerp, vraag of toepassing"],ap:["Autopilots kennis | AI-systemen en implementatie","Doorzoek Autopilots kennis over AI-breinen, klantreizen, koppelingen, livegang en optimalisatie.","Autopilots kennis","Hoe Autopilots AI omzet naar","werkende systemen.","Zoek op implementatie, klantreis, AI-brein, CRM, voice, chat, livegang of optimalisatie.",["AI-breinen en klantreizen","CRM-acties en koppelingen","Livegang, support en optimalisatie"],"Zoek op AI-brein, CRM, proces, livegang of support"],back:"Terug naar routekeuze",searchIn:"Zoeken in",searchHelp:"Zoek op onderwerp, product, tool of toepassing.",basis:"Begin bij de basis",pillars:"Vijf pijlers voor een werkende AI-route.",starts:"startpunten",start:"Start hier",overview:"Kennisoverzicht",all:"Alle artikelen, geordend rond een concrete bedrijfsvraag.",system:"Van klantreis naar een systeem dat live werkt.",results:"resultaten",result:"resultaat",filter:"Filter op kenniscluster",everything:"Alles",pillar:"Pijler",updated:"bijgewerkt",read:"Lees verder",none:"Geen kennis gevonden.",noneText:"Probeer een bredere term zoals AI, CRM, voice, klantreis of implementatie.",action:"Van kennis naar actie",cta:"Welke route past bij je huidige klantcontact?",ctaText:"We bepalen welk product en welke koppelingen waarde kunnen leveren.",appointment:"Plan een afspraak"},
 en:{ai:["AI knowledge | Tools, models and practical uses","Search practical knowledge about agents, voice AI and industry applications.","AI knowledge","New AI insights translated into","business value.","Find independent guidance on AI colleagues, lead follow-up, CRM, implementation, privacy and voice AI.",["AI colleagues and customer contact","Leads, inbox and CRM","Implementation, privacy and voice"],"Search by topic, question or use case"],ap:["Autopilots knowledge | AI systems and implementation","Search Autopilots knowledge about AI brains, journeys, integrations, launch and optimisation.","Autopilots knowledge","How Autopilots turns AI into","working systems.","Search implementation, customer journey, AI brain, CRM, voice, chat, launch or optimisation.",["AI brains and journeys","CRM actions and integrations","Launch, support and optimisation"],"Search AI brain, CRM, process, launch or support"],back:"Back to route selection",searchIn:"Search in",searchHelp:"Search by topic, product, tool or use case.",basis:"Start with the basics",pillars:"Five pillars for a working AI route.",starts:"starting points",start:"Start here",overview:"Knowledge overview",all:"All articles organised around a concrete business question.",system:"From customer journey to a live system.",results:"results",result:"result",filter:"Filter by knowledge cluster",everything:"All",pillar:"Pillar",updated:"updated",read:"Read more",none:"No knowledge found.",noneText:"Try a broader term such as AI, CRM, voice, customer journey or implementation.",action:"From knowledge to action",cta:"Which route fits your current customer contact?",ctaText:"We identify which product and integrations can create value.",appointment:"Book a call"},
 es:{ai:["Conocimientos de IA | Herramientas, modelos y aplicaciones","Busca conocimiento práctico sobre agentes, voz y aplicaciones por sector.","Conocimientos de IA","Nuevas ideas de IA convertidas en","valor empresarial.","Encuentra orientación sobre colaboradores de IA, leads, CRM, implementación, privacidad y voz.",["Colaboradores de IA y atención","Leads, bandeja y CRM","Implementación, privacidad y voz"],"Busca por tema, pregunta o aplicación"],ap:["Conocimientos Autopilots | Sistemas e implementación","Busca información sobre cerebros de IA, recorridos, integraciones, lanzamiento y optimización.","Conocimientos Autopilots","Cómo Autopilots convierte la IA en","sistemas operativos.","Busca implementación, recorrido, cerebro de IA, CRM, voz, chat, lanzamiento u optimización.",["Cerebros de IA y recorridos","Acciones CRM e integraciones","Lanzamiento, soporte y optimización"],"Busca cerebro de IA, CRM, proceso o soporte"],back:"Volver a elegir ruta",searchIn:"Buscar en",searchHelp:"Busca por tema, producto, herramienta o aplicación.",basis:"Empieza por la base",pillars:"Cinco pilares para una ruta de IA operativa.",starts:"puntos de partida",start:"Empezar aquí",overview:"Resumen de conocimientos",all:"Todos los artículos organizados por una pregunta empresarial.",system:"Del recorrido a un sistema activo.",results:"resultados",result:"resultado",filter:"Filtrar por grupo",everything:"Todo",pillar:"Pilar",updated:"actualizado",read:"Leer más",none:"No se encontraron conocimientos.",noneText:"Prueba un término más amplio como IA, CRM, voz, recorrido o implementación.",action:"Del conocimiento a la acción",cta:"¿Qué ruta encaja con tu atención actual?",ctaText:"Determinamos qué producto e integraciones pueden aportar valor.",appointment:"Reservar una llamada"},
 de:{ai:["KI-Wissen | Tools, Modelle und Anwendungen","Durchsuchen Sie Praxiswissen über Agents, Voice AI und Branchenanwendungen.","KI-Wissen","Neue KI-Erkenntnisse übersetzt in","Unternehmenswert.","Finden Sie Einordnungen zu KI-Kollegen, Leads, CRM, Implementierung, Datenschutz und Voice AI.",["KI-Kollegen und Kundenkontakt","Leads, Postfach und CRM","Implementierung, Datenschutz und Voice"],"Nach Thema, Frage oder Anwendung suchen"],ap:["Autopilots Wissen | KI-Systeme und Implementierung","Durchsuchen Sie Wissen zu KI-Gehirnen, Kundenreisen, Integrationen, Livegang und Optimierung.","Autopilots Wissen","Wie Autopilots KI in","funktionierende Systeme übersetzt.","Suchen Sie nach Implementierung, Kundenreise, KI-Gehirn, CRM, Voice, Chat, Livegang oder Optimierung.",["KI-Gehirne und Kundenreisen","CRM-Aktionen und Integrationen","Livegang, Support und Optimierung"],"Nach KI-Gehirn, CRM, Prozess oder Support suchen"],back:"Zurück zur Routenauswahl",searchIn:"Suchen in",searchHelp:"Nach Thema, Produkt, Tool oder Anwendung suchen.",basis:"Mit den Grundlagen beginnen",pillars:"Fünf Säulen für eine funktionierende KI-Route.",starts:"Startpunkte",start:"Hier starten",overview:"Wissensübersicht",all:"Alle Artikel nach einer konkreten Unternehmensfrage geordnet.",system:"Von der Kundenreise zum Live-System.",results:"Ergebnisse",result:"Ergebnis",filter:"Nach Wissenscluster filtern",everything:"Alle",pillar:"Säule",updated:"aktualisiert",read:"Weiterlesen",none:"Kein Wissen gefunden.",noneText:"Versuchen Sie einen breiteren Begriff wie KI, CRM, Voice oder Implementierung.",action:"Vom Wissen zur Aktion",cta:"Welche Route passt zu Ihrem Kundenkontakt?",ctaText:"Wir bestimmen, welches Produkt und welche Integrationen Wert schaffen.",appointment:"Termin vereinbaren"},
 it:{ai:["Conoscenza AI | Strumenti, modelli e applicazioni","Cerca conoscenza pratica su agenti, voice AI e applicazioni di settore.","Conoscenza AI","Nuove idee sull'AI tradotte in","valore aziendale.","Trova guide su collaboratori AI, lead, CRM, implementazione, privacy e voice AI.",["Collaboratori AI e contatto","Lead, inbox e CRM","Implementazione, privacy e voce"],"Cerca per tema, domanda o applicazione"],ap:["Conoscenza Autopilots | Sistemi e implementazione","Cerca conoscenza su cervelli AI, customer journey, integrazioni, lancio e ottimizzazione.","Conoscenza Autopilots","Come Autopilots trasforma l'AI in","sistemi operativi.","Cerca implementazione, customer journey, cervello AI, CRM, voce, chat, lancio o ottimizzazione.",["Cervelli AI e customer journey","Azioni CRM e integrazioni","Lancio, supporto e ottimizzazione"],"Cerca cervello AI, CRM, processo o supporto"],back:"Torna alla scelta del percorso",searchIn:"Cerca in",searchHelp:"Cerca per tema, prodotto, strumento o applicazione.",basis:"Parti dalle basi",pillars:"Cinque pilastri per un percorso AI operativo.",starts:"punti di partenza",start:"Inizia qui",overview:"Panoramica conoscenze",all:"Tutti gli articoli organizzati attorno a una domanda aziendale.",system:"Dal customer journey a un sistema attivo.",results:"risultati",result:"risultato",filter:"Filtra per gruppo",everything:"Tutto",pillar:"Pilastro",updated:"aggiornato",read:"Leggi di più",none:"Nessun contenuto trovato.",noneText:"Prova un termine più ampio come AI, CRM, voce o implementazione.",action:"Dalla conoscenza all'azione",cta:"Quale percorso si adatta al contatto attuale?",ctaText:"Determiniamo quale prodotto e integrazioni possono creare valore.",appointment:"Prenota una call"},
 fr:{ai:["Connaissances IA | Outils, modèles et applications","Recherchez des connaissances pratiques sur les agents, la voix et les applications métier.","Connaissances IA","De nouvelles connaissances IA traduites en","valeur pour l'entreprise.","Trouvez des guides sur les collaborateurs IA, les leads, le CRM, l'implémentation, la confidentialité et la voix.",["Collaborateurs IA et relation client","Leads, messagerie et CRM","Implémentation, confidentialité et voix"],"Rechercher par sujet, question ou usage"],ap:["Connaissances Autopilots | Systèmes et implémentation","Recherchez des connaissances sur les cerveaux IA, parcours, connexions, lancement et optimisation.","Connaissances Autopilots","Comment Autopilots transforme l'IA en","systèmes opérationnels.","Recherchez implémentation, parcours, cerveau IA, CRM, voix, chat, lancement ou optimisation.",["Cerveaux IA et parcours","Actions CRM et connexions","Lancement, assistance et optimisation"],"Rechercher cerveau IA, CRM, processus ou assistance"],back:"Retour au choix du parcours",searchIn:"Rechercher dans",searchHelp:"Rechercher par sujet, produit, outil ou usage.",basis:"Commencer par les bases",pillars:"Cinq piliers pour un parcours IA opérationnel.",starts:"points de départ",start:"Commencer ici",overview:"Vue d'ensemble",all:"Tous les articles organisés autour d'une question métier concrète.",system:"Du parcours client au système opérationnel.",results:"résultats",result:"résultat",filter:"Filtrer par groupe",everything:"Tout",pillar:"Pilier",updated:"mis à jour",read:"Lire la suite",none:"Aucun contenu trouvé.",noneText:"Essayez un terme plus large comme IA, CRM, voix, parcours ou implémentation.",action:"Des connaissances à l'action",cta:"Quel parcours correspond à votre relation client ?",ctaText:"Nous déterminons quels produit et connexions peuvent créer de la valeur.",appointment:"Planifier un appel"}
}[locale];
const values=isAi?l.ai:l.ap;
const page={title:values[0] as string,description:values[1] as string,kicker:values[2] as string,heading:values[3] as string,accent:values[4] as string,copy:values[5] as string,topics:values[6] as string[],search:values[7] as string};
const clusters=[...new Set(items.map(item=>item.cluster).filter((cluster):cluster is string=>Boolean(cluster)))];
const pillars=items.filter(item=>item.pillar);
const formatDate=(date?:string)=>date?new Intl.DateTimeFormat(getLocale(locale).tag,{day:"numeric",month:"short",year:"numeric"}).format(new Date(`${date}T12:00:00Z`)):"";
const contentId=isAi?"page.knowledge.ai":"page.knowledge.autopilots";
const schema={"@context":"https://schema.org","@type":"CollectionPage",name:page.kicker,description:page.description,url:new URL(localizedPath(contentId,locale),Astro.site??Astro.url.origin).toString()};
---
<BaseLayout title={page.title} description={page.description} canonical={localizedPath(contentId,locale)} locale={locale} contentId={contentId} schema={schema}>
  <article class:list={["ap-library-page",`is-${mode}`]} data-library-root>
    <section class="ap-section"><div class="ap-container"><a class="ap-route-back" href={localizedPath("page.knowledge",locale)}>← {l.back}</a><div class="ap-library-head"><div><div class="ap-kicker">{page.kicker}</div><h1>{page.heading} <span class="ap-accent">{page.accent}</span></h1><p class="ap-lead">{page.copy}</p><p class="ap-focus-strip">{page.topics.join(" · ")}</p></div><label class="ap-knowledge-search"><span>{l.searchIn} {page.kicker.toLowerCase()}</span><input type="search" placeholder={page.search} data-library-search autocomplete="off" /><small>{l.searchHelp}</small></label></div></div></section>
    {isAi&&pillars.length>0&&<section class="ap-section ap-library-pillars"><div class="ap-container"><div class="ap-library-count"><div><div class="ap-kicker">{l.basis}</div><h2>{l.pillars}</h2></div><span>{pillars.length} {l.starts}</span></div><div class="ap-pillar-list">{pillars.map((item,index)=><a href={item.href}><span>{String(index+1).padStart(2,"0")}</span><div><em>{item.cluster}</em><h3>{item.title}</h3></div><strong>{l.start} →</strong></a>)}</div></div></section>}
    <section class="ap-section ap-library-results-section"><div class="ap-container"><div class="ap-library-count"><div><div class="ap-kicker">{l.overview}</div><h2>{isAi?l.all:l.system}</h2></div><span data-result-count>{items.length} {l.results}</span></div>{clusters.length>0&&<div class="ap-library-filters" role="group" aria-label={l.filter}><button class="is-active" type="button" data-library-filter="all" aria-pressed="true">{l.everything}</button>{clusters.map(cluster=><button type="button" data-library-filter={cluster} aria-pressed="false">{cluster}</button>)}</div>}<div class="ap-library-grid" data-library-grid>{items.map(item=><a class="ap-library-card" href={item.href} data-library-card data-cluster={item.cluster??""} data-search-text={[item.title,item.description,item.category,item.cluster,item.label,item.searchText,...(item.keywords??[])].join(" ").toLocaleLowerCase(locale)}><div class="ap-library-card-top"><span>{item.category}</span>{item.pillar&&<em>{l.pillar}</em>}</div><h3>{item.title}</h3><p>{item.description}</p><div><em>{item.modified?`${item.label} · ${l.updated} ${formatDate(item.modified)}`:item.label}</em><strong>{l.read} →</strong></div></a>)}</div><div class="ap-library-empty" data-library-empty hidden><h3>{l.none}</h3><p>{l.noneText}</p></div></div></section>
    <section class="ap-section"><div class="ap-container"><div class="ap-final-cta"><div><div class="ap-kicker">{l.action}</div><h2 class="ap-section-title">{l.cta}</h2><p class="ap-text">{l.ctaText}</p></div><a class="ap-button ap-button-primary" href={localizedPath("page.appointment",locale)}>{l.appointment}</a></div></div></section>
  </article>
</BaseLayout>
<script define:vars={{one:l.result,many:l.results,locale}} is:inline>(()=>{const root=document.querySelector('[data-library-root]');if(!root)return;const input=root.querySelector('[data-library-search]');const cards=[...root.querySelectorAll('[data-library-card]')];const count=root.querySelector('[data-result-count]');const empty=root.querySelector('[data-library-empty]');const buttons=[...root.querySelectorAll('[data-library-filter]')];let active='all';const filter=()=>{const query=(input.value||'').trim().toLocaleLowerCase(locale);let visible=0;cards.forEach(card=>{const matchesQuery=!query||card.dataset.searchText.includes(query);const matchesCluster=active==='all'||card.dataset.cluster===active;const show=matchesQuery&&matchesCluster;card.hidden=!show;if(show)visible++});count.textContent=`${visible} ${visible===1?one:many}`;empty.hidden=visible!==0};buttons.forEach(button=>button.addEventListener('click',()=>{active=button.dataset.libraryFilter;buttons.forEach(item=>{const selected=item===button;item.classList.toggle('is-active',selected);item.setAttribute('aria-pressed',String(selected))});filter()}));input.addEventListener('input',filter)})();</script>
<style>
  .ap-route-back{display:inline-flex;margin-bottom:34px;color:var(--ap-brown);font-size:13px;font-weight:850}.ap-library-head{display:grid;grid-template-columns:minmax(0,1fr) 350px;gap:46px;align-items:end}.ap-library-head h1{max-width:800px}.ap-focus-strip{margin:24px 0 0;color:var(--ap-muted);font-size:12px;font-weight:750;line-height:1.7}.ap-knowledge-search{display:block;border-left:1px solid var(--ap-line);padding:8px 0 8px 28px}.ap-knowledge-search>span,.ap-knowledge-search small{display:block}.ap-knowledge-search>span{margin-bottom:13px;font-weight:900}.ap-knowledge-search input{width:100%;min-height:56px;border:1px solid var(--ap-line);border-radius:17px;background:#fff;padding:0 16px;color:#111;font:inherit;font-size:14px}.ap-knowledge-search input:focus{outline:3px solid rgba(159,56,38,.13);border-color:var(--ap-brown)}.ap-knowledge-search small{margin-top:10px;color:var(--ap-muted);line-height:1.4}.ap-library-pillars{padding-top:28px;background:#111;color:#fff}.ap-library-pillars .ap-library-count>span{background:#fff;color:#111}.ap-pillar-list{border-block:1px solid rgba(255,255,255,.14)}.ap-pillar-list>a{display:grid;grid-template-columns:48px minmax(0,1fr) auto;gap:20px;align-items:center;border-bottom:1px solid rgba(255,255,255,.14);padding:22px 4px;color:#fff;transition:.2s}.ap-pillar-list>a:last-child{border-bottom:0}.ap-pillar-list>a:hover{padding-left:12px}.ap-pillar-list>a>span{color:#e4a092;font-size:12px;font-weight:900}.ap-pillar-list em{display:block;color:#e4a092;font-style:normal;font-size:10px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase}.ap-pillar-list h3{margin-top:5px;font-size:clamp(18px,2vw,25px)}.ap-pillar-list strong{font-size:12px}.ap-library-results-section{background:var(--ap-soft-2)}.ap-library-count{display:flex;align-items:end;justify-content:space-between;gap:22px;margin-bottom:30px}.ap-library-count h2{max-width:800px;font-size:clamp(28px,4vw,48px)}.ap-library-count>span{color:var(--ap-muted);font-size:12px;font-weight:800;white-space:nowrap}.ap-library-filters{display:flex;flex-wrap:wrap;gap:8px;margin:-8px 0 28px}.ap-library-filters button{border:1px solid var(--ap-line);border-radius:999px;background:transparent;padding:10px 14px;color:var(--ap-muted);font:inherit;font-size:12px;font-weight:850;cursor:pointer}.ap-library-filters button:hover,.ap-library-filters button.is-active{border-color:#111;background:#111;color:#fff}.ap-library-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.ap-library-card{display:flex;min-height:330px;flex-direction:column;border:1px solid var(--ap-line);border-radius:25px;background:#fff;padding:23px;transition:.2s}.ap-library-card:hover{transform:translateY(-3px);border-color:rgba(159,56,38,.28);box-shadow:0 16px 38px rgba(17,17,17,.05)}.ap-library-card:focus-visible{outline:3px solid rgba(159,56,38,.18);outline-offset:3px;border-color:rgba(159,56,38,.38)}.ap-library-card-top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0!important}.ap-library-card-top>span{color:var(--ap-brown);font-family:"Syne",sans-serif;font-size:10px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase}.ap-library-card-top>em{color:var(--ap-muted)!important;font-size:10px}.ap-library-card h3{margin-top:22px;font-size:22px;line-height:1.12;text-wrap:balance}.ap-library-card p{flex:1;margin-top:13px;color:var(--ap-muted);font-size:13px;line-height:1.58}.ap-library-card>div:last-child{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:auto;padding-top:22px}.ap-library-card em{color:var(--ap-muted);font-style:normal;font-size:10px;font-weight:750}.ap-library-card strong{color:var(--ap-brown);font-size:12px;white-space:nowrap}.ap-library-empty{border:1px dashed rgba(159,56,38,.35);border-radius:28px;background:#fff;padding:34px;text-align:center}.ap-library-empty p{margin-top:8px;color:var(--ap-muted)}.ap-final-cta{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:42px;align-items:end;border-top:1px solid var(--ap-line);padding:38px 0 0}.ap-final-cta>div{min-width:0}.ap-final-cta .ap-kicker{margin-bottom:20px}.ap-final-cta .ap-section-title{max-width:760px;font-size:clamp(30px,4vw,48px);line-height:1.08;text-wrap:balance}.ap-final-cta .ap-text{max-width:690px;margin-top:18px;font-size:17px;line-height:1.65}.ap-final-cta>.ap-button{margin-bottom:2px;white-space:nowrap}@media(max-width:900px){.ap-library-head{grid-template-columns:1fr}.ap-knowledge-search{max-width:none;border-top:1px solid var(--ap-line);border-left:0;padding:28px 0 0}.ap-library-grid{grid-template-columns:repeat(2,1fr)}.ap-final-cta{grid-template-columns:1fr;gap:28px;align-items:start}.ap-final-cta>.ap-button{justify-self:start}}@media(max-width:620px){.ap-library-grid{grid-template-columns:1fr}.ap-library-count{align-items:start;flex-direction:column}.ap-pillar-list>a{grid-template-columns:34px minmax(0,1fr)}.ap-pillar-list>a>strong{display:none}.ap-library-filters{flex-wrap:nowrap;overflow-x:auto;padding-bottom:8px}.ap-library-filters button{flex:0 0 auto}.ap-library-card{min-height:270px}.ap-final-cta{padding-top:30px}.ap-final-cta .ap-text{margin-top:18px;font-size:16px}.ap-final-cta>.ap-button{width:100%}}
</style>

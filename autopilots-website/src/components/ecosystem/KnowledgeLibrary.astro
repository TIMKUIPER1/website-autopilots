---
import BaseLayout from "../../layouts/BaseLayout.astro";
interface Item { title:string; description:string; href:string; category:string; cluster?:string; label:string; keywords?:string[]; searchText?:string; modified?:string; pillar?:boolean }
interface Props { mode:"ai"|"autopilots"; items:Item[] }
const { mode, items }=Astro.props;
const isAi=mode==="ai";
const page={
  title:isAi?"AI kennis | Tools, modellen en praktische toepassingen":"Autopilots kennis | AI-systemen en implementatie",
  description:isAi?"Doorzoek praktische AI kennis over OpenAI, Claude, agents, voice AI, zoekgedrag en branchetoepassingen.":"Doorzoek Autopilots kennis over AI-breinen, klantreizen, CRM-acties, koppelingen, livegang en optimalisatie.",
  kicker:isAi?"AI kennis":"Autopilots kennis",
  heading:isAi?"Nieuwe AI-inzichten, vertaald naar":"Hoe Autopilots AI omzet naar",
  accent:isAi?"bedrijfswaarde.":"werkende systemen.",
  copy:isAi?"Vind onafhankelijke uitleg over AI-medewerkers, leadopvolging, CRM, implementatie, privacy en voice AI. Ieder artikel vertaalt techniek naar een controleerbare klantreis.":"Zoek op implementatie, klantreis, AI-brein, CRM, voice, chat, livegang of optimalisatie. Deze kennis komt uit hoe we systemen ontwerpen, bouwen en verbeteren.",
  topics:isAi?["AI-medewerkers en klantcontact","Leads, inbox en CRM","Implementatie, privacy en voice"]:["AI-breinen en klantreizen","CRM-acties en koppelingen","Livegang, support en optimalisatie"],
  search:isAi?"Zoek op onderwerp, vraag of toepassing":"Zoek op AI-brein, CRM, proces, livegang of support"
};
const clusters=[...new Set(items.map(item=>item.cluster).filter((cluster):cluster is string=>Boolean(cluster)))];
const pillars=items.filter(item=>item.pillar);
const formatDate=(date?:string)=>date?new Intl.DateTimeFormat("nl-NL",{day:"numeric",month:"short",year:"numeric"}).format(new Date(`${date}T12:00:00Z`)):"";
const schema={"@context":"https://schema.org","@type":"CollectionPage",name:page.kicker,description:page.description,url:new URL(`/kennisbank/${mode}/`,Astro.site??Astro.url.origin).toString()};
---
<BaseLayout title={page.title} description={page.description} canonical={`/kennisbank/${mode}/`} schema={schema}>
  <article class:list={["ap-library-page",`is-${mode}`]} data-library-root>
    <section class="ap-section"><div class="ap-container"><a class="ap-route-back" href="/kennisbank/">← Terug naar routekeuze</a><div class="ap-library-head"><div><div class="ap-kicker">{page.kicker}</div><h1>{page.heading} <span class="ap-accent">{page.accent}</span></h1><p class="ap-lead">{page.copy}</p><div class="ap-focus-strip">{page.topics.map(topic=><span>{topic}</span>)}</div></div><label class="ap-knowledge-search"><span>Zoeken in {page.kicker.toLowerCase()}</span><input type="search" placeholder={page.search} data-library-search autocomplete="off" /><small>Zoek op onderwerp, product, tool of toepassing.</small></label></div></div></section>
    {isAi&&pillars.length>0&&<section class="ap-section ap-library-pillars"><div class="ap-container"><div class="ap-library-count"><div><div class="ap-kicker">Begin bij de basis</div><h2>Vijf pijlers voor een werkende AI-route.</h2></div><span>{pillars.length} startpunten</span></div><div class="ap-pillar-list">{pillars.map((item,index)=><a href={item.href}><span>{String(index+1).padStart(2,"0")}</span><div><em>{item.cluster}</em><h3>{item.title}</h3></div><strong>Start hier →</strong></a>)}</div></div></section>}
    <section class="ap-section ap-library-results-section"><div class="ap-container"><div class="ap-library-count"><div><div class="ap-kicker">Kennisoverzicht</div><h2>{isAi?"Alle artikelen, geordend rond een concrete bedrijfsvraag.":"Van klantreis naar een systeem dat live werkt."}</h2></div><span data-result-count>{items.length} resultaten</span></div>{clusters.length>0&&<div class="ap-library-filters" role="group" aria-label="Filter op kenniscluster"><button class="is-active" type="button" data-library-filter="all" aria-pressed="true">Alles</button>{clusters.map(cluster=><button type="button" data-library-filter={cluster} aria-pressed="false">{cluster}</button>)}</div>}<div class="ap-library-grid" data-library-grid>{items.map(item=><a class="ap-library-card" href={item.href} data-library-card data-cluster={item.cluster??""} data-search-text={[item.title,item.description,item.category,item.cluster,item.label,item.searchText,...(item.keywords??[])].join(" ").toLowerCase()}><div class="ap-library-card-top"><span>{item.category}</span>{item.pillar&&<em>Pijler</em>}</div><h3>{item.title}</h3><p>{item.description}</p><div><em>{item.modified?`${item.label} · bijgewerkt ${formatDate(item.modified)}`:item.label}</em><strong>Lees verder →</strong></div></a>)}</div><div class="ap-library-empty" data-library-empty hidden><h3>Geen kennis gevonden.</h3><p>Probeer een bredere term zoals AI, CRM, voice, klantreis of implementatie.</p></div></div></section>
    <section class="ap-section"><div class="ap-container"><div class="ap-final-cta"><div><div class="ap-kicker">Van kennis naar actie</div><h2 class="ap-section-title">Wil je weten welke route bij jouw situatie past?</h2><p class="ap-text">We bekijken je huidige klantcontact en bepalen welk product en welke koppelingen waarde kunnen leveren.</p></div><a class="ap-button ap-button-primary" href="/afspraak/">Plan afspraak</a></div></div></section>
  </article>
</BaseLayout>
<script is:inline>(()=>{const root=document.querySelector('[data-library-root]');if(!root)return;const input=root.querySelector('[data-library-search]');const cards=[...root.querySelectorAll('[data-library-card]')];const count=root.querySelector('[data-result-count]');const empty=root.querySelector('[data-library-empty]');const buttons=[...root.querySelectorAll('[data-library-filter]')];let active='all';const filter=()=>{const query=(input.value||'').trim().toLowerCase();let visible=0;cards.forEach(card=>{const matchesQuery=!query||card.dataset.searchText.includes(query);const matchesCluster=active==='all'||card.dataset.cluster===active;const show=matchesQuery&&matchesCluster;card.hidden=!show;if(show)visible++});count.textContent=`${visible} ${visible===1?'resultaat':'resultaten'}`;empty.hidden=visible!==0};buttons.forEach(button=>button.addEventListener('click',()=>{active=button.dataset.libraryFilter;buttons.forEach(item=>{const selected=item===button;item.classList.toggle('is-active',selected);item.setAttribute('aria-pressed',String(selected))});filter()}));input.addEventListener('input',filter)})();</script>
<style>
  .ap-route-back{display:inline-flex;margin-bottom:34px;color:var(--ap-brown);font-size:13px;font-weight:850}.ap-library-head{display:grid;grid-template-columns:minmax(0,1fr) 350px;gap:34px;align-items:end}.ap-library-head h1{max-width:800px}.ap-focus-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:28px}.ap-focus-strip span{border:1px solid var(--ap-line);border-radius:18px;background:#fff;padding:14px;font-size:12px;font-weight:800}.ap-knowledge-search{display:block;border:1px solid var(--ap-line);border-radius:28px;background:#fff;padding:24px;box-shadow:0 18px 50px rgba(17,17,17,.06)}.ap-knowledge-search>span,.ap-knowledge-search small{display:block}.ap-knowledge-search>span{margin-bottom:13px;font-weight:900}.ap-knowledge-search input{width:100%;min-height:56px;border:1px solid var(--ap-line);border-radius:17px;background:var(--ap-soft-2);padding:0 16px;color:#111;font:inherit;font-size:14px}.ap-knowledge-search input:focus{outline:3px solid rgba(159,56,38,.13);border-color:var(--ap-brown)}.ap-knowledge-search small{margin-top:10px;color:var(--ap-muted);line-height:1.4}.ap-library-pillars{padding-top:28px;background:#111;color:#fff}.ap-library-pillars .ap-library-count>span{background:#fff;color:#111}.ap-pillar-list{border-block:1px solid rgba(255,255,255,.14)}.ap-pillar-list>a{display:grid;grid-template-columns:48px minmax(0,1fr) auto;gap:20px;align-items:center;border-bottom:1px solid rgba(255,255,255,.14);padding:22px 4px;color:#fff;transition:.2s}.ap-pillar-list>a:last-child{border-bottom:0}.ap-pillar-list>a:hover{padding-left:12px}.ap-pillar-list>a>span{color:#e4a092;font-size:12px;font-weight:900}.ap-pillar-list em{display:block;color:#e4a092;font-style:normal;font-size:10px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase}.ap-pillar-list h3{margin-top:5px;font-size:clamp(18px,2vw,25px)}.ap-pillar-list strong{font-size:12px}.ap-library-results-section{background:var(--ap-soft-2)}.ap-library-count{display:flex;align-items:end;justify-content:space-between;gap:22px;margin-bottom:30px}.ap-library-count h2{max-width:800px;font-size:clamp(28px,4vw,48px)}.ap-library-count>span{border-radius:999px;background:#111;color:#fff;padding:10px 14px;font-size:12px;font-weight:800;white-space:nowrap}.ap-library-filters{display:flex;flex-wrap:wrap;gap:8px;margin:-8px 0 28px}.ap-library-filters button{border:1px solid var(--ap-line);border-radius:999px;background:#fff;padding:11px 15px;color:var(--ap-muted);font:inherit;font-size:12px;font-weight:850;cursor:pointer}.ap-library-filters button:hover,.ap-library-filters button.is-active{border-color:#111;background:#111;color:#fff}.ap-library-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.ap-library-card{display:flex;min-height:360px;flex-direction:column;border:1px solid var(--ap-line);border-radius:28px;background:#fff;padding:24px;box-shadow:0 15px 44px rgba(17,17,17,.045);transition:.2s}.ap-library-card:hover{transform:translateY(-4px);border-color:rgba(159,56,38,.28)}.ap-library-card:focus-visible{outline:3px solid rgba(159,56,38,.18);outline-offset:3px;border-color:rgba(159,56,38,.38)}.ap-library-card-top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0!important}.ap-library-card-top>span{color:var(--ap-brown);font-family:"Syne",sans-serif;font-size:10px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase}.ap-library-card-top>em{border-radius:999px;background:rgba(159,56,38,.08);padding:5px 8px;color:var(--ap-brown)!important}.ap-library-card h3{min-height:78px;margin-top:24px;font-size:23px;line-height:1.12;text-wrap:balance;overflow-wrap:normal;word-break:normal}.ap-library-card p{flex:1;margin-top:13px;color:var(--ap-muted);font-size:14px;line-height:1.58}.ap-library-card>div:last-child{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:auto;padding-top:24px}.ap-library-card em{color:var(--ap-muted);font-style:normal;font-size:11px;font-weight:800}.ap-library-card strong{color:var(--ap-brown);font-size:12px;white-space:nowrap}.ap-library-empty{border:1px dashed rgba(159,56,38,.35);border-radius:28px;background:#fff;padding:34px;text-align:center}.ap-library-empty p{margin-top:8px;color:var(--ap-muted)}.ap-final-cta{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:42px;align-items:end;border:1px solid var(--ap-line);border-radius:34px;background:radial-gradient(circle at 94% 86%,rgba(159,56,38,.07),transparent 24%),#fff;padding:42px;box-shadow:0 16px 50px rgba(17,17,17,.06)}.ap-final-cta>div{min-width:0}.ap-final-cta .ap-kicker{margin-bottom:20px}.ap-final-cta .ap-section-title{max-width:760px;font-size:clamp(30px,4vw,48px);line-height:1.08;text-wrap:balance}.ap-final-cta .ap-text{max-width:690px;margin-top:22px;font-size:17px;line-height:1.65}.ap-final-cta>.ap-button{margin-bottom:2px;white-space:nowrap}@media(max-width:900px){.ap-library-head{grid-template-columns:1fr}.ap-knowledge-search{max-width:none}.ap-library-grid{grid-template-columns:repeat(2,1fr)}.ap-final-cta{grid-template-columns:1fr;gap:28px;align-items:start}.ap-final-cta>.ap-button{justify-self:start}}@media(max-width:620px){.ap-focus-strip,.ap-library-grid{grid-template-columns:1fr}.ap-library-count{align-items:start;flex-direction:column}.ap-pillar-list>a{grid-template-columns:34px minmax(0,1fr)}.ap-pillar-list>a>strong{display:none}.ap-library-filters{flex-wrap:nowrap;overflow-x:auto;padding-bottom:8px}.ap-library-filters button{flex:0 0 auto}.ap-library-card{min-height:285px}.ap-library-card h3{min-height:0}.ap-final-cta{border-radius:26px;padding:26px 22px}.ap-final-cta .ap-text{margin-top:18px;font-size:16px}.ap-final-cta>.ap-button{width:100%}}
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { productBySlug, products } from "../../data/products";
import { nicheBySlug, type Niche } from "../../data/niches";
import { getOrderDestination, getDirectOffer } from "../../data/commerce";
import { getNicheProposalBlueprint } from "../../data/nicheProposals";
import VisualIcon from "../ui/VisualIcon.astro";
import NichePricing from "./NichePricing.astro";
import RoiCalculator from "./RoiCalculator.astro";

interface Props { niche: Niche }
const { niche } = Astro.props;
const recommended = [...niche.primaryProducts, ...niche.optionalProducts].map((slug) => productBySlug[slug]);
const related = niche.related.map((slug) => nicheBySlug[slug]).filter(Boolean);
const proposal = getNicheProposalBlueprint(niche);
const demoConversations: Record<string, { customer: string; ai: string; followup: string }> = {
  tandartsen: {
    customer: "Hebben jullie morgen na 15:00 uur nog plek voor een controle?",
    ai: "Zeker. Bent u al patiënt en gaat het om een reguliere controle of heeft u klachten?",
    followup: "Ik ben al patiënt. Het gaat om een gewone controle."
  }
};
const demoConfirmations: Record<string, string> = {
  autobedrijven: "Geregeld. De proefrit staat zaterdag om 11:00 uur als optie klaar en sales heeft alle inruilgegevens ontvangen.",
  dakdekkers: "Geregeld. De spoedmelding staat bovenaan bij de juiste ploeg; de klant ontvangt direct veiligheidsadvies en een tijdvak.",
  hoveniers: "Geregeld. De schouw is voorbereid met oppervlak, foto's, budgetrichting en een logisch moment in de regio.",
  installatietechniek: "Geregeld. De storing is veilig getrieerd en met foutcode, contractstatus en locatie naar de juiste monteur gestuurd.",
  vastgoedbeheerders: "Geregeld. Het pand en dossier zijn herkend, de reparatie is toegewezen en de huurder krijgt automatisch statusupdates.",
  kapperszaken: "Geregeld. De juiste behandeltijd is gevonden, de afspraak staat in de salonagenda en de klant heeft bevestiging.",
  tandartsen: "Gevonden. Morgen om 15:40 uur is er ruimte; de controle staat in de agenda en de patiënt ontvangt direct bevestiging.",
  makelaars: "Geregeld. De bezichtiging is als optie vastgelegd en de makelaar ontvangt woonwensen, financieringsstatus en contactgegevens.",
  "cosmetische-klinieken": "Geregeld. De consultaanvraag staat bij de juiste behandelaar, inclusief hulpvraag, voorgeschiedenis en veilige overdracht.",
  verzekeraars: "Geregeld. Polis en melding zijn gekoppeld, ontbrekende stukken zijn opgevraagd en het dossier heeft een eigenaar.",
  glaszetters: "Geregeld. De veiligheidsmelding is geprioriteerd en maatvoering, foto's en locatie staan klaar voor planning.",
  hotels: "Geregeld. Beschikbaarheid en voorwaarden zijn gecontroleerd en de gast ontvangt direct een passende reserveringsoptie.",
  restaurants: "Geregeld. De tafel is gecontroleerd, dieetwensen zijn vastgelegd en de gast krijgt meteen bevestiging.",
  evenementen: "Geregeld. Datum, capaciteit en wensen zijn gekwalificeerd en sales ontvangt een complete aanvraag met vervolgmoment.",
  kozijnen: "Geregeld. Woningtype, maten en foto's staan klaar en de inmeetafspraak is als optie ingepland.",
  zonnepanelen: "Geregeld. Verbruik, daktype en adres zijn gecontroleerd en een passend adviesmoment staat klaar.",
  vloerenleggers: "Geregeld. Oppervlakte, ondervloer en vloerverwarming zijn bekend en de inmeetroute is ingepland.",
  woningcorporaties: "Geregeld. De melding is aan woning en dossier gekoppeld, geprioriteerd en naar de juiste servicepartner gestuurd.",
  "non-profit": "Geregeld. De vraag is aan het juiste programma gekoppeld en vrijwilliger of coördinator ontvangt een complete overdracht.",
  dierenarts: "Geregeld. De urgentie is beoordeeld en de praktijk ontvangt dier, klachten, duur en eigenaar vóór het contactmoment.",
  dierenverzorging: "Geregeld. Verzorging, ras, bijzonderheden en behandeltijd zijn bepaald en een passend moment is bevestigd."
};
const demoTimes: Record<string, string> = {
  autobedrijven: "8,4 sec", dakdekkers: "11,2 sec", hoveniers: "9,7 sec", installatietechniek: "8,9 sec",
  vastgoedbeheerders: "7,8 sec", kapperszaken: "6,6 sec", tandartsen: "9,8 sec", makelaars: "8,1 sec",
  "cosmetische-klinieken": "10,4 sec", verzekeraars: "11,6 sec", glaszetters: "8,7 sec", hotels: "6,9 sec",
  restaurants: "6,2 sec", evenementen: "9,5 sec", kozijnen: "9,1 sec", zonnepanelen: "8,8 sec",
  vloerenleggers: "8,5 sec", woningcorporaties: "7,9 sec", "non-profit": "8,6 sec", dierenarts: "7,4 sec", dierenverzorging: "6,8 sec"
};
const demoConversation = demoConversations[niche.slug] ?? niche.conversation;
const demoScenario = {
  messages: [
    { role: "customer", label: "Klant", text: demoConversation.customer },
    { role: "ai", label: "AI-agent", text: demoConversation.ai },
    { role: "customer", label: "Klant", text: demoConversation.followup },
    { role: "ai", label: "AI-agent", text: demoConfirmations[niche.slug] ?? `Geregeld. ${niche.conversation.result}` }
  ],
  route: niche.workflow.slice(0, 4).map((item, index) => ({
    label: item.title,
    detail: index === 3 ? niche.conversation.result : (niche.intake[index] ?? item.text)
  })),
  result: demoConfirmations[niche.slug] ?? niche.conversation.result,
  time: demoTimes[niche.slug] ?? "9,6 sec"
};
const clientData = JSON.stringify({ niche, proposal, demoScenario, validProducts: recommended.map((item) => item.slug) }).replaceAll("<", "\\u003c");
const firstProduct = recommended[0];
const directNicheCheckout = niche.slug === "autobedrijven";
const schema = [
  {
    "@context": "https://schema.org", "@type": "Service", name: `AI-medewerker voor ${niche.name}`,
    serviceType: "AI klantcontact en procesautomatisering", description: niche.metaDescription,
    provider: { "@type": "Organization", name: "Autopilots", url: "https://auto-pilots.io" },
    areaServed: "Nederland", url: new URL(`/voor-wie/${niche.slug}/`, Astro.site ?? Astro.url.origin).toString()
  },
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site ?? Astro.url.origin).toString() },
      { "@type": "ListItem", position: 2, name: "Voor wie", item: new URL("/voor-wie/", Astro.site ?? Astro.url.origin).toString() },
      { "@type": "ListItem", position: 3, name: niche.name, item: new URL(`/voor-wie/${niche.slug}/`, Astro.site ?? Astro.url.origin).toString() }
    ]
  },
  {
    "@context": "https://schema.org", "@type": "FAQPage", mainEntity: niche.faq.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } }))
  }
];
---

<BaseLayout title={niche.seoTitle} description={niche.metaDescription} canonical={`/voor-wie/${niche.slug}/`} schema={schema}>
  <article class="ap-ecosystem ap-niche-page" data-niche-root data-niche={niche.slug}>
    <nav class="ap-breadcrumb" aria-label="Broodkruimel"><div class="ap-container"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/voor-wie/">Voor wie</a><span aria-hidden="true">/</span><span aria-current="page">{niche.name}</span></div></nav>

    <section class="ap-eco-hero ap-niche-hero">
      <div class="ap-container ap-eco-hero-grid">
        <div class="ap-eco-copy">
          <VisualIcon type="niche" name={niche.slug} size="large" label={`${niche.name} icoon`} />
          <div class="ap-kicker ap-icon-kicker">AI-medewerker voor {niche.name}</div>
          <h1>{niche.hero} <span class="ap-title-accent">{niche.accent}</span></h1>
          <p class="ap-lead">{niche.lead}</p>
          <div class="ap-actions"><a class="ap-button ap-button-primary" data-ap-event="appointment_cta_clicked" data-ap-niche={niche.slug} href={`/afspraak/?branche=${niche.slug}`}>Plan een afspraak</a><a class="ap-button ap-button-secondary" data-ap-event={directNicheCheckout ? "direct_order_clicked" : "pricing_viewed"} data-ap-niche={niche.slug} data-ap-product={firstProduct.slug} href={directNicheCheckout ? `/bestel-direct/?product=${firstProduct.slug}` : "#tarieven"}>{directNicheCheckout ? "Bestel direct" : "Bekijk tarieven"}</a></div>
          <a class="ap-text-link" href="#praktijkdemo">Bekijk eerst de klantreis →</a>
          <p class="ap-inline-proof"><span class="ap-proof-dot" aria-hidden="true"></span><span>Ingericht op de processen, systemen en uitzonderingen van een {niche.singular}.</span></p>
        </div>
        <aside class="ap-conversation-card" aria-label={`Voorbeeldgesprek voor ${niche.name}`}>
          <div class="ap-conversation-head"><span>Live intake</span><strong>{niche.name}</strong></div>
          <div class="ap-message is-customer">{niche.conversation.customer}</div>
          <div class="ap-message is-ai">{niche.conversation.ai}</div>
          <div class="ap-conversation-result"><small>Actie in systeem</small><strong>{niche.conversation.result}</strong></div>
        </aside>
      </div>
    </section>

    <section class="ap-section ap-soft-section">
      <div class="ap-container">
        <div class="ap-section-head"><div class="ap-kicker">Een herkenbare werkdag</div><h2>Waar tijd, aandacht en kansen nu <span class="ap-title-accent">weglekken.</span></h2><p>Geen generieke AI-uitleg, maar de momenten waarop de dagelijkse praktijk vastloopt.</p></div>
        <div class="ap-card-grid ap-card-grid-4">{niche.painPoints.map((item, index) => <article class="ap-info-card"><span>{String(index + 1).padStart(2, "0")}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
      </div>
    </section>

    <section class="ap-section ap-proposal-value">
      <div class="ap-container">
        <div class="ap-section-head"><div class="ap-kicker">Waarom dit werkt voor {niche.name}</div><h2>Directe vragen en opvolging krijgen allebei de <span class="ap-title-accent">juiste route.</span></h2><p>De AI herkent wat er speelt, vraagt alleen door waar dat nodig is en zet iedere klant direct op de juiste vervolgstap.</p></div>
        <div class="ap-proposal-feature-grid">
          {proposal.valueCards.map((item, index) => <details class="ap-proposal-feature" open={index === 0}>
            <summary><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{item.title}</h3><p>{item.text}</p></div><b aria-hidden="true">+</b></summary>
            <div class="ap-proposal-feature-more">{item.more}</div>
          </details>)}
        </div>
      </div>
    </section>

    <section class="ap-section" id="praktijkdemo">
      <div class="ap-container">
        <div class="ap-section-head"><div class="ap-kicker">AI-agent in actie</div><h2>Zie hoe de klant binnen seconden <span class="ap-title-accent">echt geholpen wordt.</span></h2><p>Volg het gesprek. Terwijl de AI-agent antwoordt, wordt op de achtergrond direct de juiste route door systemen en team opgebouwd.</p></div>
        <div class="ap-agent-demo" data-agent-demo>
          <header class="ap-agent-demo-head">
            <div class="ap-agent-live"><i aria-hidden="true"></i><span>AI-agent actief</span><strong>{niche.name}</strong></div>
            <div class="ap-agent-time"><span>Van vraag naar actie</span><strong data-agent-time>0,0 sec</strong></div>
          </header>
          <div class="ap-agent-demo-body">
            <article class="ap-agent-chat" role="tabpanel" aria-live="polite">
              <div class="ap-agent-chat-head"><div><span>Live gesprek</span><strong>Nieuwe klantvraag</strong></div><small data-agent-status>Bericht ontvangen</small></div>
              <div class="ap-agent-messages">
                {demoScenario.messages.map((message, index) => <div class:list={["ap-agent-message", `is-${message.role}`, { "is-visible": index === 0 }]} data-agent-message={index}><span>{message.label}</span><p>{message.text}</p></div>)}
              </div>
              <div class="ap-agent-controls">
                <button class="is-previous" type="button" data-niche-previous aria-label="Vorige stap">←</button>
                <button class="is-next" type="button" data-niche-next>Laat de AI verder werken <span>→</span></button>
                <button class="is-reset" type="button" data-niche-reset>Opnieuw</button>
              </div>
            </article>
            <aside class="ap-agent-route" aria-label="Route die de AI-agent opbouwt">
              <div class="ap-agent-route-head"><span>Live route</span><strong>Wordt automatisch opgebouwd</strong></div>
              <ol>
                {demoScenario.route.map((item, index) => <li class:list={[{ "is-active": index === 0 }]} data-agent-route={index}><span>{String(index + 1).padStart(2, "0")}</span><div><strong>{item.label}</strong><small>{item.detail}</small></div><i aria-hidden="true">✓</i></li>)}
              </ol>
              <div class="ap-agent-result" data-agent-result><span>Direct geregeld</span><strong>{demoScenario.result}</strong><small><i aria-hidden="true"></i> CRM, planning en opvolging zijn bijgewerkt</small></div>
            </aside>
          </div>
          <div class="ap-agent-progress"><i data-agent-progress></i></div>
          <div class="ap-agent-steps" role="tablist" aria-label={`AI-demonstratie voor ${niche.name}`}>
            {[
              ["Klantvraag", "Contact komt binnen"], ["AI begrijpt", "Context wordt compleet"], ["Route ontstaat", "Systemen worden gekozen"], ["Direct geregeld", "Klant en team zijn klaar"]
            ].map((step, index) => <button type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1} class:list={[{ "is-active": index === 0 }]} data-niche-step={index}><span>{String(index + 1).padStart(2, "0")}</span><div><strong>{step[0]}</strong><small>{step[1]}</small></div></button>)}
          </div>
        </div>
      </div>
    </section>

    <section class="ap-section ap-soft-section" id="ai-brein">
      <div class="ap-container">
        <div class="ap-section-head"><div class="ap-kicker">AI-brein voor {niche.name}</div><h2>Zo denkt de AI voordat iets naar {proposal.handoff} gaat.</h2><p>Geen losse chatbot. De AI combineert intake, context, regels en systeemacties voordat hij antwoordt, plant of overdraagt.</p></div>
        <div class="ap-branch-brain" data-branch-brain>
          <div class="ap-branch-brain-visual">
            <div class="ap-brain-ticket"><span>AI</span><div><strong>Nieuwe vraag</strong><p>{niche.conversation.customer}</p></div><small>live</small></div>
            <div class="ap-brain-orbit" aria-label={`AI-brein voor ${niche.name}`}>
              <div class="ap-brain-core"><span>AP</span><strong>Autopilots<br />AI-brein</strong></div>
              {proposal.brainSteps.map((step, index) => <button class:list={["ap-brain-node", `is-node-${index + 1}`, { "is-active": index === 0 }]} type="button" data-branch-brain-step={index}><span>{String(index + 1).padStart(2, "0")}</span><strong>{step.label}</strong></button>)}
            </div>
          </div>
          <div class="ap-branch-brain-copy">
            <div class="ap-brain-tabs" role="tablist" aria-label="AI-brein stappen">
              {proposal.brainSteps.map((step, index) => <button class:list={[{ "is-active": index === 0 }]} type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1} data-branch-brain-tab={index}>{index + 1}. {step.label}</button>)}
            </div>
            <article class="ap-brain-panel" role="tabpanel" aria-live="polite">
              <div class="ap-kicker" data-branch-brain-label>{proposal.brainSteps[0].label}</div>
              <h3 data-branch-brain-title>{proposal.brainSteps[0].title}</h3>
              <p data-branch-brain-text>{proposal.brainSteps[0].text}</p>
            </article>
            <div class="ap-brain-output-grid"><div><span>Voor het team</span><strong>Complete context en een duidelijke eigenaar.</strong></div><div><span>Voor de klant</span><strong>Direct antwoord of een concrete vervolgstap.</strong></div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="ap-section ap-dark-section">
      <div class="ap-container">
        <div class="ap-section-head"><div class="ap-kicker">De nieuwe klantreis</div><h2>{proposal.journeyTitle}</h2><p>Iedere stap heeft een doel, een benodigde context en een zichtbare vervolgstap.</p></div>
        <ol class="ap-dark-workflow">{niche.workflow.map((item, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></li>)}</ol>
      </div>
    </section>

    {proposal.routePlanning && <section class="ap-section">
      <div class="ap-container">
        <div class="ap-section-head"><div class="ap-kicker">Route en buitendienst</div><h2>Slimmer plannen voor teams die <span class="ap-title-accent">onderweg zijn.</span></h2><p>De AI neemt niet alleen de aanvraag aan, maar zet locatie, urgentie, type werk en capaciteit klaar voor een bruikbare planning.</p></div>
        <div class="ap-route-planner">
          <div class="ap-route-steps">
            {[
              ["Aanvraag begrijpen", niche.workflow[0]?.text],
              ["Route voorbereiden", `Regio, urgentie en capaciteit worden gecombineerd voor ${proposal.handoff}.`],
              ["Overdracht klaarzetten", niche.conversation.result]
            ].map((item, index) => <button class:list={[{ "is-active": index === 0 }]} type="button" data-route-step={index}><span>{String(index + 1).padStart(2, "0")}</span><div><strong>{item[0]}</strong><small>{item[1]}</small></div></button>)}
          </div>
          <div class="ap-route-map">
            <div class="ap-route-map-head"><span data-route-label>Nieuwe aanvraag</span><strong data-route-title>{niche.conversation.customer}</strong></div>
            <div class="ap-route-line"><span class="is-active">Intake</span><i></i><span>Route</span><i></i><span>Team</span><i></i><span>CRM</span></div>
            <p data-route-text>De belangrijkste gegevens worden compleet gemaakt voordat planning of buitendienst wordt belast.</p>
          </div>
        </div>
      </div>
    </section>}

    <section class="ap-section" id="producten">
      <div class="ap-container">
        <div class="ap-section-head"><div class="ap-kicker">Aanbevolen Autopilots-systeem</div><h2>Begin met wat het meeste operationele <span class="ap-title-accent">verschil maakt.</span></h2><p>Niet ieder bedrijf heeft alle vijf producten nodig. Primair betekent logisch om als eerste te onderzoeken; aanvullend hangt af van je klantreis.</p></div>
        <div class="ap-product-recommendations">
          {recommended.map((product) => {
            const primary = niche.primaryProducts.includes(product.slug);
            const directOffer = getDirectOffer(niche.slug, product.slug);
            const orderDestination = getOrderDestination(niche.slug, product.slug);
            return <article class:list={["ap-recommendation-card", { "is-primary": primary }]} data-product-card={product.slug}>
              <VisualIcon type="product" name={product.slug} /><span>{primary ? "Primair" : "Aanvullend"}</span><h3>{product.name}</h3><p>{product.promise}</p>
              <div class="ap-recommendation-actions"><a href={`/producten/${product.slug}/?branche=${niche.slug}`}>Bekijk product</a><a class="is-order" data-ap-event={directOffer ? "proposal_opened" : "proposal_fallback_clicked"} data-ap-product={product.slug} data-ap-niche={niche.slug} href={orderDestination}>{directOffer ? "Bekijk bestelroute" : "Bespreek dit product"}</a></div>
            </article>;
          })}
        </div>
      </div>
    </section>

    <RoiCalculator niche={niche} />

    <NichePricing niche={niche} />

    <section class="ap-section ap-soft-section" id="implementatie">
      <div class="ap-container">
        <div class="ap-section-head"><div class="ap-kicker">Implementatieproces</div><h2>Van onboarding naar een live AI-medewerker voor <span class="ap-title-accent">{niche.name.toLowerCase()}.</span></h2><p>Scope, kennisbasis, koppelingen en testen worden in duidelijke fases opgeleverd. Zo blijft zichtbaar wat gereed is en wat nog input nodig heeft.</p></div>
        <div class="ap-implementation-shell">
          <div class="ap-implementation-roadmap">
            {[
              { title: "Ontwerp en inrichting", text: "We vertalen de bestaande werkwijze naar gesprekslogica, tone of voice, uitzonderingen en succescriteria.", items: ["Klantreis en kanalen", "Intake en overdracht", "Tone of voice en grenzen"] },
              { title: "Bouw en testen", text: "We richten kennis, acties en koppelingen in en testen de belangrijkste branchescenario’s.", items: [niche.systems.slice(0, 2).join(" en "), niche.painPoints.slice(0, 2).map((item) => item.title).join(" en "), "Fallback en systeemoutput"] },
              { title: "Review en livegang", text: "Het team controleert antwoorden, kwalificatie, planning en overdracht voordat de route live gaat.", items: ["Review met het team", "Feedback verwerken", "Gecontroleerde livegang"] },
              { title: "Monitoring en optimalisatie", text: "Na livegang verbeteren we op basis van echte gesprekken, uitzonderingen en conversiemomenten.", items: ["Gesprekskwaliteit", "Proces- en routeringsfouten", "Nieuwe scenario’s en groei"] }
            ].map((phase, index) => <details class="ap-implementation-phase" open={index === 0}>
              <summary><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{phase.title}</h3><p>{phase.text}</p></div><b aria-hidden="true">+</b></summary>
              <div class="ap-phase-items">{phase.items.map((item) => <span>{item}</span>)}</div>
            </details>)}
          </div>
          <aside class="ap-implementation-summary"><div class="ap-kicker">Duidelijke fases</div><h3>Geen losse chaos.</h3><p>De doorlooptijd hangt af van product, scope, beschikbare systemen, aangeleverde input en feedbackmomenten.</p><div class="ap-proof-metrics"><div><span>01</span><strong>Reactie en bereikbaarheid</strong></div><div><span>02</span><strong>Complete intake</strong></div><div><span>03</span><strong>Correcte overdracht</strong></div><div><span>04</span><strong>Opvolging en resultaat</strong></div></div><a class="ap-button ap-button-primary" href={`/afspraak/?branche=${niche.slug}`}>Bespreek de implementatie</a></aside>
        </div>
      </div>
    </section>

    <section class="ap-section ap-dark-section">
      <div class="ap-container">
        <div class="ap-section-head"><div class="ap-kicker">Transparante kaders</div><h2>De AI handelt binnen afspraken. De mens houdt het oordeel.</h2></div>
        <div class="ap-card-grid ap-card-grid-3">
          <article class="ap-dark-card"><h3>Zelfstandig binnen de flow</h3><p>Vragen stellen, goedgekeurde informatie geven, samenvatten en een toegestane vervolgactie voorbereiden.</p></article>
          <article class="ap-dark-card"><h3>Mens bij uitzondering</h3><p>Risico, emotie, medisch of financieel oordeel en situaties buiten de bekende regels worden overgedragen.</p></article>
          <article class="ap-dark-card"><h3>Inrichting tijdens onboarding</h3><p>Intake, tone of voice, systemen, rechten, uitzonderingen, fallback en testscenario’s worden samen bepaald.</p></article>
        </div>
      </div>
    </section>

    <section class="ap-section ap-soft-section">
      <div class="ap-container ap-faq-layout">
        <div class="ap-section-head"><div class="ap-kicker">Veelgestelde vragen</div><h2>Praktische vragen van {niche.name.toLowerCase()}.</h2></div>
        <div class="ap-faq-list">
          {niche.faq.map((item, index) => <details open={index === 0}><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}
          <details><summary>Wat wordt tijdens onboarding ingericht?<span aria-hidden="true">+</span></summary><p>We bepalen vragen, tone of voice, urgentie, routes, systemen, rechten, menselijke fallback en de scenario’s die vóór livegang worden getest.</p></details>
          <details><summary>Kan ieder bestaand systeem worden gekoppeld?<span aria-hidden="true">+</span></summary><p>Nee, niet automatisch. We toetsen API’s, rechten, datakwaliteit en de gewenste acties. Soms is aanvullende ontwikkeling of een andere route nodig.</p></details>
        </div>
      </div>
    </section>

    {related.length > 0 && <section class="ap-section"><div class="ap-container"><div class="ap-section-head"><div class="ap-kicker">Vergelijkbare klantreizen</div><h2>Bekijk ook deze branches.</h2></div><div class="ap-related-grid">{related.map((item) => <a href={`/voor-wie/${item.slug}/`}><span>AI voor</span><h3>{item.name}</h3><p>{item.lead}</p><strong>Bekijk AI voor {item.name.toLowerCase()}</strong></a>)}</div></div></section>}

    <section class="ap-section ap-final-section"><div class="ap-container ap-final-card"><div><div class="ap-kicker">Volgende stap voor {niche.name}</div><h2>Kies advies of start met het eerste passende product.</h2><p>Bij advies brengen we contactmomenten, systemen en uitzonderingen in kaart. Via bestellen zie je alleen prijzen die al officieel voor deze configuratie beschikbaar zijn.</p></div><div class="ap-actions"><a class="ap-button ap-button-primary" data-ap-event="appointment_cta_clicked" data-ap-niche={niche.slug} href={`/afspraak/?branche=${niche.slug}`}>Plan een korte analyse</a><a class="ap-button ap-button-secondary" data-ap-event="direct_order_clicked" data-ap-niche={niche.slug} data-ap-product={firstProduct.slug} href={`/bestel-direct/?product=${firstProduct.slug}`}>Bestel direct</a></div></div></section>
  </article>

  <script id="ap-niche-data" type="application/json" set:html={clientData}></script>
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-niche-root]");
    const node = document.getElementById("ap-niche-data");
    if (!root || !node) return;
    const payload = JSON.parse(node.textContent || "{}");
    const niche = payload.niche;
    const proposal = payload.proposal;
    const demoScenario = payload.demoScenario;
    const demoStatuses = ["Bericht ontvangen", "AI vraagt gericht door", "Route wordt opgebouwd", "Actie voltooid"];
    const demoStageTimes = ["0,0 sec", "2,4 sec", "6,8 sec", demoScenario.time];
    const setText = (selector, value) => { const item = root.querySelector(selector); if (item) item.textContent = value; };
    const showNicheStep = (requestedIndex, focus = false) => {
      const buttons = [...root.querySelectorAll("[data-niche-step]")];
      const index = Math.max(0, Math.min(requestedIndex, demoScenario.messages.length - 1));
      const button = buttons[index];
      root.querySelectorAll("[data-niche-step]").forEach((item) => { const active = item === button; item.classList.toggle("is-active", active); item.setAttribute("aria-selected", String(active)); item.tabIndex = active ? 0 : -1; });
      root.querySelectorAll("[data-agent-message]").forEach((item) => item.classList.toggle("is-visible", Number(item.dataset.agentMessage) <= index));
      root.querySelectorAll("[data-agent-route]").forEach((item) => item.classList.toggle("is-active", Number(item.dataset.agentRoute) <= index));
      root.querySelector("[data-agent-result]")?.classList.toggle("is-visible", index === demoScenario.messages.length - 1);
      const progress = root.querySelector("[data-agent-progress]");
      if (progress) progress.style.width = `${((index + 1) / demoScenario.messages.length) * 100}%`;
      setText("[data-agent-status]", demoStatuses[index]);
      setText("[data-agent-time]", demoStageTimes[index]);
      const nextButton = root.querySelector("[data-niche-next]");
      if (nextButton) nextButton.innerHTML = index === demoScenario.messages.length - 1 ? "Bekijk opnieuw <span>↻</span>" : "Laat de AI verder werken <span>→</span>";
      root.querySelector("[data-agent-demo]")?.setAttribute("data-demo-step", String(index));
      if (focus) button?.focus({ preventScroll: true });
    };
    root.querySelectorAll("[data-niche-step]").forEach((button) => {
      button.addEventListener("click", () => showNicheStep(Number(button.dataset.nicheStep || 0)));
      button.addEventListener("keydown", (event) => {
        if (!["ArrowRight", "ArrowDown", "ArrowLeft", "ArrowUp", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        const current = Number(button.dataset.nicheStep || 0); const last = demoScenario.messages.length - 1;
        const next = event.key === "Home" ? 0 : event.key === "End" ? last : ["ArrowRight", "ArrowDown"].includes(event.key) ? (current + 1) % (last + 1) : (current - 1 + last + 1) % (last + 1);
        showNicheStep(next, true);
      });
    });
    root.querySelector("[data-niche-next]")?.addEventListener("click", () => {
      const current = Number(root.querySelector("[data-niche-step][aria-selected='true']")?.dataset.nicheStep || 0);
      showNicheStep(current >= demoScenario.messages.length - 1 ? 0 : current + 1);
    });
    root.querySelector("[data-niche-previous]")?.addEventListener("click", () => {
      const current = Number(root.querySelector("[data-niche-step][aria-selected='true']")?.dataset.nicheStep || 0);
      showNicheStep(Math.max(0, current - 1), true);
    });
    root.querySelector("[data-niche-reset]")?.addEventListener("click", () => showNicheStep(0, true));
    showNicheStep(0);
    const showBrainStep = (requestedIndex, focus = false) => {
      const index = Math.max(0, Math.min(requestedIndex, proposal.brainSteps.length - 1));
      const step = proposal.brainSteps[index];
      root.querySelectorAll("[data-branch-brain-tab]").forEach((item) => {
        const active = Number(item.dataset.branchBrainTab) === index;
        item.classList.toggle("is-active", active); item.setAttribute("aria-selected", String(active)); item.tabIndex = active ? 0 : -1;
      });
      root.querySelectorAll("[data-branch-brain-step]").forEach((item) => item.classList.toggle("is-active", Number(item.dataset.branchBrainStep) === index));
      setText("[data-branch-brain-label]", step.label); setText("[data-branch-brain-title]", step.title); setText("[data-branch-brain-text]", step.text);
      if (focus) root.querySelector(`[data-branch-brain-tab="${index}"]`)?.focus({ preventScroll: true });
    };
    root.querySelectorAll("[data-branch-brain-tab],[data-branch-brain-step]").forEach((button) => {
      const attr = button.hasAttribute("data-branch-brain-tab") ? "branchBrainTab" : "branchBrainStep";
      button.addEventListener("click", () => showBrainStep(Number(button.dataset[attr] || 0)));
      button.addEventListener("keydown", (event) => {
        if (!["ArrowRight", "ArrowDown", "ArrowLeft", "ArrowUp", "Home", "End"].includes(event.key)) return;
        event.preventDefault(); const current = Number(button.dataset[attr] || 0); const last = proposal.brainSteps.length - 1;
        const next = event.key === "Home" ? 0 : event.key === "End" ? last : ["ArrowRight", "ArrowDown"].includes(event.key) ? (current + 1) % (last + 1) : (current - 1 + last + 1) % (last + 1);
        showBrainStep(next, true);
      });
    });
    const routeData = [
      { label: "Nieuwe aanvraag", title: niche.conversation.customer, text: "De belangrijkste gegevens worden compleet gemaakt voordat planning of buitendienst wordt belast." },
      { label: "Route voorbereid", title: "Regio, urgentie, type werk en capaciteit bij elkaar.", text: "De aanvraag krijgt een logische plaats in de planning, zonder dat het team losse berichten hoeft samen te voegen." },
      { label: "Overdracht gereed", title: niche.conversation.result, text: "Context, eigenaar en vervolgstap worden samen vastgelegd en blijven zichtbaar voor het team." }
    ];
    root.querySelectorAll("[data-route-step]").forEach((button) => button.addEventListener("click", () => {
      const index = Number(button.dataset.routeStep || 0); const item = routeData[index];
      root.querySelectorAll("[data-route-step]").forEach((node) => node.classList.toggle("is-active", node === button));
      root.querySelectorAll(".ap-route-line span").forEach((node, nodeIndex) => node.classList.toggle("is-active", nodeIndex <= index));
      setText("[data-route-label]", item.label); setText("[data-route-title]", item.title); setText("[data-route-text]", item.text);
    }));
    const requestedProduct = new URLSearchParams(location.search).get("product");
    if (payload.validProducts.includes(requestedProduct)) {
      const selectedCard = root.querySelector(`[data-product-card="${CSS.escape(requestedProduct)}"]`);
      if (selectedCard) {
        selectedCard.classList.add("is-selected");
        selectedCard.setAttribute("aria-label", "Gekozen product");
        if (location.hash === "#producten") requestAnimationFrame(() => document.getElementById("producten")?.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" }));
      }
    }
  })();
</script>


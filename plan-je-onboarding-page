<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Plan je onboarding | Autopilots</title>
    <meta
      name="description"
      content="Bedankt voor je aankoop bij Autopilots. Plan direct je onboarding met onze project manager."
    >
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Syne:wght@700&display=swap");

      :root {
        color-scheme: light;
        --ink: #111111;
        --muted: #62625d;
        --soft: #f7f7f2;
        --paper: #ffffff;
        --line: #e4e1da;
        --accent: #a64232;
        --accent-dark: #111111;
        --highlight: #f1efe8;
        --shadow: 0 14px 34px rgba(17, 17, 17, 0.08);
      }

      * {
        box-sizing: border-box;
      }

      [hidden] {
        display: none !important;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-width: 320px;
        font-family: "Inter", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: var(--ink);
        background: var(--soft);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      a {
        color: inherit;
      }

      .page {
        width: 100vw;
        min-height: 100vh;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        overflow: hidden;
        background: var(--soft);
      }

      .nav {
        position: sticky;
        top: 18px;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        width: min(1180px, calc(100% - 48px));
        margin: 18px auto 0;
        padding: 20px 38px;
        border: 1px solid rgba(17, 17, 17, 0.06);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.94);
        box-shadow: 0 14px 30px rgba(17, 17, 17, 0.12);
        backdrop-filter: blur(18px);
        animation: navEnter 520ms ease both;
      }

      .wordmark {
        display: flex;
        align-items: center;
        min-width: 0;
        color: var(--ink);
        font-family: "Syne", sans-serif;
        font-size: 0.92rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        line-height: 1.25;
        text-transform: uppercase;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: clamp(18px, 3vw, 34px);
        color: var(--ink);
        font-size: 0.98rem;
        font-weight: 600;
        line-height: 1.26;
      }

      .nav-links a {
        text-decoration: none;
        transition: color 160ms ease;
      }

      .nav-links a:hover {
        color: var(--accent);
      }

      .hero {
        width: min(1180px, calc(100% - 36px));
        margin: 0 auto;
        padding: clamp(42px, 6vw, 68px) 0 clamp(22px, 4vw, 36px);
        text-align: center;
      }

      .eyebrow,
      .brand {
        display: block;
        margin: 0 0 16px;
        color: var(--accent);
        font-family: "Syne", sans-serif;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        line-height: 1.25;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      h1,
      h2,
      h3 {
        font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
        font-weight: 700;
        letter-spacing: 0;
      }

      h1 {
        max-width: 980px;
        margin: 0 auto 18px;
        font-size: clamp(2.35rem, 4.25vw, 4.45rem);
        line-height: 1.09;
      }

      h1 .headline-line {
        display: block;
      }

      h1 .keep-together {
        white-space: nowrap;
      }

      .hero-copy {
        max-width: 780px;
        margin: 0 auto 20px;
        color: var(--muted);
        font-size: clamp(1rem, 1.2vw, 1.12rem);
        font-weight: 400;
        line-height: 1.72;
      }

      .hero-copy strong {
        color: var(--ink);
        font-weight: 700;
      }

      .products {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
        margin: 0 auto;
        padding: 0;
        list-style: none;
      }

      .products li {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 38px;
        padding: 0 15px;
        border: 1px solid var(--line);
        border-radius: 999px;
        color: var(--ink);
        background: #fff;
        font-size: 0.84rem;
        font-weight: 600;
      }

      .booking-band {
        padding: clamp(22px, 4vw, 42px) clamp(18px, 4vw, 56px) clamp(72px, 8vw, 102px);
      }

      .booking-shell {
        display: grid;
        grid-template-columns: minmax(260px, 0.82fr) minmax(420px, 1.18fr);
        gap: 0;
        width: min(1180px, 100%);
        margin: 0 auto;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 30px;
        background: var(--paper);
        box-shadow: var(--shadow);
        transition: transform 180ms ease, box-shadow 180ms ease;
      }

      .booking-shell:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 44px rgba(17, 17, 17, 0.1);
      }

      .booking-info {
        padding: clamp(26px, 4vw, 42px);
        border-right: 1px solid var(--line);
        background: #fff;
      }

      .booking-info h2 {
        margin-bottom: 14px;
        font-size: clamp(1.45rem, 2.3vw, 2.2rem);
        line-height: 1.12;
      }

      .payment-note {
        margin-bottom: 18px;
        color: var(--accent);
        font-size: 0.9rem;
        font-weight: 700;
      }

      .booking-info p {
        color: var(--muted);
        font-weight: 400;
        line-height: 1.7;
      }

      .meta-list {
        display: grid;
        gap: 13px;
        margin: 26px 0 0;
        padding: 0;
        list-style: none;
      }

      .meta-list li {
        display: grid;
        grid-template-columns: 32px 1fr;
        gap: 11px;
        align-items: start;
        color: #2d2522;
        font-weight: 600;
      }

      .meta-icon {
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        border-radius: 999px;
        color: #fff;
        background: var(--accent);
      }

      .meta-icon svg {
        width: 17px;
        height: 17px;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        fill: none;
      }

      .prepare {
        margin-top: 30px;
        padding-top: 24px;
        border-top: 1px solid var(--line);
      }

      .prepare h3 {
        margin-bottom: 13px;
        font-size: 1rem;
      }

      .prepare ul {
        display: grid;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .prepare li {
        position: relative;
        padding-left: 24px;
        color: var(--muted);
        font-size: 0.96rem;
        font-weight: 400;
        line-height: 1.65;
      }

      .prepare li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.72em;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent);
      }

      .calendar-panel {
        min-height: 720px;
        padding: clamp(18px, 3vw, 28px);
        background: #fff;
      }

      .calendar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
      }

      .calendar-header h2 {
        margin: 0;
        font-family: "Inter", sans-serif;
        font-size: clamp(1.15rem, 1.6vw, 1.45rem);
        font-weight: 700;
        text-transform: none;
      }

      .calendar-intro {
        margin: -8px 0 18px;
        color: var(--muted);
        font-size: 0.98rem;
        font-weight: 400;
        line-height: 1.65;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 31px;
        padding: 0 12px;
        border: 1px solid rgba(166, 66, 50, 0.18);
        border-radius: 999px;
        color: var(--accent);
        background: var(--highlight);
        font-size: 0.76rem;
        font-weight: 700;
      }

      .calendar-frame {
        display: block;
        width: 100%;
        min-height: 640px;
        border: 1px solid var(--line);
        border-radius: 24px;
        background: #fafafa;
      }

      .calendar-fallback {
        display: grid;
        place-items: center;
        min-height: 640px;
        border: 1px dashed rgba(166, 66, 50, 0.34);
        border-radius: 24px;
        color: var(--muted);
        background: var(--highlight);
        text-align: center;
      }

      .calendar-fallback div {
        width: min(420px, calc(100% - 32px));
      }

      .calendar-fallback strong {
        display: block;
        margin-bottom: 8px;
        color: var(--ink);
        font-family: "Inter", sans-serif;
        font-size: 1.2rem;
        font-weight: 700;
      }

      .next-section {
        padding: clamp(68px, 8vw, 96px) clamp(18px, 4vw, 56px);
        border-top: 1px solid var(--line);
        background: #fff;
      }

      .next-inner {
        width: min(1180px, 100%);
        margin: 0 auto;
      }

      .next-head {
        max-width: 720px;
        margin-bottom: 28px;
      }

      .next-head h2 {
        margin-bottom: 12px;
        font-size: clamp(1.85rem, 3vw, 3rem);
        line-height: 1.12;
      }

      .next-head p {
        color: var(--muted);
        font-size: 1.05rem;
        font-weight: 400;
        line-height: 1.7;
      }

      .steps-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
      }

      .step-card {
        min-height: 210px;
        padding: 26px;
        border: 1px solid var(--line);
        border-radius: 30px;
        background: var(--soft);
        transition: transform 180ms ease, box-shadow 180ms ease;
      }

      .step-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow);
      }

      .step-number {
        display: grid;
        place-items: center;
        width: 38px;
        height: 38px;
        margin-bottom: 18px;
        border-radius: 50%;
        color: #fff;
        background: var(--accent);
        font-weight: 700;
      }

      .step-card h3 {
        margin-bottom: 10px;
        font-size: 1.04rem;
        line-height: 1.2;
      }

      .step-card p {
        margin-bottom: 0;
        color: var(--muted);
        font-weight: 400;
        line-height: 1.7;
      }

      footer {
        padding: 26px clamp(18px, 4vw, 56px);
        color: rgba(255, 255, 255, 0.82);
        background: #111;
        font-size: 0.9rem;
        font-weight: 600;
      }

      .footer-inner {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
        width: min(1180px, 100%);
        margin: 0 auto;
      }

      .reveal {
        opacity: 0;
        transform: translateY(22px);
        transition: opacity 620ms ease, transform 620ms ease;
      }

      .reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      @keyframes navEnter {
        from {
          opacity: 0;
          transform: translateY(-10px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }

        .reveal {
          opacity: 1;
          transform: none;
        }
      }

      @media (max-width: 880px) {
        .nav-links {
          display: none;
        }

        .booking-shell,
        .steps-grid {
          grid-template-columns: 1fr;
        }

        .booking-info {
          border-right: 0;
          border-bottom: 1px solid var(--line);
        }

        .calendar-panel {
          min-height: auto;
          order: -1;
        }
      }

      @media (max-width: 620px) {
        .nav,
        .hero,
        .booking-shell {
          width: min(100% - 24px, 1180px);
        }

        .nav {
          top: 8px;
          margin-top: 8px;
          padding: 15px 20px;
        }

        .hero {
          padding-top: 34px;
        }

        h1 {
          font-size: clamp(2.15rem, 10vw, 3.2rem);
          line-height: 1.1;
        }

        h1 .keep-together {
          white-space: normal;
        }

        .calendar-header {
          align-items: flex-start;
          flex-direction: column;
        }

        .calendar-frame,
        .calendar-fallback {
          min-height: 560px;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header class="nav" aria-label="Hoofdnavigatie">
        <div class="wordmark">AUTOPILOTS</div>
        <nav class="nav-links" aria-label="Pagina onderdelen">
          <a href="#onboarding">Onboarding</a>
          <a href="#planning">Planning</a>
          <a href="#vervolg">Vervolg</a>
        </nav>
      </header>

      <section class="hero">
        <p class="brand">Stap 3 van 3 · Onboarding plannen</p>
        <h1>
          <span class="headline-line">Je aankoop is bevestigd.</span>
          <span class="headline-line keep-together">Plan je onboarding.</span>
        </h1>
        <p class="hero-copy">
          Kies hieronder direct je startmoment. Dan kan je project manager je AI medewerker en Autopilots
          omgeving alvast goed voorbereiden.
        </p>
        <ul class="products" aria-label="Geschikt voor">
          <li>Sales AI</li>
          <li>Klantenservice AI</li>
          <li>Receptionist AI</li>
          <li>Autopilots CRM</li>
          <li>Leadsmachine</li>
        </ul>
      </section>

      <main>
        <section id="onboarding" class="booking-band" aria-label="Onboarding plannen">
          <div class="booking-shell">
            <aside class="booking-info">
              <h2>Start onboarding Autopilots</h2>
              <p class="payment-note">Je betaling is ontvangen. Deze onboarding hoort bij je aankoop.</p>
              <p>
                Tijdens deze sessie stemmen we doelen, kanalen, toegang, tone of voice en de eerste livegang af met je project manager.
              </p>

              <ul class="meta-list">
                <li>
                  <span class="meta-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                  </span>
                  <span>90 minuten onboarding</span>
                </li>
                <li>
                  <span class="meta-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"></rect><path d="M8 2v4M16 2v4M3 10h18"></path></svg>
                  </span>
                  <span>Kies direct een passend moment</span>
                </li>
                <li>
                  <span class="meta-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path></svg>
                  </span>
                  <span>Voor elke Autopilots oplossing</span>
                </li>
              </ul>

              <div class="prepare">
                <h3>Na het plannen handig om klaar te zetten</h3>
                <ul>
                  <li>Logins of beheerrechten voor je belangrijkste kanalen</li>
                  <li>Voorbeelden van goede klantgesprekken of scripts</li>
                  <li>De gewenste contactpersoon voor projectupdates</li>
                </ul>
              </div>
            </aside>

            <div id="planning" class="calendar-panel">
              <div class="calendar-header">
                <h2>Kies hieronder je startmoment</h2>
                <span class="status-pill">Bevestiging per e-mail</span>
              </div>
              <p class="calendar-intro">
                Plan je call nu, dan reserveren we tijd bij de juiste project manager en kunnen we sneller starten.
              </p>

              <iframe
                class="calendar-frame"
                data-calendar-url="https://api.leadconnectorhq.com/widget/booking/bRcwNp24aah0Sjopw9A0"
                scrolling="no"
                id="bRcwNp24aah0Sjopw9A0_1781703391561"
                title="Autopilots onboarding kalender"
              ></iframe>

              <div class="calendar-fallback" hidden>
                <div>
                  <strong>Kalenderlink toevoegen</strong>
                  <p>Vervang <code>CALENDAR_URL</code> in deze pagina door de embedlink van je GHL onboarding kalender.</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section id="vervolg" class="next-section" aria-label="Wat gebeurt er na het plannen">
          <div class="next-inner">
            <div class="next-head">
              <span class="eyebrow">Na het plannen</span>
              <h2>Zo maken we je omgeving startklaar.</h2>
              <p>
                De onboarding is bedoeld om snel duidelijkheid te krijgen, zodat je AI medewerker niet alleen gebouwd wordt,
                maar ook goed aansluit op je bedrijf, team en klantreis.
              </p>
            </div>

            <div class="steps-grid">
              <article class="step-card">
                <span class="step-number">1</span>
                <h3>Doel en scope vastzetten</h3>
                <p>We bepalen welke rol de AI krijgt: sales, service, receptie, leadopvolging, CRM of een combinatie.</p>
              </article>
              <article class="step-card">
                <span class="step-number">2</span>
                <h3>Kanalen en data verzamelen</h3>
                <p>We verzamelen de juiste input voor telefoon, WhatsApp, e-mail, formulieren, scripts en workflows.</p>
              </article>
              <article class="step-card">
                <span class="step-number">3</span>
                <h3>Implementatie starten</h3>
                <p>Je project manager zet de eerste acties uit en houdt je op de hoogte tot de livegang.</p>
              </article>
            </div>
          </div>
        </section>
      </main>

      <footer>
        <div class="footer-inner">
          <span>Autopilots · Onboarding</span>
          <span>Sales AI · Klantenservice AI · Receptionist AI · CRM · Leadsmachine</span>
        </div>
      </footer>
    </div>
    <script src="https://link.msgsndr.com/js/form_embed.js" type="text/javascript"></script>
    <script>
      const calendarFrame = document.querySelector(".calendar-frame");
      const calendarFallback = document.querySelector(".calendar-fallback");
      const calendarUrl = calendarFrame?.dataset.calendarUrl;

      if (calendarFrame && calendarFallback) {
        if (calendarUrl && calendarUrl !== "CALENDAR_URL") {
          calendarFrame.src = calendarUrl;
        } else {
          calendarFrame.hidden = true;
          calendarFallback.hidden = false;
        }
      }

      const revealTargets = document.querySelectorAll(
        ".hero, .booking-shell, .booking-info, .calendar-panel, .next-head, .step-card"
      );

      revealTargets.forEach((element, index) => {
        element.classList.add("reveal");
        element.style.transitionDelay = `${Math.min(index, 5) * 45}ms`;
      });

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );

        revealTargets.forEach((element) => observer.observe(element));
      } else {
        revealTargets.forEach((element) => element.classList.add("is-visible"));
      }

      const sendEmbedHeight = () => {
        window.parent.postMessage(
          {
            type: "autopilots-onboarding-height",
            height: document.documentElement.scrollHeight
          },
          "*"
        );
      };

      window.addEventListener("load", sendEmbedHeight);
      window.addEventListener("resize", sendEmbedHeight);
      setTimeout(sendEmbedHeight, 500);
      setTimeout(sendEmbedHeight, 1400);
    </script>
  </body>
</html>
